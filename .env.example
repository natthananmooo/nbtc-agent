# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูกกันไว้ใน .gitignore แล้ว)

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Langfuse (ใส่ทีหลังได้ ตอนทำส่วนประเมินผล)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# ชั้นเวกเตอร์ off = เทียบตัวอักษรอย่างเดียว  on = เปิด RAG
# สลับค่าแล้วรัน docker compose up -d mcp เพื่อวัดผลเทียบกัน
RAG_MODE=off

# คัดลอกไฟล์นี้เป็น .env แล้วใส่ค่าจริง (.env ถูกกันไว้ใน .gitignore แล้ว)

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxx
OPENROUTER_MODEL=qwen/qwen-2.5-72b-instruct

# Langfuse (ใส่ทีหลังได้ ตอนทำส่วนประเมินผล)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# โหมดการค้นค่า สลับแล้วรัน docker compose up -d mcp เพื่อวัดผลเทียบกันสามขา
#   off     เทียบตัวอักษรอย่างเดียว เป็นฐานเปรียบเทียบ
#   bm25    ตัดคำไทยแล้วนับคำซ้ำ ของถูกแต่แก้ได้หลายเคส
#   rerank  เพิ่ม cross-encoder ให้คะแนนทุกค่าในคอลัมน์ ต่อจาก bm25
RAG_MODE=off

# โมเดลจัดอันดับ ฝังใน image ตอน build เปลี่ยนแล้วต้อง --build ใหม่
#   BAAI/bge-reranker-v2-m3   รองรับไทย ราว 2.2 GB
#   BAAI/bge-reranker-base    เล็กกว่า ราว 1.1 GB แต่ไทยอ่อนกว่า
RERANK_MODEL=BAAI/bge-reranker-v2-m3

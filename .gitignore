# ความลับ ห้ามขึ้น git เด็ดขาด
.env
*.key

# ไฟล์ข้อมูลขนาดใหญ่ สร้างใหม่ได้จาก 01_fetch_explore.py และ 02_build_db.py
data/*.db
data/*.db-journal
data/*.csv
data/*.json

# ผลการประเมิน สร้างใหม่ได้ด้วย python3 -m eval.run_eval
eval/results_*.json

# ผลลัพธ์ระหว่างรัน
charts/*
!charts/.gitkeep
*.png
*.log

# ยกเว้นภาพประกอบ README ต้องขึ้น git ไม่งั้น GitHub แสดงภาพไม่ได้
!docs/images/*.png

# ถูกแทนที่ด้วย glossary-book.gif แล้ว ไม่ได้ใช้ใน README
docs/images/glossary-pages.png

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.ipynb_checkpoints/

# macOS
.DS_Store

# คลังกฎหมาย กสทช.
# PDF ต้นฉบับ 16 MB โหลดใหม่ได้ด้วย data/law/download_pdfs.sh
# txt สร้างใหม่ได้ด้วย lawrag/extract.py
data/law/pdf/
data/law/txt/

# เวกเตอร์ที่ encode ไว้ ชุดละ 2.8 MB สร้างใหม่ได้ด้วย lawrag/index.py
# เก็บไว้บนเครื่องเพื่อให้รันซ้ำไม่ต้อง encode ใหม่ แต่ไม่ต้องขึ้น git
data/law/emb_*.npy

# ดัชนี BM25 สร้างใหม่ได้ด้วย lawrag/index.py
data/law/*.pkl

# ไฟล์สำรองก่อนแก้ข้อมูล เก็บไว้เทียบบนเครื่องเท่านั้น
data/law/*.before_*.json

# ไฟล์ชั่วคราวระหว่างแก้เอกสาร ขึ้นต้นด้วยขีดล่าง
data/law/_*

# ผลพลอยได้จากขั้นซ่อมวรรณยุกต์และแคชเวกเตอร์ (2026-11-21)
data/law/emb_*_keys.json        # กุญแจแคชเวกเตอร์ สร้างใหม่ได้
data/law/tone_fix_cache.json        # แคชผลซ่อมวรรณยุกต์ สร้างใหม่ได้ แต่เสียเงินยิง API ซ้ำ
data/law/tone_fix_report.csv        # รายงานการซ่อม สร้างใหม่ได้

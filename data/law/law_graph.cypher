CREATE (:Document {id: "doc::24_keyword", title: "เรื่อง หลักเกณฑ์และวิธีการจัดเก็บรายได้เพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม (ฉบับที่ 2)", law_type: "ประกาศ กสทช.", category: "ด้านการเงิน", url: "https://ratchakitcha.soc.go.th/documents/1992923.pdf", n_chunks: 8});

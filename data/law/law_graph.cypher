CREATE (:Document {id: "doc::33_protect", title: "เรื่อง การกระทําที่น่าจะเป็นการเอาเปรียบผู้บริโภคในกิจการโทรคมนาคม โดยอาศัยการใช้เครือข่ายหรือการโฆษณาอันมีลักษณะเป็นการค้ากําไรเกินควรหรือก่อให้เกิดความเดือดร้อนรําคาญ พ.ศ. 2558", law_type: "ประกาศ กสทช.", category: "ส่งเสริม/คุ้มครอง", url: "https://ratchakitcha.soc.go.th/documents/2051700.pdf", n_chunks: 11});
CREATE (:Document {id: "doc::34_protect", title: "เรื่อง แผนการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม (ฉบับที่ 4) พ.ศ. 2566 (ที่แก้ไขเพิ่มเติม ครั้งที่ 1)", law_type: "ประกาศ กสทช.", category: "ส่งเสริม/คุ้มครอง", url: "https://ratchakitcha.soc.go.th/documents/31696.pdf", n_chunks: 3});
CREATE (:Document {id: "doc::35_keyword", title: "เรื่อง หลักเกณฑ์และวิธีการงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ในกรณีที่มีเหตุฉุกเฉิน หรือมีความจำเป็น เพื่อรักษาความสงบเรียบร้อยของประชาชน ความมั่นคงของประเทศ หรือเสถียรภาพทางเศรษฐกิจ หรือเพื่อป้องกันประโยชน์สาธารณะ", law_type: "กทช.", category: "การดำเนินงานอื่นๆ", url: "https://ratchakitcha.soc.go.th/documents/1801846.pdf", n_chunks: 11});

CREATE (:Chunk {id: "chunk::09_act::มาตรา_18", doc: "09_act.pdf", unit: "มาตรา", number: 18, muad: "", title: "พระราชบัญญัติการอำนวยความสะดวกในการพิจารณาอนุญาตของทางราชการ พ.ศ. 2558", preview: "มาตรา ๑๘ ให้นายกรัฐมนตรีรักษาการตามพระราชบัญญัตินี้ ผู้รับสนองพระบรมราชโองการ พลเอก ประยุทธ์ จันทร์โอชา นายกรัฐมนตรี หมายเหตุ :- เหตุผลในการ", n_chars: 733});
CREATE (:ActSection {id: "sec::พ.ร.บ. อำนวยความสะดวกฯ พ.ศ. 2558::18", act: "พ.ร.บ. อำนวยความสะดวกฯ พ.ศ. 2558", number: 18});
CREATE (:Chunk {id: "chunk::10_keyword::preamble", doc: "10_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการพักหรือหยุดการให้บริการโทรคมนาคม", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ์และวิธีการพักหรือหยุดการให้บริการโทรคมนาคม โดยที", n_chars: 676});
CREATE (:Chunk {id: "chunk::10_keyword::ข้อ_1", doc: "10_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการพักหรือหยุดการให้บริการโทรคมนาคม", preview: "ข้อ ๑ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 78});
CREATE (:Chunk {id: "chunk::10_keyword::ข้อ_2", doc: "10_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการพักหรือหยุดการให้บริการโทรคมนาคม", preview: "ข้อ ๒ บรรดาประกาศ ข้อบังคับ หรือคำสั่งอื่นใดในส่วนที่ได้กำหนดไว้แล้วในประกาศนี้ หรือซึ่งขัดหรือแย้งกับประกาศนี้ ให้ใช้ประกาศนี้แทน", n_chars: 130});
CREATE (:Chunk {id: "chunk::10_keyword::ข้อ_3", doc: "10_keyword.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการพักหรือหยุดการให้บริการโทรคมนาคม", preview: "ข้อ ๓ ประกาศนี้มิให้ใช้บังคับกับการระงับการให้บริการโทรคมนาคมตามข้อกำหนดสัญญา ให้บริการโทรคมนาคมระหว่างผู้รับใบอนุญาตกับผู้ใช้บริการปลายทาง ", n_chars: 349});
CREATE (:Chunk {id: "chunk::10_keyword::ข้อ_4", doc: "10_keyword.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการพักหรือหยุดการให้บริการโทรคมนาคม", preview: "ข้อ ๔ ในประกาศนี้ “ผู้รับใบอนุญาต” หมายความว่า ผู้รับใบอนุญาตประกอบกิจการโทรคมนาคมตามกฎหมาย ว่าด้วยการประกอบกิจการโทรคมนาคม “บริการโทรคมนาคม", n_chars: 712});
CREATE (:Definition {id: "term::ผู้รับใบอนุญาต", term: "ผู้รับใบอนุญาต"});
CREATE (:Definition {id: "term::บริการโทรคมนาคม", term: "บริการโทรคมนาคม"});
CREATE (:Definition {id: "term::ผู้ใช้บริการ", term: "ผู้ใช้บริการ"});
CREATE (:Definition {id: "term::พักหรือหยุดการให้บริการ", term: "พักหรือหยุดการให้บริการ"});
CREATE (:Chunk {id: "chunk::10_keyword::ข้อ_5", doc: "10_keyword.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการพักหรือหยุดการให้บริการโทรคมนาคม", preview: "ข้อ ๕ ผู้รับใบอนุญาตจะพักหรือหยุดการให้บริการไม่ว่าทั้งหมดหรือบางส่วนไม่ได้ เว้นแต่ จะได้รับอนุญาตจาก กสทช. ตามประกาศนี้ กรณีผู้รับใบอนุญาตป", n_chars: 641});
CREATE (:Chunk {id: "chunk::10_keyword::ข้อ_6", doc: "10_keyword.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการพักหรือหยุดการให้บริการโทรคมนาคม", preview: "ข้อ ๖ เมื่อผู้รับใบอนุญาตประสงค์จะพักหรือหยุดการให้บริการให้ดำเนินการขออนุญาต เป็นลายลักษณ์อักษรต่อ กสทช. ล่วงหน้าก่อนพักหรือหยุดการให้บริกา", n_chars: 320});
CREATE (:Chunk {id: "chunk::10_keyword::ข้อ_7", doc: "10_keyword.pdf", unit: "ข้อ", number: 7, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการพักหรือหยุดการให้บริการโทรคมนาคม", preview: "ข้อ ๗ การขออนุญาตพักหรือหยุดการให้บริการตามข้อ ๖ ให้ผู้รับใบอนุญาตนาส่งคำขอ โดยต้องมีรายละเอียด ดังนี้ (๑) เหตุผลความจำเป็นในการพักหรือหยุดก", n_chars: 1055});
CREATE (:Chunk {id: "chunk::10_keyword::ข้อ_8", doc: "10_keyword.pdf", unit: "ข้อ", number: 8, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการพักหรือหยุดการให้บริการโทรคมนาคม", preview: "ข้อ ๘ ให้สำนักงาน กสทช. ตรวจสอบเอกสารหลักฐานในการพิจารณาอนุญาตให้แล้วเสร็จ ภายในสิบห้าวันนับแต่วันที่ได้รับคำขอ หากปรากฏว่าเอกสารหลักฐานไม่ค", n_chars: 453});
CREATE (:Chunk {id: "chunk::10_keyword::ข้อ_9", doc: "10_keyword.pdf", unit: "ข้อ", number: 9, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการพักหรือหยุดการให้บริการโทรคมนาคม", preview: "ข้อ ๙ ในกรณีที่ กสทช. อนุญาตให้พักหรือหยุดการให้บริการ ให้ผู้รับใบอนุญาตแจ้งเป็น หนังสือ ข้อมูลอิเล็กทรอนิกส์ หรือโดยวิธีการอื่นตามที่ได้ตกล", n_chars: 343});
CREATE (:Chunk {id: "chunk::10_keyword::ข้อ_10", doc: "10_keyword.pdf", unit: "ข้อ", number: 10, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการพักหรือหยุดการให้บริการโทรคมนาคม", preview: "ข้อ ๑๐ เมื่อครบกำหนดระยะเวลาที่ได้รับอนุญาตให้พักหรือหยุดการให้บริการแล้ว ผู้รับใบอนุญาตต้องเปิดให้บริการโดยทันที พร้อมทั้งแจ้งเป็นหนังสือให", n_chars: 969});
CREATE (:Chunk {id: "chunk::11_keyword::preamble", doc: "11_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่ โดยที่เป็", n_chars: 1099});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_1", doc: "11_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๑ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 78});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_2", doc: "11_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๒ ให้ยกเลิก (๑) ประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ์บริการคงสิทธิ เลขหมายโทรศัพท์เคลื่อนที่ ลงวันที่ ๒๘ กรกฎาคม ๒๕๕๒", n_chars: 276});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_3", doc: "11_keyword.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๓ บรรดาประกาศ ระเบียบ ข้อบังคับ หรือคำสั่งอื่นใด ในส่วนที่ได้กำหนดไว้แล้ว ในประกาศนี้ หรือซึ่งขัดหรือแย้งกับประกาศนี้ ให้ใช้ประกาศนี้แทน", n_chars: 140});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_4", doc: "11_keyword.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๔ ในประกาศนี้ “การคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่” หมายความว่า การบริการที่ผู้ใช้บริการโทรศัพท์เคลื่อนที่ สามารถขอให้ผู้ให้บริการโทรศัพ", n_chars: 1796});

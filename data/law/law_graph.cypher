CREATE (:Document {id: "doc::36_keyword", title: "เรื่อง กำหนดระยะเวลาการพิจารณาคำขอหรือคำร้องเรียนในกิจการโทรคมนาคม", law_type: "ประกาศ กสทช.", category: "การดำเนินงานอื่นๆ", url: "https://ratchakitcha.soc.go.th/documents/15882.pdf", n_chunks: 3});
CREATE (:Chunk {id: "chunk::01_act::preamble_p1", doc: "01_act.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "พระราชบัญญัติ องค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการ วิทยุกระจายเสียง วิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. ๒๕๕๓ และที่แก้ไขเพิ่มเต", n_chars: 839});
CREATE (:Chunk {id: "chunk::01_act::preamble_p2", doc: "01_act.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "ภาคผนวก ● พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบ กิจการวิทยุกระจายเสียง วิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. ๒๕๕๓ ๖๗ ● ประก", n_chars: 2462});
CREATE (:Chunk {id: "chunk::01_act::preamble_p3", doc: "01_act.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "กับนโยบายที่คณะรัฐมนตรีแถลงไว้ต่อรัฐสภา และต้องสอดคล้องกับนโยบายและแผนระดับชาติ ว่าด้วยการพัฒนาดิจิทัลเพื่อเศรษฐกิจและสังคม บทกำหนดโทษ มาตรา", n_chars: 1034});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_46", doc: "01_act.pdf", unit: "มาตรา", number: 46, muad: "", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๔๖ มาตรา ๔๗ มาตรา ๖๑ และมาตรา ๖๔ ของรัฐธรรมนูญแห่งราชอาณาจักรไทย บัญญัติให้กระทำได้โดยอาศัยอำนาจตามบทบัญญัติแห่งกฎหมาย จึงทรงพระกรุณาโ", n_chars: 216});

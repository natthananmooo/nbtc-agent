CREATE (:Document {id: "doc::20_keyword", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", law_type: "ประกาศ กสทช.", category: "ด้านการเงิน", url: "https://ratchakitcha.soc.go.th/documents/17189694.pdf", n_chunks: 17});
CREATE (:Document {id: "doc::21_keyword", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", law_type: "ประกาศ กสทช.", category: "ด้านการเงิน", url: "https://ratchakitcha.soc.go.th/documents/140D232S0000000001200.pdf", n_chunks: 19});
CREATE (:Document {id: "doc::23_keyword", title: "เรื่อง หลักเกณฑ์และวิธีการนำค่าใช้จ่ายที่เกิดขึ้นจากภารกิจด้านโทรคมนาคมเพื่อประโยชน์สาธารณะ มาหักลดหย่อนจากรายได้ที่ต้องจัดสรรเพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม", law_type: "ประกาศ กสทช.", category: "ด้านการเงิน", url: "https://ratchakitcha.soc.go.th/documents/17063538.pdf", n_chunks: 5});

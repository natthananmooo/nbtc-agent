CREATE (:Chunk {id: "chunk::01_act::มาตรา_44_d1", doc: "01_act.pdf", unit: "มาตรา", number: 44, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๔๔ ให้นายกรัฐมนตรีรักษาการตามพระราชบัญญัตินี้ หมายเหตุ :- เหตุผลในการประกาศใช้พระราชบัญญัติฉบับนี้คือ โดยที่ได้มีการจัดตั้ง คณะกรรมการ", n_chars: 1279});

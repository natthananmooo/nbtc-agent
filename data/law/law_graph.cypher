CREATE (:Chunk {id: "chunk::01_act::มาตรา_64_d1", doc: "01_act.pdf", unit: "มาตรา", number: 64, muad: "หมวด 5", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๖๔ ให้เลขาธิการ กสทช. และพนักงานของสำนักงาน กสทช. เป็นเจ้าหน้าที่ของรัฐ ตามกฎหมายประกอบรัฐธรรมนูญว่าด้วยการป้องกันและปราบปรามการทุจริต", n_chars: 656});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_65_d3", doc: "01_act.pdf", unit: "มาตรา", number: 65, muad: "หมวด 5", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๖๕ รายได้ของสำนักงาน กสทช. มีดังต่อไปนี้ (๑) ค่าธรรมเนียมใบอนุญาตให้ใช้คลื่นความถี่และค่าธรรมเนียมใบอนุญาตประกอบกิจการ ตามมาตรา ๔๒ วรร", n_chars: 986});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_66_d1", doc: "01_act.pdf", unit: "มาตรา", number: 66, muad: "หมวด 5", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๖๖ เพื่อประโยชน์ในการจัดสรรเงินงบประมาณแผ่นดินให้แก่สำนักงาน กสทช. ตามมาตรา ๖๕ วรรคสาม ให้สำนักงาน กสทช. เสนองบประมาณรายจ่ายของปีงบประ", n_chars: 701});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_67", doc: "01_act.pdf", unit: "มาตรา", number: 67, muad: "หมวด 5", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๖๗ บรรดาอสังหาริมทรัพย์ที่สำนักงาน กสทช. ได้มาโดยการซื้อหรือแลกเปลี่ยน จากรายได้ของสำนักงาน กสทช. ตามมาตรา ๖๕ (๑) (๒) หรือ (๓) หรือที่", n_chars: 469});

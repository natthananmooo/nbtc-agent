CREATE (:Chunk {id: "chunk::01_act::มาตรา_82", doc: "01_act.pdf", unit: "มาตรา", number: 82, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๘๒ เมื่อมีการแต่งตั้ง กสทช. แล้ว ให้ส่วนราชการ รัฐวิสาหกิจ หน่วยงานของรัฐ หรือบุคคลใดที่ได้รับจัดสรรคลื่นความถี่หรือใช้คลื่นความถี่เพื", n_chars: 770});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_83_d2", doc: "01_act.pdf", unit: "มาตรา", number: 83, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๘๓ ผู้ได้รับจัดสรรคลื่นความถี่หรือใช้คลื่นความถี่เพื่อการประกอบกิจการกระจายเสียง หรือกิจการโทรทัศน์ที่ชอบด้วยกฎหมาย อยู่ในวันที่พระราช", n_chars: 175});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_82_d1", doc: "01_act.pdf", unit: "มาตรา", number: 82, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๘๒ แล้ว ให้ถือว่าได้รับอนุญาตจาก กสทช. ตามพระราชบัญญัตินี้ และให้ กสทช. กำกับดูแล ให้ผู้ได้รับจัดสรรคลื่นความถี่หรือใช้คลื่นความถี่นั้", n_chars: 963});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_84_d2", doc: "01_act.pdf", unit: "มาตรา", number: 84, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๘๔ ผู้ได้รับจัดสรรคลื่นความถี่หรือใช้คลื่นความถี่เพื่อกิจการโทรคมนาคมที่ชอบด้วย กฎหมายอยู่ในวันที่พระราชบัญญัตินี้ใช้บังคับและได้ปฏิบั", n_chars: 1774});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_85_d1", doc: "01_act.pdf", unit: "มาตรา", number: 85, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๘๕ ในวาระเริ่มแรกมิให้นำบทบัญญัติมาตรา ๔๙ ในส่วนที่เกี่ยวกับการจัดให้ภาค ประชาชนได้ใช้คลื่นความถี่ในกิจการโทรทัศน์ไม่น้อยกว่าร้อยละยี่", n_chars: 809});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_86_d1", doc: "01_act.pdf", unit: "มาตรา", number: 86, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๘๖ ผู้ได้รับใบอนุญาตประกอบกิจการโทรคมนาคมที่คณะกรรมการกิจการ โทรคมนาคมแห่งชาติมอบหมายให้ดำเนินการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่ว", n_chars: 490});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_87_d1", doc: "01_act.pdf", unit: "มาตรา", number: 87, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๘๗ บรรดาใบอนุญาตที่ออกโดยชอบด้วยกฎหมายตามพระราชบัญญัติวิทยุคมนาคม พ.ศ. ๒๔๙๘ พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับกิจการวิทยุกร", n_chars: 734});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_83_d3", doc: "01_act.pdf", unit: "มาตรา", number: 83, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๘๓ วรรคสามมาใช้บังคับโดยอนุโลม 109", n_chars: 40});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_88_d1", doc: "01_act.pdf", unit: "มาตรา", number: 88, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๘๘ ภายในหนึ่งร้อยยี่สิบวันนับแต่วันที่พระราชบัญญัตินี้ใช้บังคับ ให้ กสทช. ออกใบอนุญาตให้ใช้คลื่นความถี่และใบอนุญาตประกอบกิจการตามกฎหมา", n_chars: 885});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_89_d1", doc: "01_act.pdf", unit: "มาตรา", number: 89, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๘๙ ให้โอนบรรดากิจการ ทรัพย์สิน สิทธิ หน้าที่ หนี้ พนักงานและลูกจ้าง และเงินงบประมาณ ของสำนักงานคณะกรรมการกิจการโทรคมนาคมแห่งชาติที่มีอ", n_chars: 662});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_90", doc: "01_act.pdf", unit: "มาตรา", number: 90, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๙๐ ในวาระเริ่มแรก ให้ดำเนินการแต่งตั้งเลขาธิการ กสทช. ตามพระราชบัญญัตินี้ ภายในกำหนดเก้าสิบวันนับแต่วันที่มีการแต่งตั้ง กสทช. ตามพระรา", n_chars: 470});
CREATE (:ActSection {id: "sec::พ.ร.บ. องค์กรจัดสรรคลื่นความถี่ฯ พ.ศ. 2553::90", act: "พ.ร.บ. องค์กรจัดสรรคลื่นความถี่ฯ พ.ศ. 2553", number: 90});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_91_d1", doc: "01_act.pdf", unit: "มาตรา", number: 91, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๙๑ ให้โอนเงินและทรัพย์สินของกองทุนพัฒนากิจการกระจายเสียงและกิจการ โทรทัศน์เพื่อประโยชน์สาธารณะ และกองทุนพัฒนากิจการโทรคมนาคมเพื่อประโย", n_chars: 343});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_92", doc: "01_act.pdf", unit: "มาตรา", number: 92, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๙๒ ให้โอนบรรดากิจการ ทรัพย์สิน สิทธิ หน้าที่ ของกรมประชาสัมพันธ์ สำนักนายกรัฐมนตรี ในส่วนที่เกี่ยวกับกองงานคณะกรรมการกิจการวิทยุกระจาย", n_chars: 388});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_93", doc: "01_act.pdf", unit: "มาตรา", number: 93, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๙๓ ข้าราชการและลูกจ้างของกองงานคณะกรรมการกิจการวิทยุกระจายเสียง และวิทยุโทรทัศน์แห่งชาติ กรมประชาสัมพันธ์ สำนักนายกรัฐมนตรี ที่ดำรงตำแ", n_chars: 936});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_94", doc: "01_act.pdf", unit: "มาตรา", number: 94, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๙๔ การบรรจุและแต่งตั้งข้าราชการตามมาตรา ๙๓ ให้ถือว่าเป็นการให้ออกจาก ราชการเพราะเลิกหรือยุบตำแหน่งตามกฎหมายว่าด้วยบำเหน็จบำนาญข้าราชกา", n_chars: 382});
CREATE (:ActSection {id: "sec::พ.ร.บ. องค์กรจัดสรรคลื่นความถี่ฯ พ.ศ. 2553::94", act: "พ.ร.บ. องค์กรจัดสรรคลื่นความถี่ฯ พ.ศ. 2553", number: 94});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_95_p1", doc: "01_act.pdf", unit: "มาตรา", number: 95, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๙๕ ให้บรรดาระเบียบ ข้อบังคับ ประกาศ หรือคำสั่งที่ออกตามพระราชบัญญัติ องค์กรจัดสรรคลื่นความถี่และกำกับกิจการวิทยุกระจายเสียง วิทยุโทรทั", n_chars: 765});
CREATE (:ActSection {id: "sec::พ.ร.บ. องค์กรจัดสรรคลื่นความถี่ฯ พ.ศ. 2553::95", act: "พ.ร.บ. องค์กรจัดสรรคลื่นความถี่ฯ พ.ศ. 2553", number: 95});

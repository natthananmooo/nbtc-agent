CREATE (:Chunk {id: "chunk::01_act::มาตรา_24", doc: "01_act.pdf", unit: "มาตรา", number: 24, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒๔ การปฏิบัติหน้าที่ของ กสทช. กสท. และ กทค. ในเรื่องใดที่เกี่ยวข้อง หรือมีผลกระทบต่อประโยชน์สาธารณะ ต้องกระทำโดยมติของที่ประชุมและต้อง", n_chars: 501});

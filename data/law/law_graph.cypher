CREATE (:Chunk {id: "chunk::01_act::มาตรา_95_p2", doc: "01_act.pdf", unit: "มาตรา", number: 95, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "(๑) บัญญัติให้กฎหมายจัดตั้งองค์กรที่ตราขึ้นจะต้องมีสาระสำคัญให้มี คณะกรรมการเฉพาะด้านเป็นหน่วยย่อยภายในองค์กรนั้นแยกต่างหากจากกัน ทำหน้าที่ก", n_chars: 2457});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_95_p3", doc: "01_act.pdf", unit: "มาตรา", number: 95, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "วรรคหกเป็นค่าธรรมเนียมใบอนุญาตให้ใช้คลื่นความถี่ซึ่งต้องชำระเมื่อได้รับใบอนุญาต และเมื่อหัก ค่าใช้จ่ายแล้วให้นำส่งเข้าเป็นรายได้แผ่นดิน” ข้อ", n_chars: 1391});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_95_p4", doc: "01_act.pdf", unit: "มาตรา", number: 95, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "(๑๑) และมีวาระการดำรงตำแหน่งคราวละสามปี และอาจได้รับ การแต่งตั้งอีกได้ แต่จะดำรงตำแหน่งติดต่อกันเกินสองวาระมิได้ ให้นำมาตรา ๒๓ มาใช้บังคับกั", n_chars: 1391});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_1_d2", doc: "01_act.pdf", unit: "มาตรา", number: 1, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๑ พระราชบัญญัตินี้เรียกว่า “พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และ กำกับการประกอบกิจการวิทยุกระจายเสียง วิทยุโทรทัศน์ และกิจการโทรคม", n_chars: 167});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_2_d1", doc: "01_act.pdf", unit: "มาตรา", number: 2, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒ พระราชบัญญัตินี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษา เป็นต้นไป", n_chars: 88});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_3_d2", doc: "01_act.pdf", unit: "มาตรา", number: 3, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๓ ให้ยกเลิกความในมาตรา ๖ แห่งพระราชบัญญัติองค์กรจัดสรรคลื่นความถี่ และกำกับการประกอบกิจการวิทยุกระจายเสียง วิทยุโทรทัศน์ และกิจการโทรค", n_chars: 668});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_4_d1", doc: "01_act.pdf", unit: "มาตรา", number: 4, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๔ ให้ยกเลิกความในมาตรา ๗ แห่งพระราชบัญญัติองค์กรจัดสรรคลื่นความถี่ และกำกับการประกอบกิจการวิทยุกระจายเสียง วิทยุโทรทัศน์ และกิจการโทรค", n_chars: 1829});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_5_d2", doc: "01_act.pdf", unit: "มาตรา", number: 5, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๕ ให้ยกเลิกส่วนที่ ๒ การได้มาซึ่งรายชื่อผู้สมควรได้รับเลือกเป็นกรรมการ โดยวิธีการคัดเลือกกันเอง มาตรา ๙ ถึงมาตรา ๑๓ ในหมวด ๑ คณะกรรมกา", n_chars: 325});

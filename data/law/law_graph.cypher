CREATE (:Chunk {id: "chunk::09_act::มาตรา_6", doc: "09_act.pdf", unit: "มาตรา", number: 6, muad: "", title: "พระราชบัญญัติการอำนวยความสะดวกในการพิจารณาอนุญาตของทางราชการ พ.ศ. 2558", preview: "มาตรา ๖ ทุกห้าปีนับแต่วันที่พระราชบัญญัตินี้ใช้บังคับ ให้ผู้อนุญาตพิจารณากฎหมาย ที่ให้อำนาจในการอนุญาตว่าสมควรปรับปรุงกฎหมายนั้นเพื่อยกเลิกก", n_chars: 551});
CREATE (:ActSection {id: "sec::พ.ร.บ. อำนวยความสะดวกฯ พ.ศ. 2558::6", act: "พ.ร.บ. อำนวยความสะดวกฯ พ.ศ. 2558", number: 6});
CREATE (:Chunk {id: "chunk::09_act::มาตรา_7", doc: "09_act.pdf", unit: "มาตรา", number: 7, muad: "", title: "พระราชบัญญัติการอำนวยความสะดวกในการพิจารณาอนุญาตของทางราชการ พ.ศ. 2558", preview: "มาตรา ๗ ในกรณีที่มีกฎหมายกำหนดให้การกระทำใดจะต้องได้รับอนุญาต ผู้อนุญาตจะต้องจัดทำ คู่มือสำหรับประชาชน ซึ่งอย่างน้อยต้องประกอบด้วย หลักเกณฑ์", n_chars: 1218});
CREATE (:ActSection {id: "sec::พ.ร.บ. อำนวยความสะดวกฯ พ.ศ. 2558::7", act: "พ.ร.บ. อำนวยความสะดวกฯ พ.ศ. 2558", number: 7});
CREATE (:Chunk {id: "chunk::09_act::มาตรา_8", doc: "09_act.pdf", unit: "มาตรา", number: 8, muad: "", title: "พระราชบัญญัติการอำนวยความสะดวกในการพิจารณาอนุญาตของทางราชการ พ.ศ. 2558", preview: "มาตรา ๘ ให้เป็นหน้าที่ของพนักงานเจ้าหน้าที่ผู้มีหน้าที่ในการรับคำขอจะต้องตรวจสอบคำขอ และรายการเอกสารหรือหลักฐานที่ยื่นพร้อมคำขอให้ถูกต้องครบ", n_chars: 1392});
CREATE (:ActSection {id: "sec::พ.ร.บ. อำนวยความสะดวกฯ พ.ศ. 2558::8", act: "พ.ร.บ. อำนวยความสะดวกฯ พ.ศ. 2558", number: 8});
CREATE (:Chunk {id: "chunk::09_act::มาตรา_9", doc: "09_act.pdf", unit: "มาตรา", number: 9, muad: "", title: "พระราชบัญญัติการอำนวยความสะดวกในการพิจารณาอนุญาตของทางราชการ พ.ศ. 2558", preview: "มาตรา ๙ ในกรณีที่ผู้ยื่นคำขอไม่แก้ไขเพิ่มเติมคำขอหรือไม่ส่งเอกสารหรือหลักฐานเพิ่มเติม ตามที่พนักงานเจ้าหน้าที่แจ้งให้ทราบหรือตามที่ปรากฏในบั", n_chars: 504});
CREATE (:ActSection {id: "sec::พ.ร.บ. อำนวยความสะดวกฯ พ.ศ. 2558::9", act: "พ.ร.บ. อำนวยความสะดวกฯ พ.ศ. 2558", number: 9});
CREATE (:Chunk {id: "chunk::09_act::มาตรา_10", doc: "09_act.pdf", unit: "มาตรา", number: 10, muad: "", title: "พระราชบัญญัติการอำนวยความสะดวกในการพิจารณาอนุญาตของทางราชการ พ.ศ. 2558", preview: "มาตรา ๑๐ ผู้อนุญาตต้องดำเนินการให้แล้วเสร็จภายในกำหนดเวลาที่ระบุไว้ในคู่มือ สำหรับประชาชนตามมาตรา ๗ และแจ้งให้ผู้ยื่นคำขอทราบภายในเจ็ดวันนับ", n_chars: 864});
CREATE (:ActSection {id: "sec::พ.ร.บ. อำนวยความสะดวกฯ พ.ศ. 2558::10", act: "พ.ร.บ. อำนวยความสะดวกฯ พ.ศ. 2558", number: 10});

CREATE (:Document {id: "doc::28_protect", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคมสัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ พ.ศ. 2556", law_type: "ประกาศ กสทช.", category: "ส่งเสริม/คุ้มครอง", url: "https://ratchakitcha.soc.go.th/documents/1982316.pdf", n_chunks: 12});

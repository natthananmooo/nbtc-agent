CREATE (:Chunk {id: "chunk::09_act::มาตรา_5", doc: "09_act.pdf", unit: "มาตรา", number: 5, muad: "", title: "พระราชบัญญัติการอำนวยความสะดวกในการพิจารณาอนุญาตของทางราชการ พ.ศ. 2558", preview: "มาตรา ๕ พระราชบัญญัตินี้มิให้ใช้บังคับแก่ (๑) รัฐสภาและคณะรัฐมนตรี (๒) การพิจารณาพิพากษาคดีของศาลและการดำเนินงานของเจ้าหน้าที่ในกระบวนการพิจ", n_chars: 574});

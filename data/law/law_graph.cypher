CREATE (:Chunk {id: "chunk::01_act::มาตรา_21", doc: "01_act.pdf", unit: "มาตรา", number: 21, muad: "", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒1 พระราชบัญญัตินี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศใน ราชกิจจานุเบกษาเป็นต้นไป", n_chars: 89});

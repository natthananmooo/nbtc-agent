CREATE (:Chunk {id: "chunk::01_act::มาตรา_47", doc: "01_act.pdf", unit: "มาตรา", number: 47, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๔๗ มาตรา ๖๑ และมาตรา ๖๔ ของรัฐธรรมนูญแห่งราชอาณาจักรไทย บัญญัติให้กระทำได้ โดยอาศัยอำนาจตามบทบัญญัติแห่งกฎหมาย จึงทรงพระกรุณาโปรดเกล้า", n_chars: 208});

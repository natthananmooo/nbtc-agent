CREATE (:Chunk {id: "chunk::01_act::มาตรา_3", doc: "01_act.pdf", unit: "มาตรา", number: 3, muad: "", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๓ ให้ยกเลิกพระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับกิจการ วิทยุกระจายเสียง วิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. ๒๕๔๓ 1 ราชกิจจาน", n_chars: 192});

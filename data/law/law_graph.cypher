CREATE (:Chunk {id: "chunk::18_keyword::ข้อ_4", doc: "18_keyword.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง ยกเลิกอัตราค่าบริการขั้นสูงชั่วคราว ตามประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูงของค่าบริการและเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๔ ในประกาศนี้ “ผู้รับใบอนุญาตแบบที่สาม” หมายความว่า ผู้รับใบอนุญาตประกอบกิจการโทรคมนาคมแบบที่สาม และให้หมายรวมถึงผู้ได้รับอนุญาต สัมปทาน", n_chars: 707});
CREATE (:Definition {id: "term::ผู้รับใบอนุญาตแบบที่สาม", term: "ผู้รับใบอนุญาตแบบที่สาม"});
CREATE (:Chunk {id: "chunk::18_keyword::ข้อ_5", doc: "18_keyword.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง ยกเลิกอัตราค่าบริการขั้นสูงชั่วคราว ตามประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูงของค่าบริการและเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๕ ให้ยกเลิกอัตราค่าบริการขั้นสูงชั่วคราว ตามข้อ ๔ วรรคหนึ่งของประกาศ คณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูงของค่าบริการแล", n_chars: 299});
CREATE (:Chunk {id: "chunk::18_keyword::ข้อ_6", doc: "18_keyword.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง ยกเลิกอัตราค่าบริการขั้นสูงชั่วคราว ตามประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูงของค่าบริการและเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๖ ผู้รับใบอนุญาตแบบที่สามที่ให้บริการโทรคมนาคมประเภทอื่น ที่มิใช่บริการ โทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศตามกฎหมายว่าด้วยการประกอ", n_chars: 356});
CREATE (:Chunk {id: "chunk::18_keyword::ข้อ_11", doc: "18_keyword.pdf", unit: "ข้อ", number: 11, muad: "", title: "เรื่อง ยกเลิกอัตราค่าบริการขั้นสูงชั่วคราว ตามประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูงของค่าบริการและเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๑ ถึงข้อ ๑๕ ของประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูงของ ค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรค", n_chars: 387});
CREATE (:Chunk {id: "chunk::19_keyword::preamble", doc: "19_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง การกำหนดวงเงินคงเหลือสะสมสูงสุดในการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการ โทรคมนาคมแห่งชาติ เรื่อง การกำหนดวงเงินคงเหลือสะสมสูงสุดในการเรียกเก็บเงินค่าบริก", n_chars: 891});
CREATE (:Chunk {id: "chunk::19_keyword::ข้อ_1", doc: "19_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง การกำหนดวงเงินคงเหลือสะสมสูงสุดในการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่", preview: "ข้อ ๑ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 78});
CREATE (:Chunk {id: "chunk::19_keyword::ข้อ_2", doc: "19_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง การกำหนดวงเงินคงเหลือสะสมสูงสุดในการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่", preview: "ข้อ ๒ ในประกาศนี้ “ผู้รับใบอนุญาต” หมายความว่า ผู้รับใบอนุญาตประกอบกิจการโทรคมนาคมตามกฎหมาย ว่าด้วยการประกอบกิจการโทรคมนาคม และให้หมายความรว", n_chars: 731});
CREATE (:Definition {id: "term::บริการโทรศัพท์เคลื่อนที่", term: "บริการโทรศัพท์เคลื่อนที่"});
CREATE (:Chunk {id: "chunk::19_keyword::ข้อ_3", doc: "19_keyword.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง การกำหนดวงเงินคงเหลือสะสมสูงสุดในการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่", preview: "ข้อ ๓ ให้ผู้รับใบอนุญาตบริการโทรศัพท์เคลื่อนที่กำหนดวงเงินคงเหลือสะสมสูงสุด ของผู้ใช้บริการในการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมน", n_chars: 328});
CREATE (:Chunk {id: "chunk::19_keyword::ข้อ_4", doc: "19_keyword.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง การกำหนดวงเงินคงเหลือสะสมสูงสุดในการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่", preview: "ข้อ ๔ เมื่อประกาศนี้มีผลใช้บังคับ ผู้รับใบอนุญาตต้องไม่อนุญาตให้ผู้ใช้บริการ ที่มีวงเงินคงเหลือสะสมสูงสุดเกินกว่าหนึ่งหมื่นบาทเติมเงินเพิ่มอ", n_chars: 712});
CREATE (:Chunk {id: "chunk::19_keyword::ข้อ_5", doc: "19_keyword.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง การกำหนดวงเงินคงเหลือสะสมสูงสุดในการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่", preview: "ข้อ ๕ ให้ผู้รับใบอนุญาตดำเนินการเผยแพร่การกำหนดวงเงินคงเหลือสะสมสูงสุดใน การเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคมสำหรับบริการโทรศั", n_chars: 646});
CREATE (:Chunk {id: "chunk::20_keyword::preamble", doc: "20_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน", n_chars: 1086});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_1", doc: "20_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๑ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 78});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_2", doc: "20_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๒ บรรดาประกาศ ระเบียบ ข้อบังคับ หรือคำสั่งอื่นใดในส่วนที่ได้กำหนดไว้แล้วในประกาศนี้ หรือซึ่งขัดหรือแย้งกับประกาศนี้ ให้ใช้ประกาศนี้แทน", n_chars: 138});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_3", doc: "20_keyword.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๓ ในประกาศนี้ “ค่าบริการล่วงหน้า” หมายความว่า ค่าบริการที่ผู้ให้บริการเรียกเก็บจากผู้ใช้บริการโดยมี วันครบกำหนดชาระค่าบริการก่อนวันสิ้นส", n_chars: 557});
CREATE (:Definition {id: "term::ค่าบริการล่วงหน้า", term: "ค่าบริการล่วงหน้า"});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_4", doc: "20_keyword.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๔ การเรียกเก็บค่าบริการล่วงหน้าต้องได้รับความเห็นชอบจาก กสทช. ก่อน โดยผู้ให้บริการ ต้องยื่นคำขอพร้อมเอกสารหรือหลักฐานประกอบการพิจารณาอย่", n_chars: 910});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_5", doc: "20_keyword.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๕ การเปลี่ยนแปลงแก้ไขหลักเกณฑ์และวิธีการเรียกเก็บค่าบริการล่วงหน้ำตามข้อ ๔ (๑) ต้องได้รับความเห็นชอบจาก กสทช. ก่อน โดยผู้ให้บริการต้องยื", n_chars: 1175});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_6", doc: "20_keyword.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๖ ผู้ให้บริการจะต้องกำหนดเงื่อนไขการให้บริการที่สอดคล้องกับประกาศว่าด้วยมาตรฐาน ของสัญญาให้บริการโทรคมนาคม ้ หนา ๒๔ ่ เลม ๑๓๘ ตอนพิเศษ ๒", n_chars: 178});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_7", doc: "20_keyword.pdf", unit: "ข้อ", number: 7, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๗ ผู้ให้บริการที่ประสงค์จะเรียกเก็บค่าบริการล่วงหน้า ต้องจัดให้ผู้ใช้บริการมีทางเลือก ในการชาระค่าบริการล่วงหน้าก่อนวันสิ้นสุดรอบการใช้บ", n_chars: 565});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_8", doc: "20_keyword.pdf", unit: "ข้อ", number: 8, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๘ ผู้ให้บริการจะเรียกเก็บค่าบริการล่วงหน้าได้สูงสุดไม่เกินสิบสองเดือน ทั้งนี้ ผู้ให้บริการ ต้องจัดให้มีสิทธิประโยชน์หรือส่วนลดในการชาระค", n_chars: 272});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_9", doc: "20_keyword.pdf", unit: "ข้อ", number: 9, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๙ การเรียกเก็บค่าใช้จ่ายอื่นใดที่กำหนดไว้ในสัญญา ทั้งในกรณีการเรียกเก็บค่าบริการ ล่วงหน้า และการเรียกเก็บค่าบริการภายหลังจากวันสิ้นสุดรอ", n_chars: 311});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_10", doc: "20_keyword.pdf", unit: "ข้อ", number: 10, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๑๐ เมื่อสัญญาเลิกกัน ในกรณีที่ผู้ให้บริการมีเงินค้างชำระแก่ผู้ใช้บริการหรือเงินค่าบริการ ล่วงหน้าที่ผู้ใช้บริการชาระไว้ ผู้ให้บริการต้อง", n_chars: 1223});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_11", doc: "20_keyword.pdf", unit: "ข้อ", number: 11, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๑๑ กรณีที่มีปัญหาข้อร้องเรียนเกี่ยวกับการเรียกเก็บค่าบริการล่วงหน้าระหว่างผู้ใช้บริการ และผู้ให้บริการ ผู้ให้บริการต้องดำเนินการให้สอดคล", n_chars: 317});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_12", doc: "20_keyword.pdf", unit: "ข้อ", number: 12, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๑๒ เมื่อ กสทช. ให้ความเห็นชอบการเรียกเก็บค่าบริการล่วงหน้ำตามข้อ ๔ หรือข้อ ๕ ผู้ให้บริการจะต้องเผยแพร่หลักเกณฑ์และวิธีการเรียกเก็บค่าบริ", n_chars: 352});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_13", doc: "20_keyword.pdf", unit: "ข้อ", number: 13, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๑๓ ผู้ให้บริการที่มีการเรียกเก็บค่าบริการล่วงหน้า ซึ่งได้รับความเห็นชอบจาก กสทช. แล้ว ให้รายงานโครงสร้างและอัตราค่าบริการที่จัดเก็บจากผู", n_chars: 823});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_14", doc: "20_keyword.pdf", unit: "ข้อ", number: 14, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๑๔ การเรียกเก็บค่าบริการล่วงหน้าของผู้ให้บริการรายใดที่ได้รับความเห็นชอบจาก กสทช. เป็นการชั่วคราวก่อนประกาศนี้ใช้บังคับ ต้องปฏิบัติตามปร", n_chars: 253});
CREATE (:Chunk {id: "chunk::20_keyword::ข้อ_15", doc: "20_keyword.pdf", unit: "ข้อ", number: 15, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ข้อ ๑๕ ให้ข้อสัญญาหรือข้อตกลงเกี่ยวกับสิทธิประโยชน์หรือส่วนลดในการเรียกเก็บค่าบริการ ล่วงหน้าซึ่งผู้ใช้บริการได้ทากับผู้ให้บริการที่ได้รับคว", n_chars: 539});
CREATE (:Chunk {id: "chunk::20_keyword::ภาคผนวก_1", doc: "20_keyword.pdf", unit: "ภาคผนวก", number: 1, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจำที่", preview: "ภาคผนวก หลักเกณฑ์และวิธีการเรียกเก็บค่าบริการล่วงหน้า หลักเกณฑ์และวิธีการเรียกเก็บค่าบริการล่วงหน้า ประกอบด้วย (๑) รูปแบบและวิธีการของการเรี", n_chars: 1065});
CREATE (:Chunk {id: "chunk::21_keyword::preamble", doc: "21_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม โ", n_chars: 1064});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_1", doc: "21_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๑ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 78});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_2", doc: "21_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๒ บรรดาประกาศ ระเบียบ ข้อบังคับ หรือคำสั่งอื่นใดในส่วนที่ได้กำหนดไว้แล้ว ในประกาศนี้ หรือซึ่งขัดหรือแย้งกับประกาศนี้ ให้ใช้ประกาศนี้แทน", n_chars: 139});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_3", doc: "21_keyword.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๓ ในประกาศนี้ “ค่าบริการล่วงหน้า” หมายความว่า ค่าบริการที่ผู้ให้บริการเรียกเก็บจากผู้ใช้บริการก่อน การใช้บริการ หรือมีวันครบกำหนดชาระค่า", n_chars: 492});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_4", doc: "21_keyword.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๔ การเรียกเก็บค่าบริการล่วงหน้าของบริการอินเทอร์เน็ตความเร็วสูงประจาที่ ให้เป็นไปตาม ประกาศว่าด้วยหลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้า", n_chars: 246});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_5", doc: "21_keyword.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๕ การเรียกเก็บค่าบริการล่วงหน้าต้องได้รับความเห็นชอบจาก กสทช. ก่อน โดยผู้ให้บริการ ต้องยื่นคำขอพร้อมเอกสารหรือหลักฐานประกอบการพิจารณาอย่", n_chars: 842});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_6", doc: "21_keyword.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๖ การเปลี่ยนแปลงแก้ไขหลักเกณฑ์และวิธีการเรียกเก็บค่าบริการล่วงหน้ำตามข้อ ๕ (๑) ต้องได้รับความเห็นชอบจาก กสทช. ก่อน โดยผู้ให้บริการต้องยื", n_chars: 1242});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_7", doc: "21_keyword.pdf", unit: "ข้อ", number: 7, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๗ การให้บริการโทรคมนาคมในลักษณะที่เรียกเก็บค่าบริการล่วงหน้าจะต้องไม่มีข้อกำหนด อันมีลักษณะเป็นการบังคับให้ผู้ใช้บริการต้องใช้บริการภายใ", n_chars: 449});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_8", doc: "21_keyword.pdf", unit: "ข้อ", number: 8, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๘ ผู้ให้บริการที่ประสงค์จะเรียกเก็บค่าบริการล่วงหน้า ต้องจัดให้ผู้ใช้บริการมีทางเลือก ในการชาระค่าบริการล่วงหน้า และการชาระค่าบริการภายห", n_chars: 700});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_9", doc: "21_keyword.pdf", unit: "ข้อ", number: 9, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๙ กสทช. จะพิจารณาให้ความเห็นชอบในการกำหนดระยะเวลาสูงสุดในการเรียกเก็บ ค่าบริการล่วงหน้าเป็นรายกรณี", n_chars: 102});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_10", doc: "21_keyword.pdf", unit: "ข้อ", number: 10, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๑๐ ผู้ให้บริการต้องจัดให้มีสิทธิประโยชน์หรือส่วนลดในการชาระค่าบริการล่วงหน้า ให้เหมาะสมกับสภาพตลาด สมเหตุสมผล เป็นธรรม และคำนึงถึงระยะเว", n_chars: 581});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_11", doc: "21_keyword.pdf", unit: "ข้อ", number: 11, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๑๑ การเรียกเก็บค่าใช้จ่ายอื่นใดที่กำหนดไว้ในสัญญา ทั้งในกรณีการเรียกเก็บค่าบริการ ล่วงหน้า และการเรียกเก็บค่าบริการภายหลังจากการใช้บริกา", n_chars: 324});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_12", doc: "21_keyword.pdf", unit: "ข้อ", number: 12, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๑๒ เมื่อสัญญาเลิกกัน ในกรณีที่ผู้ให้บริการมีเงินค้างชำระแก่ผู้ใช้บริการหรือเงินค่าบริการ ล่วงหน้าที่ผู้ใช้บริการชาระไว้ ผู้ให้บริการต้อง", n_chars: 821});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_13", doc: "21_keyword.pdf", unit: "ข้อ", number: 13, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๑๓ ในการคืนเงินค่าบริการล่วงหน้าที่ผู้ใช้บริการชาระไว้ ผู้ใช้บริการจะต้องคืนสิทธิประโยชน์ หรือส่วนลดที่ได้รับจากผู้ให้บริการอันเนื่องมาจ", n_chars: 841});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_14", doc: "21_keyword.pdf", unit: "ข้อ", number: 14, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๑๔ กรณีที่มีปัญหาข้อร้องเรียนเกี่ยวกับการเรียกเก็บค่าบริการล่วงหน้าระหว่างผู้ใช้บริการ และผู้ให้บริการ ผู้ให้บริการต้องดำเนินการให้สอดคล", n_chars: 317});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_15", doc: "21_keyword.pdf", unit: "ข้อ", number: 15, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๑๕ เมื่อ กสทช. ให้ความเห็นชอบการเรียกเก็บค่าบริการล่วงหน้ำตามข้อ ๕ หรือข้อ ๖ ผู้ให้บริการจะต้องเผยแพร่หลักเกณฑ์และวิธีการเรียกเก็บค่าบริ", n_chars: 352});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_16", doc: "21_keyword.pdf", unit: "ข้อ", number: 16, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๑๖ ผู้ให้บริการที่มีการเรียกเก็บค่าบริการล่วงหน้า ซึ่งได้รับความเห็นชอบจาก กสทช. แล้ว ให้รายงานโครงสร้างและอัตราค่าบริการที่จัดเก็บจากผู", n_chars: 1155});
CREATE (:Chunk {id: "chunk::21_keyword::ข้อ_17", doc: "21_keyword.pdf", unit: "ข้อ", number: 17, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ข้อ ๑๗ ให้การเรียกเก็บค่าบริการล่วงหน้ำตามประกาศคณะกรรมการกิจการโทรคมนาคม แห่งชาติ เรื่อง อัตราขั้นสูงของค่าบริการและการเก็บค่าบริการล่วงหน้", n_chars: 1141});
CREATE (:Chunk {id: "chunk::21_keyword::ภาคผนวก_1", doc: "21_keyword.pdf", unit: "ภาคผนวก", number: 1, muad: "", title: "เรื่อง หลักเกณฑ์การเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม", preview: "ภาคผนวก หลักเกณฑ์และวิธีการเรียกเก็บค่าบริการล่วงหน้า หลักเกณฑ์และวิธีการเรียกเก็บค่าบริการล่วงหน้า ประกอบด้วย (๑) รูปแบบและวิธีการของการเรี", n_chars: 1385});
CREATE (:Chunk {id: "chunk::23_keyword::preamble", doc: "23_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการนำค่าใช้จ่ายที่เกิดขึ้นจากภารกิจด้านโทรคมนาคมเพื่อประโยชน์สาธารณะ มาหักลดหย่อนจากรายได้ที่ต้องจัดสรรเพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ์และวิธีการนำค่าใช้จ่ายที่เกิดขึ้นจากภารกิจด้านโท", n_chars: 1350});
CREATE (:Chunk {id: "chunk::23_keyword::ข้อ_1", doc: "23_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการนำค่าใช้จ่ายที่เกิดขึ้นจากภารกิจด้านโทรคมนาคมเพื่อประโยชน์สาธารณะ มาหักลดหย่อนจากรายได้ที่ต้องจัดสรรเพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม", preview: "ข้อ 1 ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 78});
CREATE (:Chunk {id: "chunk::23_keyword::ข้อ_2", doc: "23_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการนำค่าใช้จ่ายที่เกิดขึ้นจากภารกิจด้านโทรคมนาคมเพื่อประโยชน์สาธารณะ มาหักลดหย่อนจากรายได้ที่ต้องจัดสรรเพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม", preview: "ข้อ 2 ในประกาศนี้ “ค่าใช้จ่าย” หมายความว่า ค่าใช้จ่ายที่เป็นต้นทุนทางตรงที่เกิดขึ้นจากภารกิจด้านโทรคมนาคม เพื่อประโยชน์สาธารณะ “ภารกิจด้านโท", n_chars: 704});
CREATE (:Definition {id: "term::ค่าใช้จ่าย", term: "ค่าใช้จ่าย"});
CREATE (:Definition {id: "term::ภารกิจด้านโทรคมนาคมเพื่อประโยชน์สาธารณะ", term: "ภารกิจด้านโทรคมนาคมเพื่อประโยชน์สาธารณะ"});
CREATE (:Definition {id: "term::รายได้ที่ต้องจัดสรร", term: "รายได้ที่ต้องจัดสรร"});
CREATE (:Chunk {id: "chunk::23_keyword::ข้อ_3", doc: "23_keyword.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการนำค่าใช้จ่ายที่เกิดขึ้นจากภารกิจด้านโทรคมนาคมเพื่อประโยชน์สาธารณะ มาหักลดหย่อนจากรายได้ที่ต้องจัดสรรเพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม", preview: "ข้อ 3 ผู้รับใบอนุญาตที่สามารถนาค่าใช้จ่ายที่เกิดขึ้นจากภารกิจด้านโทรคมนาคม เพื่อประโยชน์สาธารณะ มาหักลดหย่อนจากรายได้ที่ต้องจัดสรร ต้องเป็นผ", n_chars: 252});
CREATE (:Chunk {id: "chunk::23_keyword::ข้อ_4", doc: "23_keyword.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการนำค่าใช้จ่ายที่เกิดขึ้นจากภารกิจด้านโทรคมนาคมเพื่อประโยชน์สาธารณะ มาหักลดหย่อนจากรายได้ที่ต้องจัดสรรเพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม", preview: "ข้อ 4 ให้ผู้รับใบอนุญาตนารายการและจำนวนค่าใช้จ่ายทั้งหมดหรือบางส่วนตามที่ได้รับ ความเห็นชอบจาก กสทช. มาหักลดหย่อนจากรายได้ที่ต้องจัดสรรตามเง", n_chars: 958});
CREATE (:Chunk {id: "chunk::24_keyword::preamble", doc: "24_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการจัดเก็บรายได้เพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม (ฉบับที่ 2)", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ์และวิธีการจัดเก็บรายได้เพื่อนำไปใช้ในการจัดให้มี", n_chars: 1659});
CREATE (:Chunk {id: "chunk::24_keyword::ข้อ_1", doc: "24_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการจัดเก็บรายได้เพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม (ฉบับที่ 2)", preview: "ข้อ ๑ ประกาศนี้เรียกว่า “ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ์และวิธีการจัดเก็บรายได้", n_chars: 230});
CREATE (:Chunk {id: "chunk::24_keyword::ข้อ_2", doc: "24_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการจัดเก็บรายได้เพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม (ฉบับที่ 2)", preview: "ข้อ ๒ ประกาศนี้ให้ใช้บังคับตั้งแต่วันที่ ๑ มกราคม ๒๕๕๗ เป็นต้นไป", n_chars: 64});
CREATE (:Chunk {id: "chunk::24_keyword::ข้อ_3", doc: "24_keyword.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการจัดเก็บรายได้เพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม (ฉบับที่ 2)", preview: "ข้อ ๓ บรรดาประกาศ ระเบียบ ข้อบังคับ หรือคำสั่งอื่นใด ในส่วนที่มีกำหนดไว้แล้ว ในประกาศนี้ หรือซึ่งขัดหรือแย้งกับประกาศนี้ ให้ใช้ประกาศนี้แทน", n_chars: 139});
CREATE (:Chunk {id: "chunk::24_keyword::ข้อ_4", doc: "24_keyword.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการจัดเก็บรายได้เพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม (ฉบับที่ 2)", preview: "ข้อ ๔ ให้ยกเลิกความในข้อ ๖ วรรคสอง ของประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ์และวิธีการ", n_chars: 480});
CREATE (:Chunk {id: "chunk::24_keyword::ข้อ_5", doc: "24_keyword.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการจัดเก็บรายได้เพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม (ฉบับที่ 2)", preview: "ข้อ ๕ ให้ยกเลิกความในข้อ ๗ ของประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ์และวิธีการจัดเก็บร", n_chars: 517});
CREATE (:Chunk {id: "chunk::24_keyword::ข้อ_6_p1", doc: "24_keyword.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการจัดเก็บรายได้เพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม (ฉบับที่ 2)", preview: "ข้อ ๖ ให้เพิ่มความต่อไปนี้เป็นข้อ ๙.๖ และ ๙.๗ ของประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ", n_chars: 2117});
CREATE (:Chunk {id: "chunk::24_keyword::ข้อ_6_p2", doc: "24_keyword.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการจัดเก็บรายได้เพื่อนำไปใช้ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม (ฉบับที่ 2)", preview: "(๒) กรณีที่ ๒ ผู้รับใบอนุญาตที่ไม่จัดสรรรายได้ให้แก่กองทุนตามกรณี ข้อ ๙.๖ วรรคสอง ให้ถือว่าผู้รับใบอนุญาตไม่นำส่งรายได้ให้แก่กองทุนให้ครบจำน", n_chars: 681});
CREATE (:Chunk {id: "chunk::25_protect::preamble", doc: "25_protect.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม (ฉบับที่ 2)", preview: ")1>\u000f@0ค!>\u000f11/\u000f@1\u000f>\u0010\u000f@1\u000f1>\u0010@0N2?0\u000f \u000f>\u0010\u000f@1P%1%?0'์ O3>\u000f>\u0010\u000f@1P%1ค/'@ค/OหN\u000f\u0012@#> N1ANอ\u000f /@#1\u001e@'\u0010อ\u000fคB!.@พ\u000f@1QหO(1>\u000f@1P%1ค/'@ค/ (\u0011(?(%?N 2) P\"0%?NN", n_chars: 1656});
CREATE (:Chunk {id: "chunk::26_protect::preamble", doc: "26_protect.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม โดยที่เป็นการสมควรก", n_chars: 573});
CREATE (:Chunk {id: "chunk::26_protect::ข้อ_1", doc: "26_protect.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ข้อ ๑ ประกาศนี้ให้ใช้บังคับตั้งแต่วันที่ ๑ มกราคม ๒๕๖๓ เป็นต้นไป", n_chars: 64});
CREATE (:Chunk {id: "chunk::26_protect::ข้อ_2", doc: "26_protect.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ข้อ ๒ ให้ยกเลิก (๑) ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", n_chars: 367});
CREATE (:Chunk {id: "chunk::26_protect::ข้อ_3", doc: "26_protect.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ข้อ ๓ ในประกาศนี้ “คุณภาพการให้บริการ” หมายความว่า สมรรถนะโดยรวมของการให้บริการ ซึ่งเป็นตัวกำหนด ระดับของความพึงพอใจของผู้ใช้บริการตามข้อเสน", n_chars: 1920});
CREATE (:Definition {id: "term::คุณภาพการให้บริการ", term: "คุณภาพการให้บริการ"});

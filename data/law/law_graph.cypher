CREATE (:Definition {id: "term::บริการโทรคมนาคมประเภทข้อมูล", term: "บริการโทรคมนาคมประเภทข้อมูล"});
CREATE (:Chunk {id: "chunk::26_protect::ข้อ_4", doc: "26_protect.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ข้อ ๔ การให้บริการโทรคมนาคมจะต้องมีค่าชี้วัดคุณภาพบริการผ่านเกณฑ์ที่กำหนดไว้ใน ภาคผนวกแนบท้ายประกาศนี้", n_chars: 102});
CREATE (:Chunk {id: "chunk::26_protect::ข้อ_5", doc: "26_protect.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ข้อ ๕ ในกรณีที่ผู้รับใบอนุญาตไม่สามารถให้บริการได้เพราะเหตุสุดวิสัย หรือเพราะมี เหตุจำเป็นอย่างยิ่งอันมิอาจหลีกเลี่ยงได้ ผู้รับใบอนุญาตมีหน้", n_chars: 487});
CREATE (:Chunk {id: "chunk::26_protect::ข้อ_6", doc: "26_protect.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ข้อ ๖ ผู้รับใบอนุญาตมีหน้าที่ต้องให้บริการโทรคมนาคมตามมาตรฐานของคุณภาพ การให้บริการโทรคมนาคมที่กำหนดไว้ในภาคผนวกแนบท้ายประกาศนี้ โดยต้องดำเน", n_chars: 1447});
CREATE (:Chunk {id: "chunk::26_protect::ข้อ_7", doc: "26_protect.pdf", unit: "ข้อ", number: 7, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ข้อ ๗ ผู้รับใบอนุญาตมีหน้าที่ต้องจัดให้มีการเผยแพร่ข้อมูลเกี่ยวกับมาตรฐานและคุณภาพ การให้บริการโทรคมนาคมเพื่อให้ผู้ใช้บริการทราบ โดยเผยแพร่ผ", n_chars: 348});
CREATE (:Chunk {id: "chunk::26_protect::ข้อ_8", doc: "26_protect.pdf", unit: "ข้อ", number: 8, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ข้อ ๘ หากผู้รับใบอนุญาตไม่ดำเนินการตามประกาศนี้ ให้นาบทบัญญัติว่าด้วยการบังคับ ทางปกครองตามกฎหมายว่าด้วยการประกอบกิจการโทรคมนาคม มาใช้บังคับ", n_chars: 422});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_1", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 1, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ภาคผนวก แนบท้ายประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรฐานของคุณภาพบริการโทรคมนาคม ๑. บริการโ", n_chars: 2496});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_2", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 2, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ให้มีการซ่อมแซม จนกระทั่งเวลาที่ สามารถเริ่มใช้บริการได้เป็นปกติอีก ครั้ง ทั้งนี้ ไม่นับรวมช่วงระยะเวลาที่ ผู้ใช้บริการไม่สะดวกให้เข้าแก้ไข ", n_chars: 2488});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_3", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 3, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "หรือปลายทางไม่ว่าง ๑.๒.๒ อัตราส่วนการเรียกสำเร็จ (Successful call ratio) กรณีที่เป็นการโทรข้าม โครงข่ายต่างผู้ประกอบการ อัตราส่วนจำนวนการเรี", n_chars: 2488});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_4", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 4, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "แนวทางการวัด และการรายงานผล เป้าหมาย หมายเหตุ ๒.๑.๑ ระยะเวลาสำหรับการขอเริ่ม เปิดใช้บริการ (Service activation time) ระยะเวลาที่ผู้ใช้บริการ", n_chars: 2489});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_5", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 5, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "(จำนวนครั้งที่ Cell ไม่สามารถให้บริการได้ติดต่อกัน เกิน ๔ ชั่วโมงใน ๑ เดือน) x ๑๐๐/จำนวน Cell ของ ผู้ได้รับใบอนุญาตทั้งหมดในทุกสถานีฐาน ให้ว", n_chars: 2491});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_6", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 6, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ช่วงเวลา ๑๖.๐๐ – ๑๙.๐๐ น. เฉลี่ยทุก ๓ เดือน โดยแยกข้อมูลในแต่ละช่วงเวลา รายงานส่งสำนักงาน กสทช. ทุกไตรมาส ไม่น้อยกว่าร้อยละ ๙๐ ข้อ ๒.๒.๑ ข้อ", n_chars: 2497});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_7", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 7, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ไม่เกิน 1,000 ms (1 second) ๒) สำหรับเทคโนโลยี 3G ไม่เกิน 500 ms ๓) สำหรับเทคโนโลยี 4G ขึ้นไป ไม่เกิน 150 ms ค่าเป้าหมาย ไม่ต่ำกว่า ร้อยละ ๘", n_chars: 2490});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_8", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 8, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "หมายเหตุ kbps - สำหรับ 2G ไม่ต่ำกว่า 20 kbps สำหรับร้อยละ ๗๕ ของ การรับส่ง FTP ที่สำเร็จ ภายในเวลาที่กำหนด (Timeout) ทดสอบจะอยู่กับที่ หรือเ", n_chars: 2496});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_9", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 9, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "delivery time) เวลาที่ใช้ในการส่ง Short Message จากอุปกรณ์ต้น ทางส่งไปยังอุปกรณ์ปลายทางสำเร็จ = จุดของเวลาที่ อุปกรณ์ปลายทางได้รับ Short Mes", n_chars: 2353});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_10", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 10, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ค่าชี้วัดคุณภาพบริการข้างต้นไม่ใช้บังคับกับโครงข่ายการให้บริการตามโครงการหรือแผนงานจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสัง", n_chars: 2484});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_11", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 11, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ดาวน์โหลดหรืออัพโหลดแต่ละครั้ง สามารถ กำหนดได้ตามความเหมาะสม เพื่อให้มีเวลาในการเคลียร์ระบบการทดสอบให้เหมือนกับ เป็นการทดสอบใหม่ทุกครั้ง - อ", n_chars: 2465});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_12", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 12, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ผลลัพธ์ที่พึงได้ก่อนการทดสอบทุกครั้ง - SIM card ที่ใช้ในการทดสอบจะต้องไม่ถูกจำกัดความเร็วจากระบบของผู้รับใบอนุญาต เช่น กรณีที่ SIM card มีกา", n_chars: 2169});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_13", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 13, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ตารางที่ ๑ : ขนาดไฟล์รูปแบบการทดสอบและเวลา Timeout สำหรับทดสอบอัพโหลดและดาวน์โหลดผ่าน FTP ๒.๓.๓ ค่าชี้วัดคุณภาพบริการข้อ ๒.๓.๔ - ขนาด Websit", n_chars: 1063});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_14", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 14, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "ตารางที่ ๒ : ขนาด Website และ เวลาที่กำหนด (Timeout) สำหรับการดาวน์โหลด Website ๒.๓.๔ ค่าชี้วัดคุณภาพบริการข้อ ๒.๓.๕ อ้างอิงตามมาตรฐาน ETSI ", n_chars: 2496});
CREATE (:Chunk {id: "chunk::26_protect::ภาคผนวก_15", doc: "26_protect.pdf", unit: "ภาคผนวก", number: 15, muad: "", title: "เรื่อง มาตรฐานของคุณภาพการให้บริการโทรคมนาคม", preview: "กำหนดได้ตามความเหมาะสม - ต้องตั้งค่าเวลาของอุปกรณ์ต้นทางและปลายทางให้ตรงกันก่อนการทดสอบทุกครั้ง เพื่อให้สามารถวัดระยะเวลาในการส่ง MMS จากฝั่", n_chars: 639});
CREATE (:Chunk {id: "chunk::27_protect::preamble", doc: "27_protect.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อม", n_chars: 1915});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_1", doc: "27_protect.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๑ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 78});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_2", doc: "27_protect.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๒ ให้ยกเลิกประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรการคุ้มครอง สิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในค", n_chars: 224});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_3", doc: "27_protect.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๓ บรรดาประกาศ ระเบียบ หลักเกณฑ์ หรือคำสั่งอื่นใด ในส่วนที่ได้กำหนดไว้แล้ว ในประกาศนี้ หรือซึ่งขัดหรือแย้งกับประกาศนี้ ให้ใช้ประกาศนี้แทน", n_chars: 140});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_4", doc: "27_protect.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๔ ประกาศนี้ให้ใช้บังคับในการคุ้มครองสิทธิของผู้ใช้บริการในกิจการโทรคมนาคม ที่เกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพใ", n_chars: 314});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_5", doc: "27_protect.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๕ ในประกาศนี้ “ข้อมูลส่วนบุคคลของผู้ใช้บริการ” หมายความว่า ข้อมูลเกี่ยวกับผู้ใช้บริการโทรคมนาคม ซึ่งทำให้สามารถระบุตัวผู้ใช้บริการนั้นได", n_chars: 959});
CREATE (:Definition {id: "term::ข้อมูลส่วนบุคคลของผู้ใช้บริการ", term: "ข้อมูลส่วนบุคคลของผู้ใช้บริการ"});
CREATE (:Definition {id: "term::การเก็บรวบรวม", term: "การเก็บรวบรวม"});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_6", doc: "27_protect.pdf", unit: "ข้อ", number: 6, muad: "หมวด 1", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๖ ผู้รับใบอนุญาตจะเก็บรวบรวม ใช้ หรือเปิดเผยข้อมูลส่วนบุคคลของผู้ใช้บริการ ได้เท่าที่จำเป็นเพื่อการดำเนินกิจการโทรคมนาคมตามสัญญาให้บริกา", n_chars: 1163});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_7", doc: "27_protect.pdf", unit: "ข้อ", number: 7, muad: "หมวด 1", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๗ ผู้รับใบอนุญาตต้องไม่เก็บรวบรวมข้อมูลส่วนบุคคลของผู้ใช้บริการเกี่ยวกับเชื้อชาติ เผ่าพันธุ์ ความคิดเห็นทางการเมือง ความเชื่อในลัทธิ ศาส", n_chars: 495});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_8", doc: "27_protect.pdf", unit: "ข้อ", number: 8, muad: "หมวด 1", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๘ การเก็บรวบรวม ใช้ หรือเปิดเผยข้อมูลส่วนบุคคลของผู้ใช้บริการในกรณีดังต่อไปนี้ ไม่จำต้องปฏิบัติตามหลักเกณฑ์ในข้อ ๖ และข้อ ๗ (๑) ส่งข้อมู", n_chars: 269});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_9", doc: "27_protect.pdf", unit: "ข้อ", number: 9, muad: "หมวด 1", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๙ การส่งหรือโอนข้อมูลส่วนบุคคลของผู้ใช้บริการไปยังต่างประเทศ นอกจากต้องปฏิบัติ ตามข้อ ๖ และข้อ ๘ ของประกาศนี้แล้ว ยังต้องปฏิบัติตามหลักเ", n_chars: 318});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_10", doc: "27_protect.pdf", unit: "ข้อ", number: 10, muad: "หมวด 2", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๑๐ ผู้รับใบอนุญาตต้องเก็บรวบรวมข้อมูลส่วนบุคคลของผู้ใช้บริการจากผู้ใช้บริการโดยตรง เท่าที่จำเป็น และเป็นไปตามวัตถุประสงค์ที่ชอบด้วยกฎหมา", n_chars: 791});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_11", doc: "27_protect.pdf", unit: "ข้อ", number: 11, muad: "หมวด 2", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๑๑ ผู้รับใบอนุญาตต้องเก็บรักษาข้อมูลส่วนบุคคลของผู้ใช้บริการกรณีที่มีการใช้บริการอยู่ ย้อนหลังไม่น้อยกว่า ๙๐ วัน ตลอดเวลาที่ใช้บริการ เว", n_chars: 1176});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_12", doc: "27_protect.pdf", unit: "ข้อ", number: 12, muad: "หมวด 3", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๑๒ ผู้ใช้บริการมีสิทธิดำเนินการภายในระยะเวลาตามหลักเกณฑ์ข้อ ๑๑ ในกรณี ดังต่อไปนี้ (๑) ขอตรวจดู ขอเข้าถึง หรือขอสำเนารับรองถูกต้องซึ่งข้อ", n_chars: 1201});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_13", doc: "27_protect.pdf", unit: "ข้อ", number: 13, muad: "หมวด 3", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๑๓ ผู้ใช้บริการอาจร้องเรียนเกี่ยวกับกรณีถูกละเมิดสิทธิเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว หรือเสรีภาพในการสื่อสารถึงกันโดยทา", n_chars: 237});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_14", doc: "27_protect.pdf", unit: "ข้อ", number: 14, muad: "หมวด 4", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๑๔ ผู้รับใบอนุญาตต้องจัดให้มีมาตรการป้องกันและรักษาความมั่นคงปลอดภัยของ ข้อมูลส่วนบุคคลของผู้ใช้บริการทั้งทางด้านเทคนิคและการจัดการภายใน", n_chars: 1083});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_15", doc: "27_protect.pdf", unit: "ข้อ", number: 15, muad: "หมวด 4", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๑๕ ผู้รับใบอนุญาตต้องจัดให้มีมาตรการสร้างความเชื่อมั่นในการติดต่อสื่อสารถึงกัน โดยทางโทรคมนาคมและห้ามมิให้กระทำการ ดังต่อไปนี้ (๑) ดักฟั", n_chars: 767});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_16", doc: "27_protect.pdf", unit: "ข้อ", number: 16, muad: "หมวด 4", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๑๖ ผู้รับใบอนุญาตให้บริการโทรศัพท์ต้องจัดให้มีบริการแสดงเลขหมายเรียกเข้า ระบบป้องกัน การแสดงเลขหมายโทรออก และระบบปฏิเสธเลขหมายที่ไม่พึงป", n_chars: 174});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_17", doc: "27_protect.pdf", unit: "ข้อ", number: 17, muad: "หมวด 4", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๑๗ ผู้รับใบอนุญาตจะต้องจัดให้มีช่องทางให้ผู้ใช้บริการมีสิทธิเลือกที่จะรับหรือยกเลิกข้อมูล หรือบริการและปฏิเสธการเสนอข้อมูลหรือบริการผ่าน", n_chars: 810});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_18", doc: "27_protect.pdf", unit: "ข้อ", number: 18, muad: "หมวด 4", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๑๘ ผู้รับใบอนุญาตต้องให้ข้อมูลผู้ใช้เลขหมายโทรคมนาคมแก่บุคคลที่ขอนาไปจัดทำ รายนามผู้ใช้บริการตามมาตรา ๑๒ วรรคห้า แห่งพระราชบัญญัติการประ", n_chars: 272});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_19", doc: "27_protect.pdf", unit: "ข้อ", number: 19, muad: "หมวด 4", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๑๙ ผู้รับใบอนุญาตมีหน้าที่ส่งข้อมูลส่วนบุคคลของผู้ใช้บริการที่ผู้รับใบอนุญาตครอบครอง ให้แก่ กสทช. หรือสำนักงาน กสทช. เมื่อได้รับการร้องข", n_chars: 203});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_20", doc: "27_protect.pdf", unit: "ข้อ", number: 20, muad: "หมวด 4", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๒๐ ผู้รับใบอนุญาตต้องจัดทำนโยบายการคุ้มครองสิทธิของผู้ใช้บริการเกี่ยวกับข้อมูล ส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึ", n_chars: 836});
CREATE (:Chunk {id: "chunk::27_protect::ข้อ_21", doc: "27_protect.pdf", unit: "ข้อ", number: 21, muad: "หมวด 4", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", preview: "ข้อ ๒๑ ผู้รับใบอนุญาตต้องแจ้งรายละเอียดและกำหนดมาตรการให้บุคคลที่จัดทำรายนาม ผู้ใช้บริการและบุคคลที่ได้รับมอบหมายจากผู้รับใบอนุญาตให้ทำหน้าท", n_chars: 965});
CREATE (:Chunk {id: "chunk::28_protect::preamble", doc: "28_protect.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคมสัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ พ.ศ. 2556", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดกา", n_chars: 2371});
CREATE (:Chunk {id: "chunk::28_protect::ข้อ_1", doc: "28_protect.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคมสัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ พ.ศ. 2556", preview: "ข้อ ๑ ประกาศนี้เรียกว่า “ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นก", n_chars: 232});
CREATE (:Chunk {id: "chunk::28_protect::ข้อ_2", doc: "28_protect.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคมสัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ พ.ศ. 2556", preview: "ข้อ ๒ ในประกาศนี้ “คณะกรรมการ” หมายความว่า คณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ “สำนักงาน” หมายความว่า สำนั", n_chars: 546});
CREATE (:Definition {id: "term::สัญญาสัมปทาน", term: "สัญญาสัมปทาน"});
CREATE (:Chunk {id: "chunk::28_protect::ข้อ_3", doc: "28_protect.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคมสัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ พ.ศ. 2556", preview: "ข้อ ๓ เมื่อสิ้นสุดสัญญาสัมปทาน เพื่อบรรเทำความเดือดร้อนเสียหายของผู้ใช้บริการที่ยัง ไม่อาจโอนย้ายไปยังผู้ให้บริการโทรศัพท์เคลื่อนที่รายอื่นไ", n_chars: 1108});
CREATE (:Chunk {id: "chunk::28_protect::ข้อ_4", doc: "28_protect.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคมสัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ พ.ศ. 2556", preview: "ข้อ ๔ ก่อนสัญญาสัมปทานจะสิ้นสุดลงไม่น้อยกว่าเก้าสิบวัน ผู้ให้บริการจะต้องจัดทำแผน ความคุ้มครองผู้ใช้บริการเสนอต่อคณะกรรมการเพื่อพิจารณาให้คว", n_chars: 756});
CREATE (:Chunk {id: "chunk::28_protect::ข้อ_5", doc: "28_protect.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคมสัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ พ.ศ. 2556", preview: "ข้อ ๕ แผนความคุ้มครองผู้ใช้บริการตามข้อ ๔ อย่างน้อยต้องมีสาระสำคัญ ดังต่อไปนี้ (๑) ข้อมูลการให้บริการ เช่น ข้อมูลผู้ใช้บริการ จำนวนเงินคงค้า", n_chars: 473});
CREATE (:Chunk {id: "chunk::28_protect::ข้อ_6", doc: "28_protect.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคมสัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ พ.ศ. 2556", preview: "ข้อ ๖ ในระหว่างระยะเวลาความคุ้มครอง ผู้ให้บริการมีหน้าที่ปฏิบัติตามเงื่อนไข ดังนี้ (๑) จะพักหรือหยุดการให้บริการไม่ว่าทั้งหมดหรือบางส่วนไม่ไ", n_chars: 766});
CREATE (:Chunk {id: "chunk::28_protect::ข้อ_7", doc: "28_protect.pdf", unit: "ข้อ", number: 7, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคมสัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ พ.ศ. 2556", preview: "ข้อ ๗ ในช่วงระยะเวลาคุ้มครอง ให้ผู้ให้บริการเป็นผู้รับชำระเงินรายได้จากการให้บริการ แทนรัฐโดยแยกบัญชีการรับเงินไว้เป็นการเฉพาะ แล้วรายงานจำน", n_chars: 691});
CREATE (:Chunk {id: "chunk::28_protect::ข้อ_8", doc: "28_protect.pdf", unit: "ข้อ", number: 8, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคมสัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ พ.ศ. 2556", preview: "ข้อ ๘ เพื่อกำหนดกรอบระยะเวลาที่แน่นอนในการจัดสรรคลื่นความถี่ที่ใช้อยู่ในสัญญา สัมปทาน คณะกรรมการจะจัดทำแผนการประมูลคลื่นความถี่ที่ใช้อยู่ในส", n_chars: 449});
CREATE (:Chunk {id: "chunk::28_protect::ข้อ_9", doc: "28_protect.pdf", unit: "ข้อ", number: 9, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคมสัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ พ.ศ. 2556", preview: "ข้อ ๙ ในกรณีระยะเวลาความคุ้มครองยังไม่สิ้นสุด เมื่อคณะกรรมการได้จัดสรรคลื่นความถี่ ให้กับผู้รับใบอนุญาตให้ใช้คลื่นความถี่รายใหม่แล้ว ให้คณะก", n_chars: 462});
CREATE (:Chunk {id: "chunk::28_protect::ข้อ_10", doc: "28_protect.pdf", unit: "ข้อ", number: 10, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคมสัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ พ.ศ. 2556", preview: "ข้อ ๑๐ เมื่อสิ้นสุดระยะเวลาการคุ้มครอง หากยังมีผู้ใช้บริการคงเหลือที่ไม่แจ้งความประสงค์ จะขอย้ายไปยังผู้ให้บริการโทรศัพท์เคลื่อนที่รายอื่น ใ", n_chars: 450});
CREATE (:Chunk {id: "chunk::28_protect::ข้อ_11", doc: "28_protect.pdf", unit: "ข้อ", number: 11, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคมสัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ พ.ศ. 2556", preview: "ข้อ ๑๑ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป ประกาศ ณ วันที่ ๑๖ สิงหาคม พ.ศ. ๒๕๕๖ พลอากาศเอก ธเรศ ปุณศรี ", n_chars: 212});
CREATE (:Chunk {id: "chunk::29_protect::preamble", doc: "29_protect.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคม สัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ (ฉบับที่ 2)", preview: "๑๙ ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุ", n_chars: 2132});
CREATE (:Chunk {id: "chunk::29_protect::ข้อ_1", doc: "29_protect.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคม สัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ (ฉบับที่ 2)", preview: "ข้อ ๑ ประกาศนี้ให้ใช้บังคับกับผู้ให้บริการที่เข้าสู่มาตรการคุ้มครองผู้ใช้บริการตามประกาศ คณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจกา", n_chars: 453});
CREATE (:Chunk {id: "chunk::29_protect::ข้อ_2", doc: "29_protect.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคม สัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ (ฉบับที่ 2)", preview: "ข้อ ๒ ให้ยกเลิกความใน (๔) ของข้อ ๖ ของประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรการคุ้มครองผู้ใ", n_chars: 731});
CREATE (:Chunk {id: "chunk::29_protect::ข้อ_3", doc: "29_protect.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคม สัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ (ฉบับที่ 2)", preview: "ข้อ ๓ ให้เพิ่มความต่อไปนี้เป็นข้อ ๖/๑ ของประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรการคุ้มครองผ", n_chars: 658});
CREATE (:Chunk {id: "chunk::29_protect::ข้อ_4", doc: "29_protect.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคม สัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ (ฉบับที่ 2)", preview: "ข้อ ๔ ให้ยกเลิกความในวรรคหนึ่งของข้อ ๗ ของประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรการคุ้มครอง", n_chars: 1123});
CREATE (:Chunk {id: "chunk::29_protect::ข้อ_5", doc: "29_protect.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคม สัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ (ฉบับที่ 2)", preview: "ข้อ ๕ ให้เพิ่มความต่อไปนี้เป็นวรรคสามของข้อ ๗ ของประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรการค", n_chars: 389});
CREATE (:Chunk {id: "chunk::29_protect::ข้อ_6", doc: "29_protect.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคม สัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ (ฉบับที่ 2)", preview: "ข้อ ๖ ให้ยกเลิกความในวรรคสองของข้อ ๙ ของประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรการคุ้มครองผู", n_chars: 465});
CREATE (:Chunk {id: "chunk::29_protect::ข้อ_7", doc: "29_protect.pdf", unit: "ข้อ", number: 7, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคม สัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ (ฉบับที่ 2)", preview: "ข้อ ๗ ให้ยกเลิกความในวรรคสองของข้อ ๑๐ ของประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรการคุ้มครองผ", n_chars: 721});
CREATE (:Chunk {id: "chunk::29_protect::ข้อ_8", doc: "29_protect.pdf", unit: "ข้อ", number: 8, muad: "", title: "เรื่อง มาตรการคุ้มครองผู้ใช้บริการเป็นการชั่วคราวในกรณีสิ้นสุดการการอนุญาตและการประกอบกิจการโทรคมนาคม สัมปทาน หรือสัญญาการให้บริการโทรศัพท์เคลื่อนที่ (ฉบับที่ 2)", preview: "ข้อ ๘ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป ประกาศ ณ วันที่ ๑๗ กันยายน พ.ศ. ๒๕๕๘ พลอากาศเอก ธเรศ ปุณศรี ป", n_chars: 211});
CREATE (:Chunk {id: "chunk::30_protect::preamble", doc: "30_protect.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง มาตรฐานของสัญญาให้บริการโทรคมนาคม พ.ศ. ๒๕๔๙ อาศัยอำนาจตามความในมาตรา ๕๑ (๑๐) แห่งพระราชบัญญัต", n_chars: 1143});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_1", doc: "30_protect.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑ ประกาศนี้มีผลใช้บังคับตั้งแต่วันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 70});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_2", doc: "30_protect.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒ บรรดาประกาศ ข้อบังคับ และคำสั่งอื่นใด ในส่วนที่มีกำหนดไว้แล้วในประกาศนี้ หรือซึ่งขัดหรือแย้งกับประกาศนี้ ให้ใช้ประกาศนี้แทน", n_chars: 129});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_3", doc: "30_protect.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๓ ในประกาศนี้ “บริการโทรคมนาคม” หมายความว่า บริการโทรคมนาคมที่ผู้รับใบอนุญาตให้แก่ ผู้ใช้บริการตามกฎหมายว่าด้วยการประกอบกิจการโทรคมนาคมแ", n_chars: 1321});
CREATE (:Definition {id: "term::สัญญา", term: "สัญญา"});
CREATE (:Definition {id: "term::แบบสัญญา", term: "แบบสัญญา"});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_4", doc: "30_protect.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๔ สัญญาจะมีผลผูกพันและใช้บังคับได้ ต้องเป็นไปตามแบบสัญญาที่คณะกรรมการ ได้ให้ความเห็นชอบแล้วหรือที่คณะกรรมการประกาศกำหนดแบบของสัญญาไว้เป็", n_chars: 571});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_5", doc: "30_protect.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๕ ก่อนนำแบบสัญญาไปใช้ในการประกอบกิจการ ผู้ให้บริการต้องจัดส่งแบบสัญญา ให้คณะกรรมการพิจารณาล่วงหน้าไม่น้อยกว่าหกสิบวัน ในกรณีที่คณะกรรมกา", n_chars: 1137});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_6", doc: "30_protect.pdf", unit: "ข้อ", number: 6, muad: "หมวด 1", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๖ ผู้ให้บริการมีหน้าที่ต้องแจ้งรายละเอียดของการให้บริการโทรคมนาคมในแต่ละบริการ อย่างชัดเจน และครบถ้วน ผ่านสื่อที่ผู้บริโภคสามารถเข้าถึงแ", n_chars: 874});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_7", doc: "30_protect.pdf", unit: "ข้อ", number: 7, muad: "หมวด 1", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๗ แบบสัญญาต้องเป็นข้อกำหนดและเงื่อนไขที่ชัดเจน โดยใช้ข้อความเป็นภาษาไทย ที่เข้าใจง่ายและสามารถเห็นและอ่านได้ชัดเจน มีขนาดของตัวอักษรไม่เ", n_chars: 415});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_8", doc: "30_protect.pdf", unit: "ข้อ", number: 8, muad: "หมวด 1", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๘ สัญญาย่อมเกิดขึ้นเมื่อคู่สัญญาได้แสดงเจตนำเสนอและสนองถูกต้องตรงกัน โดยชัดแจ้งว่า ผู้ให้บริการตกลงให้บริการโทรคมนาคม และผู้ใช้บริการตกล", n_chars: 727});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_9", doc: "30_protect.pdf", unit: "ข้อ", number: 9, muad: "หมวด 1", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๙ เมื่อได้ทำสัญญาแล้ว ผู้ให้บริการต้องจัดทำสำเนาสัญญานั้นเป็นหนังสือและส่งมอบ ให้แก่ผู้ใช้บริการ หรือออกหลักฐานอย่างอื่นที่ผู้ใช้บริการส", n_chars: 601});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_10", doc: "30_protect.pdf", unit: "ข้อ", number: 10, muad: "หมวด 1", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๐ สัญญาอย่างน้อยจะต้องมีสาระสำคัญเกี่ยวกับสิทธิหน้าที่ระหว่างผู้ให้บริการและผู้ใช้บริการ ดังต่อไปนี้ (๑) มีข้อกำหนดเกี่ยวกับลักษณะและปร", n_chars: 590});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_11", doc: "30_protect.pdf", unit: "ข้อ", number: 11, muad: "หมวด 1", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๑ การให้บริการโทรคมนาคมในลักษณะที่เรียกเก็บค่าธรรมเนียมหรือค่าบริการ เป็นการล่วงหน้าจะต้องไม่มีข้อกำหนดอันมีลักษณะเป็นการบังคับให้ผู้ใช", n_chars: 716});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_12", doc: "30_protect.pdf", unit: "ข้อ", number: 12, muad: "หมวด 1", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๒ ในการทำสัญญา ผู้ให้บริการจะขอให้ผู้ใช้บริการให้ข้อมูลส่วนบุคคลเกินกว่า ความจำเป็นเพื่อการปฏิบัติตามสัญญามิได้ เว้นแต่ผู้ใช้บริการได้ใ", n_chars: 450});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_13", doc: "30_protect.pdf", unit: "ข้อ", number: 13, muad: "หมวด 2", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๓ ผู้ให้บริการมีหน้าที่ต้องให้บริการโทรคมนาคมตามมาตรฐานและคุณภาพ การให้บริการตามที่ได้โฆษณาหรือแจ้งให้ผู้ใช้บริการทราบ โดยมาตรฐานและคุณ", n_chars: 482});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_14", doc: "30_protect.pdf", unit: "ข้อ", number: 14, muad: "หมวด 2", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๔ ในกรณีที่เกิดเหตุขัดข้องขึ้นกับการให้บริการโทรคมนาคมของผู้ให้บริการ จนเป็นเหตุให้ผู้ใช้บริการไม่สามารถใช้บริการได้ตามปกติ ผู้ให้บริกา", n_chars: 392});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_15", doc: "30_protect.pdf", unit: "ข้อ", number: 15, muad: "หมวด 2", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๕ ในกรณีที่ผู้ให้บริการได้ส่งมอบเครื่องอุปกรณ์หรือสิ่งอื่นที่เกี่ยวข้องให้แก่ผู้ใช้บริการ โดยไม่คิดค่าใช้จ่ายหรือคิดค่าใช้จ่ายในราคาที่", n_chars: 1005});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_16", doc: "30_protect.pdf", unit: "ข้อ", number: 16, muad: "หมวด 3", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๖ ผู้ให้บริการต้องเรียกเก็บค่าธรรมเนียมและค่าบริการไม่เกินอัตราขั้นสูงที่ คณะกรรมการประกาศกำหนด และต้องเป็นอัตราตามที่ได้มีการตกลงไว้ใน", n_chars: 325});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_17", doc: "30_protect.pdf", unit: "ข้อ", number: 17, muad: "หมวด 3", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๗ ผู้ให้บริการต้องจัดส่งใบแจ้งรายการกำรใช้บริการโทรคมนาคมของผู้ใช้บริการ เพื่อเรียกเก็บค่าธรรมเนียมและค่าบริการให้ผู้ใช้บริการทราบล่วงห", n_chars: 1125});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_18", doc: "30_protect.pdf", unit: "ข้อ", number: 18, muad: "หมวด 3", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๘ ผู้ให้บริการต้องกำหนดวิธีการในการส่งใบแจ้งรายการกำรใช้บริการโทรคมนาคม เพื่อเรียกเก็บค่าธรรมเนียมหรือค่าบริการให้ชัดแจ้ง และต้องแจ้งให", n_chars: 295});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_19", doc: "30_protect.pdf", unit: "ข้อ", number: 19, muad: "หมวด 3", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๙ ผู้ให้บริการจะเรียกเก็บค่าธรรมเนียม ค่าบริการ หรือค่าใช้จ่ายอื่นนอกเหนือจาก ที่กำหนดไว้ในสัญญามิได้", n_chars: 106});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_20", doc: "30_protect.pdf", unit: "ข้อ", number: 20, muad: "หมวด 3", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๐ ผู้ให้บริการจะกำหนดให้ผู้ใช้บริการต้องวางเงินประกันหรือต้องชำระเงินอื่น ที่มีลักษณะเช่นเดียวกับเงินประกันเพื่อใช้บริการโทรคมนาคมของผู", n_chars: 155});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_21", doc: "30_protect.pdf", unit: "ข้อ", number: 21, muad: "หมวด 3", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๑ ผู้ให้บริการจะกำหนดให้ผู้ใช้บริการต้องชำระดอกเบี้ย เบี้ยปรับ หรือเงินอื่นใด ในลักษณะดังกล่าว ในกรณีที่ผู้ใช้บริการผิดนัดชำระค่าบริการ", n_chars: 207});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_22", doc: "30_protect.pdf", unit: "ข้อ", number: 22, muad: "หมวด 3", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๒ในกรณีที่ผู้ใช้บริการเห็นว่าผู้ให้บริการเรียกเก็บค่าธรรมเนียมหรือค่าบริการสูงกว่า อัตราขั้นสูงที่คณะกรรมการกำหนดตามข้อ ๑๖ หรือสูงกว่าท", n_chars: 768});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_23", doc: "30_protect.pdf", unit: "ข้อ", number: 23, muad: "หมวด 3", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๓ ในกรณีที่ข้อเท็จจริงปรากฏว่า ผู้ให้บริการเรียกเก็บค่าธรรมเนียมหรือค่าบริการ เกินกว่าจำนวนที่เกิดขึ้นจากการใช้บริการจริง ผู้ให้บริการจ", n_chars: 644});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_24", doc: "30_protect.pdf", unit: "ข้อ", number: 24, muad: "หมวด 3", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๔ เมื่อผู้ใช้บริการได้ชำระค่าธรรมเนียมและค่าบริการให้แก่ผู้ให้บริการตามที่เรียกเก็บแล้ว ผู้ให้บริการจะต้องออกหลักฐานเป็นหนังสือแก่ผู้ใช", n_chars: 344});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_25", doc: "30_protect.pdf", unit: "ข้อ", number: 25, muad: "หมวด 4", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๕ ในกรณีที่มีเหตุจำเป็น ผู้ใช้บริการอาจใช้สิทธิระงับการใช้บริการโทรคมนาคมของ ผู้ให้บริการเป็นการชั่วคราวก็ได้ โดยแจ้งเป็นหนังสือหรือด้ว", n_chars: 802});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_26", doc: "30_protect.pdf", unit: "ข้อ", number: 26, muad: "หมวด 4", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๖ เมื่อผู้ใช้บริการได้แจ้งขอระงับการใช้บริการโทรคมนาคมต่อผู้ให้บริการ ตามหลักเกณฑ์ที่กำหนดในประกาศฉบับนี้แล้ว ผู้ใช้บริการย่อมหลุดพ้นจา", n_chars: 307});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_27", doc: "30_protect.pdf", unit: "ข้อ", number: 27, muad: "หมวด 4", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๗ เมื่อครบกำหนดการขอระงับการใช้บริการโทรคมนาคมชั่วคราวแล้ว ผู้ให้บริการมีหน้าที่ ต้องเปิดให้ผู้ใช้บริการสามารถเข้าใช้บริการดังกล่าวได้ท", n_chars: 224});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_28", doc: "30_protect.pdf", unit: "ข้อ", number: 28, muad: "หมวด 4", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๘ ในกรณีที่มีเหตุจำเป็น ผู้ให้บริการมีสิทธิระงับการให้บริการโทรคมนาคม เป็นการชั่วคราวต่อผู้ใช้บริการก็ได้ โดยแจ้งเป็นหนังสือพร้อมทั้งระ", n_chars: 1416});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_29", doc: "30_protect.pdf", unit: "ข้อ", number: 29, muad: "หมวด 4", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๙ ในกรณีการให้บริการโทรคมนาคมเป็นประเภทที่มีอุปกรณ์ที่ระบุตัวผู้ใช้บริการ ในการคิดค่าบริการ เมื่อผู้ใช้บริการได้แจ้งเหตุที่อุปกรณ์ระบุต", n_chars: 426});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_30", doc: "30_protect.pdf", unit: "ข้อ", number: 30, muad: "หมวด 5", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๓๐ ผู้ใช้บริการจะโอนสิทธิการใช้บริการตามสัญญาให้แก่บุคคลอื่นมิได้ เว้นแต่จะได้รับ ความยินยอมจากผู้ให้บริการ ถ้าผู้ใช้บริการกระทำการฝ่าฝื", n_chars: 189});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_31", doc: "30_protect.pdf", unit: "ข้อ", number: 31, muad: "หมวด 5", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๓๑ การโอนสิทธิการให้บริการตามสัญญาไปยังผู้ให้บริการรายอื่นจะกระทำมิได้ เว้นแต่ ได้รับอนุมัติจากคณะกรรมการ และผู้รับโอนจะต้องดำเนินการให้", n_chars: 175});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_32", doc: "30_protect.pdf", unit: "ข้อ", number: 32, muad: "หมวด 5", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๓๒ ผู้ใช้บริการมีสิทธิเลิกสัญญาในเวลาใดก็ได้ด้วยการบอกกล่าวเป็นหนังสือให้แก่ ผู้ให้บริการทราบล่วงหน้าไม่น้อยกว่าห้าวันทำการ ทั้งนี้ ผู้ใ", n_chars: 672});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_33", doc: "30_protect.pdf", unit: "ข้อ", number: 33, muad: "หมวด 5", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๓๓ ห้ามมิให้ผู้ให้บริการยกเลิกการให้บริการโทรคมนาคมตามสัญญา เว้นแต่กรณี ดังต่อไปนี้ (๑) ผู้ใช้บริการถึงแก่ความตาย หรือสิ้นสุดสภาพนิติบุค", n_chars: 675});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_34", doc: "30_protect.pdf", unit: "ข้อ", number: 34, muad: "หมวด 5", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๓๔ เมื่อสัญญาเลิกกัน ในกรณีที่ผู้ให้บริการมีเงินค้างชำระแก่ผู้ใช้บริการ ผู้ให้บริการ ต้องคืนเงินนั้นให้แก่ผู้ใช้บริการ ในการคืนเงินดังกล", n_chars: 794});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_35", doc: "30_protect.pdf", unit: "ข้อ", number: 35, muad: "หมวด 6", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๓๕ ผู้ให้บริการต้องจัดทำและแจ้งให้ผู้ใช้บริการได้ทราบถึงหลักเกณฑ์การรับเรื่อง ร้องเรียนและการแก้ไขปัญหาข้อร้องเรียนระหว่างผู้ใช้บริการแล", n_chars: 469});
CREATE (:Chunk {id: "chunk::30_protect::ข้อ_36", doc: "30_protect.pdf", unit: "ข้อ", number: 36, muad: "หมวด 6", title: "เรื่อง มาตรฐานของสัญญาการให้บริการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๓๖ สัญญาระหว่างผู้ให้บริการและผู้ใช้บริการที่ใช้บังคับอยู่ก่อนวันที่ประกาศฉบับนี้ มีผลใช้บังคับ ให้ผู้ให้บริการดำเนินการแก้ไขเพิ่มเติมแบ", n_chars: 880});
CREATE (:Chunk {id: "chunk::32_protect::preamble", doc: "32_protect.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิ", n_chars: 1375});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_1", doc: "32_protect.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๑ ประกาศนี้เรียกว่า “ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง กระบวนการรับและพิจารณาเรื่องร้อง", n_chars: 190});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_2", doc: "32_protect.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๒ ประกาศนี้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 75});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_3", doc: "32_protect.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๓ บรรดาประกาศ ระเบียบ ข้อบังคับ และคำสั่งอื่นใด ในส่วนที่มีกำหนดไว้แล้วในประกาศนี้ หรือซึ่งขัดหรือแย้งกับประกาศนี้ ให้ใช้ประกาศนี้แทน", n_chars: 137});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_4", doc: "32_protect.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๔ ให้ยกเลิกประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง กระบวนการรับเรื่อง ร้องเรียนและพิจารณาเรื่องร้องเรียนของผู้ใช้บริการ ฉบับประกา", n_chars: 171});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_5", doc: "32_protect.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๕ ในประกาศนี้ “คณะกรรมการ” หมายความว่า คณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการ โทรคมนาคมแห่งชาติ “สำนักงาน” หมายความว่า สำน", n_chars: 1165});
CREATE (:Definition {id: "term::ผู้ร้องเรียน", term: "ผู้ร้องเรียน"});
CREATE (:Definition {id: "term::เรื่องร้องเรียน", term: "เรื่องร้องเรียน"});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_6", doc: "32_protect.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๖ ให้ประธานกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคม แห่งชาติเป็นผู้รักษาการตามประกาศนี้", n_chars: 109});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_7", doc: "32_protect.pdf", unit: "ข้อ", number: 7, muad: "หมวด 1", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๗ ผู้ใดได้รับความเดือดร้อนเสียหายอันเนื่องมาแต่การให้บริการโทรคมนาคมของผู้รับ ใบอนุญาต ผู้นั้นมีสิทธิยื่นเรื่องร้องเรียนต่อผู้รับใบอนุญา", n_chars: 185});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_8", doc: "32_protect.pdf", unit: "ข้อ", number: 8, muad: "หมวด 1", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๘ การร้องเรียนต่อสำนักงานให้ทำเป็นหนังสือ และต้องมีรายละเอียด ดังต่อไปนี้ (๑) ชื่อ สกุล ที่อยู่ และเลขหมายโทรศัพท์ของผู้ร้องเรียน พร้อมส", n_chars: 1030});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_9", doc: "32_protect.pdf", unit: "ข้อ", number: 9, muad: "หมวด 2", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๙ เมื่อผู้รับใบอนุญาตได้รับเรื่องร้องเรียนตามข้อ ๗ แล้ว ให้ผู้รับใบอนุญาตแจ้งการรับ เรื่องร้องเรียนเป็นหนังสือให้ผู้ร้องเรียนทราบภายในเว", n_chars: 854});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_10", doc: "32_protect.pdf", unit: "ข้อ", number: 10, muad: "หมวด 2", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๑๐ ในขั้นตอนการตรวจเรื่องร้องเรียนของผู้รับใบอนุญาต หากผู้รับใบอนุญาตเห็นว่าเรื่องร้องเรียน ไม่มีมูล ไม่เป็นสาระ หรือไม่สมเหตุสมผลที่จะร", n_chars: 483});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_11", doc: "32_protect.pdf", unit: "ข้อ", number: 11, muad: "หมวด 2", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๑๑ ผู้รับใบอนุญาตต้องพิจารณาแก้ไขปัญหาเรื่องร้องเรียนให้แล้วเสร็จภายในเวลาสามสิบวัน นับแต่วันที่ได้รับเรื่องร้องเรียน เว้นแต่มีเหตุสุดวิ", n_chars: 1356});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_12", doc: "32_protect.pdf", unit: "ข้อ", number: 12, muad: "หมวด 2", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๑๒ เมื่อผู้รับใบอนุญาตและผู้ร้องเรียนได้เจรจาเพื่อแก้ไขปัญหาเรื่องร้องเรียนตามข้อ ๑๑ แล้ว ไม่ว่าผลการเจรจาจะเป็นที่ยุติหรือไม่ได้ข้อยุติ", n_chars: 450});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_13", doc: "32_protect.pdf", unit: "ข้อ", number: 13, muad: "หมวด 2", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๑๓ ผู้ร้องเรียนมีสิทธิให้ทนายความหรือผู้ซึ่งผู้ร้องเรียนไว้วางใจเข้าร่วมในกระบวนการ แก้ไขปัญหาเรื่องร้องเรียนได้ตลอดเวลา", n_chars: 124});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_14", doc: "32_protect.pdf", unit: "ข้อ", number: 14, muad: "หมวด 2", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๑๔ เมื่อสำนักงานได้รับหนังสือร้องเรียน ให้สำนักงานดำเนินการตรวจสอบหนังสือร้องเรียน หากหนังสือร้องเรียนมีรายละเอียดครบถ้วนตามข้อ ๘ ให้สำน", n_chars: 751});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_15", doc: "32_protect.pdf", unit: "ข้อ", number: 15, muad: "หมวด 2", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๑๕ เมื่อสำนักงานได้รับหนังสือร้องเรียน ให้สำนักงานมีหนังสือแจ้งให้ผู้รับใบอนุญาตที่เป็น คู่กรณีภายในเวลาสามวันทำการนับแต่วันที่สำนักงานร", n_chars: 1457});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_16", doc: "32_protect.pdf", unit: "ข้อ", number: 16, muad: "หมวด 2", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๑๖ เมื่อสำนักงานได้ดำเนินการรับเป็นเรื่องร้องเรียนตามประกาศนี้ ให้สำนักงานสอบถามคู่กรณี ว่าประสงค์จะเข้าสู่กระบวนการไกล่เกลี่ยหรือไม่ หา", n_chars: 515});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_17", doc: "32_protect.pdf", unit: "ข้อ", number: 17, muad: "หมวด 2", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๑๗ กรณีเรื่องร้องเรียนใดเป็นเรื่องร้องเรียนที่คณะกรรมการหรือคณะกรรมการกิจการโทรคมนาคม ได้มอบให้เลขาธิการพิจารณาวินิจฉัย ให้เลขาธิการพิจา", n_chars: 254});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_18", doc: "32_protect.pdf", unit: "ข้อ", number: 18, muad: "หมวด 2", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๑๘ กรณีเป็นเรื่องร้องเรียนอื่นนอกจากเรื่องร้องเรียนตามข้อ ๑๗ ให้เลขาธิการเสนอต่อ คณะอนุกรรมการคุ้มครองผู้บริโภคด้านกิจการโทรคมนาคมภายในส", n_chars: 452});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_19", doc: "32_protect.pdf", unit: "ข้อ", number: 19, muad: "หมวด 2", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๑๙ เรื่องร้องเรียนดังต่อไปนี้ ให้เลขาธิการเป็นผู้วินิจฉัยสั่งไม่รับไว้พิจารณา (๑) เรื่องที่อยู่ระหว่างการดำเนินการของผู้รับใบอนุญาตตามกร", n_chars: 560});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_20", doc: "32_protect.pdf", unit: "ข้อ", number: 20, muad: "หมวด 2", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๒๐ ให้เลขาธิการรายงานผลการตรวจสอบและแก้ไขปัญหาเรื่องร้องเรียนตามข้อ ๑๗ และข้อ ๑๙ ต่อคณะกรรมการเป็นประจำทุกเดือน", n_chars: 115});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_21", doc: "32_protect.pdf", unit: "ข้อ", number: 21, muad: "หมวด 2", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๒๑ เมื่อคณะกรรมการวินิจฉัยสั่งการเพื่อการระงับข้อพิพาทระหว่างผู้ร้องเรียนและผู้รับใบอนุญาต ในเรื่องใดแล้ว ให้สำนักงานจัดพิมพ์รายงานสรุปก", n_chars: 266});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_22", doc: "32_protect.pdf", unit: "ข้อ", number: 22, muad: "หมวด 3", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๒๒ ผู้รับใบอนุญาตมีหน้าที่จัดให้มีเจ้าหน้าที่เฉพาะขึ้นแยกออกจากเจ้าหน้าที่ตอบคำถาม หรือข้อสงสัยทั่วไป เพื่อทำหน้าที่ดูแลการรับเรื่องร้อง", n_chars: 626});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_23", doc: "32_protect.pdf", unit: "ข้อ", number: 23, muad: "หมวด 3", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๒๓ ผู้รับใบอนุญาตต้องจัดให้มีเจ้าหน้าที่ประสานงานเป็นการเฉพาะในการทำหน้าที่ดูแล ติดตามการรับและการแก้ไขปัญหาเรื่องร้องเรียน เพื่อให้สำนั", n_chars: 999});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_24", doc: "32_protect.pdf", unit: "ข้อ", number: 24, muad: "หมวด 3", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๒๔ ผู้รับใบอนุญาตต้องจัดให้มีหลักเกณฑ์การรับเรื่องร้องเรียนและการแก้ไขปัญหาเรื่องร้องเรียน โดยมีเนื้อหารายละเอียดที่ชัดเจนซึ่งสอดคล้องกั", n_chars: 1133});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_25", doc: "32_protect.pdf", unit: "ข้อ", number: 25, muad: "หมวด 3", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๒๕ กรณีเรื่องร้องเรียนเกี่ยวกับการเรียกเก็บค่าธรรมเนียมหรือค่าบริการไม่ถูกต้อง หรือสูงกว่า อัตราขั้นสูงที่คณะกรรมการกำหนด หรือสูงกว่าที่", n_chars: 649});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_26", doc: "32_protect.pdf", unit: "ข้อ", number: 26, muad: "หมวด 3", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๒๖ ผู้รับใบอนุญาตต้องจัดพิมพ์ข้อมูลของตนดังต่อไปนี้ เผยแพร่เป็นการทั่วไปในรูปแบบ ที่สามารถอ่านและเข้าใจได้โดยง่าย (๑) นโยบายในการแก้ไขปั", n_chars: 983});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_27", doc: "32_protect.pdf", unit: "ข้อ", number: 27, muad: "หมวด 3", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๒๗ การจัดเก็บข้อมูลการร้องเรียนและผลการดำเนินการแก้ไขปัญหาเรื่องร้องเรียน ผู้รับใบอนุญาตต้องดำเนินการ ดังต่อไปนี้ (๑) จัดให้มีระบบที่เหม", n_chars: 714});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_28", doc: "32_protect.pdf", unit: "ข้อ", number: 28, muad: "หมวด 3", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๒๘ ผู้รับใบอนุญาตต้องเผยแพร่ข้อมูลเกี่ยวกับจำนวน ประเภท และผลการแก้ไขปัญหา เรื่องร้องเรียน ซึ่งแสดงสถิติและรายละเอียดของการร้องเรียนตลอด", n_chars: 404});
CREATE (:Chunk {id: "chunk::32_protect::ข้อ_29", doc: "32_protect.pdf", unit: "ข้อ", number: 29, muad: "หมวด 3", title: "เรื่อง กระบวนการรับและพิจารณาเรื่องร้องเรียนเกี่ยวกับการประกอบกิจการโทรคมนาคม พ.ศ. 2559", preview: "ข้อ ๒๙ เรื่องร้องเรียนและการแก้ไขปัญหาเรื่องร้องเรียนซึ่งอยู่ระหว่างการดำเนินการของ ผู้รับใบอนุญาต สำนักงาน หรือคณะกรรมการอยู่ก่อนวันที่ประก", n_chars: 356});
CREATE (:Chunk {id: "chunk::33_protect::preamble", doc: "33_protect.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง การกระทําที่น่าจะเป็นการเอาเปรียบผู้บริโภคในกิจการโทรคมนาคม โดยอาศัยการใช้เครือข่ายหรือการโฆษณาอันมีลักษณะเป็นการค้ากําไรเกินควรหรือก่อให้เกิดความเดือดร้อนรําคาญ พ.ศ. 2558", preview: "๑๙ ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง การกระทำที่น่าจะเป็นการเอาเปรียบผู้บริโภคในกิจการโทรคม", n_chars: 891});
CREATE (:Chunk {id: "chunk::33_protect::ข้อ_1", doc: "33_protect.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง การกระทําที่น่าจะเป็นการเอาเปรียบผู้บริโภคในกิจการโทรคมนาคม โดยอาศัยการใช้เครือข่ายหรือการโฆษณาอันมีลักษณะเป็นการค้ากําไรเกินควรหรือก่อให้เกิดความเดือดร้อนรําคาญ พ.ศ. 2558", preview: "ข้อ ๑ ประกาศนี้เรียกว่า “ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง การกระทำที่น่าจะเป็นการเอาเปรียบ", n_chars: 280});
CREATE (:Chunk {id: "chunk::33_protect::ข้อ_2", doc: "33_protect.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง การกระทําที่น่าจะเป็นการเอาเปรียบผู้บริโภคในกิจการโทรคมนาคม โดยอาศัยการใช้เครือข่ายหรือการโฆษณาอันมีลักษณะเป็นการค้ากําไรเกินควรหรือก่อให้เกิดความเดือดร้อนรําคาญ พ.ศ. 2558", preview: "ข้อ ๒ บรรดาประกาศ ระเบียบ ข้อบังคับ และคำสั่งอื่นใด ในส่วนที่มีกำหนดไว้แล้ว ในประกาศนี้ หรือซึ่งขัดหรือแย้งกับประกาศนี้ ให้ใช้ประกาศนี้แทน", n_chars: 138});
CREATE (:Chunk {id: "chunk::33_protect::ข้อ_3", doc: "33_protect.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง การกระทําที่น่าจะเป็นการเอาเปรียบผู้บริโภคในกิจการโทรคมนาคม โดยอาศัยการใช้เครือข่ายหรือการโฆษณาอันมีลักษณะเป็นการค้ากําไรเกินควรหรือก่อให้เกิดความเดือดร้อนรําคาญ พ.ศ. 2558", preview: "ข้อ ๓ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 78});
CREATE (:Chunk {id: "chunk::33_protect::ข้อ_4", doc: "33_protect.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง การกระทําที่น่าจะเป็นการเอาเปรียบผู้บริโภคในกิจการโทรคมนาคม โดยอาศัยการใช้เครือข่ายหรือการโฆษณาอันมีลักษณะเป็นการค้ากําไรเกินควรหรือก่อให้เกิดความเดือดร้อนรําคาญ พ.ศ. 2558", preview: "ข้อ ๔ ในประกาศนี้ “คณะกรรมการ” หมายความว่า คณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และ กิจการโทรคมนาคมแห่งชาติ “สำนักงาน” หมายความว่า สำน", n_chars: 1402});
CREATE (:Definition {id: "term::ผู้ประกอบกิจการโทรคมนาคม", term: "ผู้ประกอบกิจการโทรคมนาคม"});
CREATE (:Definition {id: "term::ผู้บริโภค", term: "ผู้บริโภค"});
CREATE (:Definition {id: "term::การใช้เครือข่าย", term: "การใช้เครือข่าย"});
CREATE (:Definition {id: "term::การโฆษณา", term: "การโฆษณา"});
CREATE (:Chunk {id: "chunk::33_protect::ข้อ_5", doc: "33_protect.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง การกระทําที่น่าจะเป็นการเอาเปรียบผู้บริโภคในกิจการโทรคมนาคม โดยอาศัยการใช้เครือข่ายหรือการโฆษณาอันมีลักษณะเป็นการค้ากําไรเกินควรหรือก่อให้เกิดความเดือดร้อนรําคาญ พ.ศ. 2558", preview: "ข้อ ๕ ในกรณีที่ผู้ประกอบกิจการโทรคมนาคมดำเนินการใด ๆ ในประการที่น่าจะเป็น การเอาเปรียบผู้บริโภค โดยอาศัยการใช้เครือข่ายหรือการโฆษณาอันมีลักษ", n_chars: 1685});
CREATE (:Chunk {id: "chunk::33_protect::ข้อ_6", doc: "33_protect.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง การกระทําที่น่าจะเป็นการเอาเปรียบผู้บริโภคในกิจการโทรคมนาคม โดยอาศัยการใช้เครือข่ายหรือการโฆษณาอันมีลักษณะเป็นการค้ากําไรเกินควรหรือก่อให้เกิดความเดือดร้อนรําคาญ พ.ศ. 2558", preview: "ข้อ ๖ กรณีที่ผู้ประกอบกิจการโทรคมนาคมรายหนึ่งรายใดดำเนินการในประการที่น่าจะเป็น การเอาเปรียบผู้บริโภคตามประกาศนี้ ผู้บริโภคที่ได้รับความเดือ", n_chars: 895});
CREATE (:Chunk {id: "chunk::33_protect::ข้อ_7", doc: "33_protect.pdf", unit: "ข้อ", number: 7, muad: "", title: "เรื่อง การกระทําที่น่าจะเป็นการเอาเปรียบผู้บริโภคในกิจการโทรคมนาคม โดยอาศัยการใช้เครือข่ายหรือการโฆษณาอันมีลักษณะเป็นการค้ากําไรเกินควรหรือก่อให้เกิดความเดือดร้อนรําคาญ พ.ศ. 2558", preview: "ข้อ ๗ กรณีที่คณะกรรมการเห็นว่าผู้ประกอบกิจการโทรคมนาคมดำเนินการใด ๆ ในประการ ที่น่าจะเป็นการเอาเปรียบผู้บริโภค ให้มีคำสั่งให้ผู้ประกอบกิจการ", n_chars: 187});
CREATE (:Chunk {id: "chunk::33_protect::ข้อ_8", doc: "33_protect.pdf", unit: "ข้อ", number: 8, muad: "", title: "เรื่อง การกระทําที่น่าจะเป็นการเอาเปรียบผู้บริโภคในกิจการโทรคมนาคม โดยอาศัยการใช้เครือข่ายหรือการโฆษณาอันมีลักษณะเป็นการค้ากําไรเกินควรหรือก่อให้เกิดความเดือดร้อนรําคาญ พ.ศ. 2558", preview: "ข้อ ๘ กรณีผู้ประกอบกิจการโทรคมนาคมฝ่าฝืนไม่ปฏิบัติตามคำสั่งคณะกรรมการตามข้อ ๗ ให้คณะกรรมการปรับทางปกครองไม่เกินห้าล้านบาท และในกรณีที่ผู้ประ", n_chars: 924});
CREATE (:Chunk {id: "chunk::33_protect::ข้อ_5_d1", doc: "33_protect.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง การกระทําที่น่าจะเป็นการเอาเปรียบผู้บริโภคในกิจการโทรคมนาคม โดยอาศัยการใช้เครือข่ายหรือการโฆษณาอันมีลักษณะเป็นการค้ากําไรเกินควรหรือก่อให้เกิดความเดือดร้อนรําคาญ พ.ศ. 2558", preview: "ข้อ ๕ วรรคสอง ตัวอย่างการดำเนินการที่ถือเป็นการกระทำที่น่าจะเป็นการเอาเปรียบผู้บริโภค ๑. ข้อ ๕ วรรคสอง (๑) การกระทำ โดยไม่แจ้งให้ผู้บริโภคทร", n_chars: 2163});
CREATE (:Chunk {id: "chunk::33_protect::ข้อ_5_d2", doc: "33_protect.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง การกระทําที่น่าจะเป็นการเอาเปรียบผู้บริโภคในกิจการโทรคมนาคม โดยอาศัยการใช้เครือข่ายหรือการโฆษณาอันมีลักษณะเป็นการค้ากําไรเกินควรหรือก่อให้เกิดความเดือดร้อนรําคาญ พ.ศ. 2558", preview: "ข้อ ๕ วรรคสอง ตัวอย่างการดำเนินการที่ถือเป็นการกระทำที่น่าจะเป็นการเอาเปรียบผู้บริโภค ๓. ข้อ ๕ วรรคสอง (๓) การโฆษณา ในลักษณะเกินจริง หรือก่อ", n_chars: 1197});
CREATE (:Chunk {id: "chunk::34_protect::preamble_p1", doc: "34_protect.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง แผนการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม (ฉบับที่ 4) พ.ศ. 2566 (ที่แก้ไขเพิ่มเติม ครั้งที่ 1)", preview: "'1>\u000f@0ค\u001f>\u000f11/\u000f@1\u000f>\u0010\u000f@1\u000f1>\u0010@0N2?0\u000f \u000f>\u0010\u000f@1P#1#?0%์ O3>\u000f>\u0010\u000f@1P#1ค/%@ค/OหN\u000f\u0012@!> N1APอ\u000f O(%\u000f@1\u0010? QหO/?&1>\u000f@1P#1ค/%@ค/พAQ%\u0012@%P 0#?P/\"@\u000fO3>&1>\u000f@1Nพ", n_chars: 2469});

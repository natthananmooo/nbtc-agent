CREATE (:Chunk {id: "chunk::01_act::มาตรา_1", doc: "01_act.pdf", unit: "มาตรา", number: 1, muad: "", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๑ พระราชบัญญัตินี้เรียกว่า “พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่ และกำกับการประกอบกิจการวิทยุกระจายเสียง วิทยุโทรทัศน์ และกิจการโทรคม", n_chars: 155});

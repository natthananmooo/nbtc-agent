CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_5", doc: "11_keyword.pdf", unit: "ข้อ", number: 5, muad: "หมวด 1", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๕ ประกาศนี้ใช้บังคับกับการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่ตามที่กำหนดในแผน เลขหมายโทรคมนาคม", n_chars: 95});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_6", doc: "11_keyword.pdf", unit: "ข้อ", number: 6, muad: "หมวด 1", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๖ การคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่เป็นสิทธิของผู้ใช้บริการ ผู้ให้บริการ จะกระทำการใด ๆ อันเป็นเหตุในการกีดกันขัดขวาง หรือหน่วงเหนี่ยว", n_chars: 167});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_7", doc: "11_keyword.pdf", unit: "ข้อ", number: 7, muad: "หมวด 1", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๗ การเปิดเผยข้อมูลส่วนบุคคลของผู้ใช้บริการตามประกาศนี้ ให้ใช้เพื่อกรณีการโอนย้าย ผู้ให้บริการโทรศัพท์เคลื่อนที่ ตามหลักเกณฑ์การโอนย้ายผู", n_chars: 248});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_8", doc: "11_keyword.pdf", unit: "ข้อ", number: 8, muad: "หมวด 2", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๘ ในการขอโอนย้ายผู้ให้บริการโทรศัพท์เคลื่อนที่ให้ผู้ใช้บริการยื่นคำขอโอนย้ายการใช้บริการ ต่อผู้ให้บริการรายใหม่ ณ จุดที่ผู้ให้บริการรายใ", n_chars: 214});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_9", doc: "11_keyword.pdf", unit: "ข้อ", number: 9, muad: "หมวด 2", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๙ ผู้ให้บริการรายใหม่ และผู้ให้บริการรายเดิมต้องร่วมกันตรวจสอบข้อมูลเบื้องต้น ของผู้ใช้บริการที่ขอโอนย้ายเพื่อยืนยันความเป็นเจ้าของเลขหม", n_chars: 460});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_10", doc: "11_keyword.pdf", unit: "ข้อ", number: 10, muad: "หมวด 2", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๑๐ การโอนย้ายผู้ให้บริการต้องดำเนินการให้แล้วเสร็จภายในสองวันทำการนับแต่วันที่ ผู้ใช้บริการได้ยื่นคำขอและผู้ให้บริการได้ตรวจสอบเอกสารหลั", n_chars: 408});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_11", doc: "11_keyword.pdf", unit: "ข้อ", number: 11, muad: "หมวด 2", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๑๑ เมื่อผู้ให้บริการรายใหม่ตรวจสอบข้อมูลเบื้องต้นของผู้ใช้บริการต่อผู้ให้บริการรายเดิม เสร็จสิ้นแล้ว ผู้ให้บริการรายใหม่มีหน้าที่แจ้งให้", n_chars: 461});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_12", doc: "11_keyword.pdf", unit: "ข้อ", number: 12, muad: "หมวด 2", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๑๒ ให้สำนักงาน กสทช. และผู้ให้บริการจัดทำรายละเอียดหลักเกณฑ์การโอนย้าย ผู้ให้บริการโทรศัพท์เคลื่อนที่เสนอต่อ กสทช. เพื่อพิจารณาให้ความเห", n_chars: 150});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_13", doc: "11_keyword.pdf", unit: "ข้อ", number: 13, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๑๓ ผู้ให้บริการและศูนย์ให้บริการระบบสารสนเทศ มีหน้าที่ต้องจัดให้มีการโอนย้าย ผู้ให้บริการได้", n_chars: 96});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_14", doc: "11_keyword.pdf", unit: "ข้อ", number: 14, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๑๔ ผู้ให้บริการต้องดำเนินการให้ผู้ใช้บริการของตนสามารถติดต่อกับเลขหมายของผู้อื่น ที่ใช้สิทธิการคงเลขหมายโทรศัพท์เคลื่อนที่ได้อย่างมีประส", n_chars: 154});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_15", doc: "11_keyword.pdf", unit: "ข้อ", number: 15, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๑๕ ระบบโครงข่ายสำหรับให้บริการคงสิทธิเลขหมายในหลักการทางเทคนิคให้ตรวจสอบ เส้นทางเชื่อมต่อจากฐานข้อมูลทุกครั้งที่มีการเรียกออกจากผู้ให้บร", n_chars: 639});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_16", doc: "11_keyword.pdf", unit: "ข้อ", number: 16, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๑๖ ผู้ให้บริการรายเดิมอาจปฏิเสธคำขอโอนย้ายผู้ให้บริการของผู้ใช้บริการได้หากมีเหตุ อย่างใดอย่างหนึ่ง ดังต่อไปนี้ (๑) เลขหมายที่ได้มาโดยมิ", n_chars: 666});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_17", doc: "11_keyword.pdf", unit: "ข้อ", number: 17, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๑๗ ผู้ให้บริการรายใหม่ มีหน้าที่แจ้งให้ผู้ใช้บริการที่ประสงค์จะทำการโอนย้ายทราบถึง รายละเอียดหลักเกณฑ์การโอนย้ายผู้ให้บริการในข้อ ๑๒ และ", n_chars: 181});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_18", doc: "11_keyword.pdf", unit: "ข้อ", number: 18, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๑๘ ภายหลังการโอนย้าย หากผู้ใช้บริการได้ยกเลิกหรือถูกยกเลิกการใช้งาน ให้เลขหมาย โทรศัพท์เคลื่อนที่ดังกล่าวกลับไปอยู่ในความครอบครองของผู้ใ", n_chars: 226});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_19", doc: "11_keyword.pdf", unit: "ข้อ", number: 19, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๑๙ กรณีเลขหมายโทรศัพท์เคลื่อนที่ที่ผู้ให้บริการรายเดิมได้ชาระค่าธรรมเนียมเลขหมาย ที่ตนมีอยู่ไว้แล้ว เมื่อมีเลขหมายย้ายออกมีสิทธิที่จะขอค", n_chars: 289});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_20", doc: "11_keyword.pdf", unit: "ข้อ", number: 20, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๒๐ ผู้ให้บริการรายใหม่อาจเรียกเก็บค่าธรรมเนียมการโอนย้ายผู้ให้บริการได้ โดยค่าธรรมเนียมนั้นต้องไม่เกินอัตราที่ กสทช. กำหนด ในกรณีที่ผู้ใ", n_chars: 451});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_21", doc: "11_keyword.pdf", unit: "ข้อ", number: 21, muad: "หมวด 4", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๒๑ ผู้ใช้บริการมีสิทธิขอโอนย้ายผู้ให้บริการโทรศัพท์เคลื่อนที่ โดยคงสิทธิการใช้ เลขหมายโทรศัพท์เคลื่อนที่ได้ เว้นแต่จะมีเหตุต้องห้ามตามข้", n_chars: 144});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_22", doc: "11_keyword.pdf", unit: "ข้อ", number: 22, muad: "หมวด 4", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๒๒ ในการโอนย้ายผู้ให้บริการโทรศัพท์เคลื่อนที่ ผู้ใช้บริการมีหน้าที่ให้ข้อมูลในการ ลงทะเบียนผู้ใช้บริการและการพิสูจน์ยืนยันตัวบุคคลของผู้", n_chars: 249});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_23", doc: "11_keyword.pdf", unit: "ข้อ", number: 23, muad: "หมวด 5", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๒๓ ให้ศูนย์ให้บริการระบบสารสนเทศ มีหน้าที่บริหารจัดการระบบสารสนเทศและ ฐานข้อมูลกลางที่เกี่ยวกับการโอนย้ายผู้ให้บริการโทรศัพท์เคลื่อนที่ ", n_chars: 499});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_24", doc: "11_keyword.pdf", unit: "ข้อ", number: 24, muad: "หมวด 6", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๒๔ ในกรณีที่ผู้ใช้บริการได้รับความเดือดร้อนเสียหายจากการให้บริการคงสิทธิเลขหมาย ผู้ใช้บริการมีสิทธิร้องเรียนเพื่อให้ กสทช. พิจารณาให้มีก", n_chars: 246});
CREATE (:Chunk {id: "chunk::11_keyword::ข้อ_25", doc: "11_keyword.pdf", unit: "ข้อ", number: 25, muad: "หมวด 6", title: "เรื่อง หลักเกณฑ์บริการคงสิทธิเลขหมายโทรศัพท์เคลื่อนที่", preview: "ข้อ ๒๕ ในกรณีมีข้อพิพาทเกี่ยวกับการโอนย้ายการให้บริการคงสิทธิเลขหมายระหว่างผู้ให้บริการ ผู้ให้บริการฝ่ายหนึ่งฝ่ายใดมีสิทธินาข้อพิพาทนั้นยื่น", n_chars: 446});
CREATE (:Chunk {id: "chunk::12_keyword::preamble", doc: "12_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อ", n_chars: 820});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_1", doc: "12_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๑ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป เว้นแต่ข้อ ๖ ข้อ ๗ ข้อ ๙ ข้อ ๑๑ และข้อ ๑๒ ให้ใช้บังคับตั้งแต่", n_chars: 170});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_2", doc: "12_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๒ บรรดาประกาศ ระเบียบ ข้อบังคับ หรือคำสั่งอื่นใดในส่วนที่ได้กำหนดไว้แล้ว ในประกาศนี้ หรือซึ่งขัดหรือแย้งกับประกาศนี้ ให้ใช้ประกาศนี้แทน", n_chars: 139});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_3", doc: "12_keyword.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๓ ในประกาศนี้ “ผู้รับใบอนุญาต” หมายความว่า ผู้รับใบอนุญาตประกอบกิจการโทรคมนาคมที่ให้บริการ โทรศัพท์เคลื่อนที่ภายในประเทศตามกฎหมายว่าด้วย", n_chars: 1000});
CREATE (:Definition {id: "term::ค่าบริการ", term: "ค่าบริการ"});
CREATE (:Definition {id: "term::รายการส่งเสริมการขายหลัก", term: "รายการส่งเสริมการขายหลัก"});
CREATE (:Definition {id: "term::รายการส่งเสริมการขายเสริม", term: "รายการส่งเสริมการขายเสริม"});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_4", doc: "12_keyword.pdf", unit: "ข้อ", number: 4, muad: "หมวด 1", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๔ ในหมวดนี้ “ผู้รับใบอนุญาต” หมายความว่า ผู้รับใบอนุญาตประกอบกิจการ โทรคมนาคมแบบที่สามและผู้รับใบอนุญาตที่เป็นบริษัทในเครือตามประกาศว่าด", n_chars: 274});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_5", doc: "12_keyword.pdf", unit: "ข้อ", number: 5, muad: "หมวด 1", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๕ โครงสร้างอัตราค่าบริการบังคับใช้กับบริการ ดังนี้ (๑) บริการเสียง (Voice) (๒) บริการข้อความสั้น (SMS) (๓) บริการข้อความมัลติมีเดีย (MMS", n_chars: 192});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_6", doc: "12_keyword.pdf", unit: "ข้อ", number: 6, muad: "หมวด 1", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๖ ให้ผู้รับใบอนุญาตตามหมวดนี้กำหนดอัตราค่าบริการตามสิทธิการใช้งานของรายการ ส่งเสริมการขายที่มีการเสนอขายหรือให้บริการทั้งหมด โดยเมื่อเฉล", n_chars: 183});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_7", doc: "12_keyword.pdf", unit: "ข้อ", number: 7, muad: "หมวด 1", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๗ ในการปฏิบัติตามโครงสร้างอัตราค่าบริการตามข้อ ๖ ให้ผู้รับใบอนุญาตตามหมวดนี้ ต้องมีการเสนอขายบริการเสียงโดยมีจำนวนรายการส่งเสริมการขายที", n_chars: 366});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_8", doc: "12_keyword.pdf", unit: "ข้อ", number: 8, muad: "หมวด 1", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๘ ผู้รับใบอนุญาตตามหมวดนี้ต้องจัดให้มีรายการส่งเสริมการขายหลักขั้นเริ่มต้นอย่างน้อย ๑ รายการ โดยให้คิดค่าบริการตามปริมาณการใช้งานจริงเป็", n_chars: 766});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_9", doc: "12_keyword.pdf", unit: "ข้อ", number: 9, muad: "หมวด 1", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๙ ให้สำนักงาน กสทช. ตรวจสอบโครงสร้างอัตราค่าบริการตามสิทธิการใช้งานที่ผู้รับ ใบอนุญาตตามหมวดนี้ให้บริการอยู่ในตลาดเป็นประจำทุกเดือน โดยใ", n_chars: 481});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_10", doc: "12_keyword.pdf", unit: "ข้อ", number: 10, muad: "หมวด 1", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๑๐ ในกรณีที่สำนักงาน กสทช. ตรวจสอบพบว่า ผู้รับใบอนุญาตตามหมวดนี้กำหนด อัตราค่าบริการไม่เป็นไปตามโครงสร้างอัตราค่าบริการตามข้อ ๖ และข้อ ๘", n_chars: 464});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_11", doc: "12_keyword.pdf", unit: "ข้อ", number: 11, muad: "หมวด 1", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๑๑ ให้สำนักงาน กสทช. ดำเนินการทบทวนโครงสร้างอัตราค่าบริการเป็นประจำทุกสามปี หรือในกรณีที่ผู้รับใบอนุญาตตามหมวดนี้มีหนังสือขอให้พิจารณาทบ", n_chars: 590});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_12", doc: "12_keyword.pdf", unit: "ข้อ", number: 12, muad: "หมวด 1", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๑๒ ให้ผู้รับใบอนุญาตตามหมวดนี้มีหน้าที่นาส่งข้อมูลและเอกสารหลักฐานแก่สำนักงาน กสทช. ภายในวันที่ ๓๑ พฤษภาคมของทุกปี ทั้งนี้ ให้จัดทำและนา", n_chars: 676});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_13", doc: "12_keyword.pdf", unit: "ข้อ", number: 13, muad: "หมวด 2", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๑๓ ให้ผู้รับใบอนุญาตรายงานโครงสร้างอัตราค่าบริการที่จัดเก็บจากผู้ใช้บริการต่อ สำนักงาน กสทช. ทุกเดือน ภายในวันที่สิบห้าของเดือนถัดไป หาก", n_chars: 1313});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_14", doc: "12_keyword.pdf", unit: "ข้อ", number: 14, muad: "หมวด 2", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๑๔ ให้ผู้รับใบอนุญาตจัดให้มีระบบการแจ้งเตือนและแสดงข้อมูลการให้บริการด้วยวิธี ส่งผ่านบริการข้อความสั้น เว้นแต่ผู้ใช้บริการจะได้ตกลงเลือก", n_chars: 1089});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_15", doc: "12_keyword.pdf", unit: "ข้อ", number: 15, muad: "หมวด 2", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๑๕ นอกเหนือจากการจัดส่งใบแจ้งรายการกำรใช้บริการโทรคมนาคมของผู้ใช้บริการ ตามประกาศว่าด้วยมาตรฐานของสัญญาให้บริการโทรคมนาคม ให้ผู้รับใบอนุ", n_chars: 319});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_16", doc: "12_keyword.pdf", unit: "ข้อ", number: 16, muad: "หมวด 2", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๑๖ ให้ผู้รับใบอนุญาตแจ้งอัตราค่าบริการของทุกรายการส่งเสริมการขายที่เสนอขาย เป็นการทั่วไปในที่เปิดเผยเห็นได้ง่าย ณ ที่ทำการและเว็บไซต์ของ", n_chars: 420});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_17", doc: "12_keyword.pdf", unit: "ข้อ", number: 17, muad: "หมวด 2", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๑๗ การให้บริการต่อเนื่องภายหลังระยะเวลาการใช้บริการรายการส่งเสริมการขายเสริม สิ้นสุดลงจะกระทำได้ก็ต่อเมื่อผู้ใช้บริการแจ้งความประสงค์จะใ", n_chars: 157});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_18", doc: "12_keyword.pdf", unit: "ข้อ", number: 18, muad: "หมวด 2", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๑๘ เมื่อสิ้นสุดอายุการใช้งานและผู้ใช้บริการไม่เลือกรายการส่งเสริมการขายใหม่ ให้ผู้รับใบอนุญาตคงให้บริการตามรายการส่งเสริมการขายเดิมต่อไป", n_chars: 257});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_19", doc: "12_keyword.pdf", unit: "ข้อ", number: 19, muad: "หมวด 2", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๑๙ ผู้รับใบอนุญาตต้องไม่เรียกเก็บค่าใช้จ่ายในการเปลี่ยนแปลงรายการส่งเสริมการขาย จากผู้ใช้บริการ เว้นแต่ในกรณี ดังนี้ ้ หนา ๖๐ ่ เลม ๑๓๖ ", n_chars: 480});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_20", doc: "12_keyword.pdf", unit: "ข้อ", number: 20, muad: "หมวด 2", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๒๐ ผู้รับใบอนุญาตต้องยินยอมให้ผู้ใช้บริการเปลี่ยนแปลงรอบการใช้งานและรอบ การชำระเงิน โดยไม่เรียกเก็บค่าใช้จ่ายในการเปลี่ยนแปลงดังกล่าวจาก", n_chars: 163});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_21", doc: "12_keyword.pdf", unit: "ข้อ", number: 21, muad: "หมวด 2", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๒๑ ให้สำนักงาน กสทช. จัดทำรายงานวิเคราะห์แนวทางการกำหนดและกำกับดูแล โครงสร้างอัตราค่าบริการในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเส", n_chars: 191});
CREATE (:Chunk {id: "chunk::12_keyword::ข้อ_22", doc: "12_keyword.pdf", unit: "ข้อ", number: 22, muad: "หมวด 2", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ข้อ ๒๒ ให้ผู้รับใบอนุญาตตามข้อ ๔ กำหนดอัตราค่าบริการในส่วนที่เกินกว่าสิทธิการใช้งาน ของรายการส่งเสริมการขายทั้งหมดไม่เกินอัตราค่าบริการในส่ว", n_chars: 1293});
CREATE (:Chunk {id: "chunk::12_keyword::ภาคผนวก_1", doc: "12_keyword.pdf", unit: "ภาคผนวก", number: 1, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", preview: "ภาคผนวก ก อัตราค่าบริการตามสิทธิการใช้งานของรายการส่งเสริมการขายทั้งหมด แนบท้ายประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทร", n_chars: 1195});
CREATE (:Chunk {id: "chunk::13_keyword::preamble", doc: "13_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลอัตราขั้นสูงของค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเสริมการขายหลัก", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง การกำหนดและกำกับดูแลอัตราขั้นสูงของค่าบริการโทรศัพท์เคลื่", n_chars: 865});
CREATE (:Chunk {id: "chunk::13_keyword::ข้อ_1", doc: "13_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลอัตราขั้นสูงของค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเสริมการขายหลัก", preview: "ข้อ ๑ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 78});
CREATE (:Chunk {id: "chunk::13_keyword::ข้อ_2", doc: "13_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลอัตราขั้นสูงของค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเสริมการขายหลัก", preview: "ข้อ ๒ บรรดาประกาศ ระเบียบ ข้อบังคับ หรือคำสั่งอื่นใดในส่วนที่ได้กำหนดไว้แล้ว ในประกาศนี้ หรือซึ่งขัดหรือแย้งกับประกาศนี้ ให้ใช้ประกาศนี้แทน", n_chars: 139});
CREATE (:Chunk {id: "chunk::13_keyword::ข้อ_3", doc: "13_keyword.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลอัตราขั้นสูงของค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเสริมการขายหลัก", preview: "ข้อ ๓ ในประกาศนี้ “ผู้รับใบอนุญาต” หมายความว่า ผู้รับใบอนุญาตประกอบกิจการโทรคมนาคมแบบที่สาม และผู้รับใบอนุญาตที่เป็นบริษัทในเครือตามประกาศว่", n_chars: 955});
CREATE (:Chunk {id: "chunk::13_keyword::ข้อ_4", doc: "13_keyword.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลอัตราขั้นสูงของค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเสริมการขายหลัก", preview: "ข้อ ๔ อัตราขั้นสูงของค่าบริการในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเสริมการขายหลัก ใช้บังคับกับบริการ ดังนี้ (๑) บริการเสียง (Voice) (", n_chars: 252});
CREATE (:Chunk {id: "chunk::13_keyword::ข้อ_5", doc: "13_keyword.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลอัตราขั้นสูงของค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเสริมการขายหลัก", preview: "ข้อ ๕ ให้ผู้รับใบอนุญาตกำหนดอัตราค่าบริการในส่วนที่เกินกว่าสิทธิการใช้งานของรายการ ส่งเสริมการขายหลักที่มีการเสนอขายหรือให้บริการทั้งหมดไม่เ", n_chars: 205});
CREATE (:Chunk {id: "chunk::13_keyword::ข้อ_6", doc: "13_keyword.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลอัตราขั้นสูงของค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเสริมการขายหลัก", preview: "ข้อ ๖ ให้สำนักงาน กสทช. ตรวจสอบอัตราค่าบริการในส่วนที่เกินกว่าสิทธิการใช้งาน ของรายการส่งเสริมการขายหลักที่ผู้รับใบอนุญาตให้บริการอยู่ในตลาด", n_chars: 818});
CREATE (:Chunk {id: "chunk::13_keyword::ข้อ_7", doc: "13_keyword.pdf", unit: "ข้อ", number: 7, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลอัตราขั้นสูงของค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเสริมการขายหลัก", preview: "ข้อ ๗ ให้สำนักงาน กสทช. ดำเนินการทบทวนอัตราขั้นสูงของค่าบริการในส่วนที่เกินกว่า สิทธิการใช้งานของรายการส่งเสริมการขายหลักพร้อมกับการทบทวนโคร", n_chars: 1169});
CREATE (:Chunk {id: "chunk::13_keyword::ข้อ_8", doc: "13_keyword.pdf", unit: "ข้อ", number: 8, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลอัตราขั้นสูงของค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเสริมการขายหลัก", preview: "ข้อ ๘ ให้ผู้รับใบอนุญาตที่กำหนดอัตราค่าบริการในส่วนที่เกินกว่าสิทธิการใช้งานของ รายการส่งเสริมการขายหลักที่มีการให้บริการเกินกว่าอัตราขั้นสู", n_chars: 908});
CREATE (:Chunk {id: "chunk::13_keyword::ภาคผนวก_1", doc: "13_keyword.pdf", unit: "ภาคผนวก", number: 1, muad: "", title: "เรื่อง การกำหนดและกำกับดูแลอัตราขั้นสูงของค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเสริมการขายหลัก", preview: "ภาคผนวก อัตราขั้นสูงของค่าบริการในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเสริมการขายหลัก ประเภทบริการ อัตราค่าบริการ* บริการเสียง ไม่เกิน ", n_chars: 354});
CREATE (:Chunk {id: "chunk::14_keyword::preamble", doc: "14_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเส", n_chars: 1115});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_1", doc: "14_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๑ ให้ยกเลิกประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ์ และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสา หรือเดินสาย วางท่อ", n_chars: 218});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_2", doc: "14_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๒ ในประกาศนี้ “คณะกรรมการ” หมายความว่า คณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ “เลขาธิการ” หมายความว่า เลข", n_chars: 1268});

CREATE (:Document {id: "doc::14_keyword", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", law_type: "ประกาศ กสทช.", category: "มาตรฐานทางเทคนิคในกิจการโทรคมนาคม", url: "https://ratchakitcha.soc.go.th/documents/2099191.pdf", n_chunks: 31});

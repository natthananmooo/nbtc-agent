CREATE (:Chunk {id: "chunk::01_act::มาตรา_4_p1", doc: "01_act.pdf", unit: "มาตรา", number: 4, muad: "", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๔ ในพระราชบัญญัตินี้ “คลื่นความถี่”หมายความว่าคลื่นวิทยุหรือคลื่นแฮรตเซียนซึ่งเป็นคลื่นแม่เหล็กไฟฟ้า ที่มีความถี่ต่ำกว่าสามล้านเมกะเฮิ", n_chars: 2477});

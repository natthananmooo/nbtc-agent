CREATE (:Chunk {id: "chunk::01_act::มาตรา_23", doc: "01_act.pdf", unit: "มาตรา", number: 23, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒๓ การประชุม การลงมติ และการปฏิบัติงานของ กสทช. ให้เป็นไปตาม ระเบียบที่ กสทช. กำหนด ในการประชุม ถ้ามีการพิจารณาเรื่องที่กรรมการผู้ใดมี", n_chars: 354});

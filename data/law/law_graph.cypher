CREATE (:Document {id: "doc::12_keyword", title: "เรื่อง การกำหนดและกำกับดูแลโครงสร้างอัตราค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศ", law_type: "ประกาศ กสทช.", category: "การกำกับดูแล", url: "https://ratchakitcha.soc.go.th/documents/17111910.pdf", n_chunks: 24});

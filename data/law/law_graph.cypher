CREATE (:Document {id: "doc::27_protect", title: "เรื่อง มาตรการคุ้มครองสิทธิของผู้ใช้บริการโทรคมนาคมเกี่ยวกับข้อมูลส่วนบุคคล สิทธิในความเป็นส่วนตัว และเสรีภาพในการสื่อสารถึงกันโดยทางโทรคมนาคม", law_type: "ประกาศ กสทช.", category: "ส่งเสริม/คุ้มครอง", url: "https://ratchakitcha.soc.go.th/documents/140D215S0000000002700.pdf", n_chunks: 22});

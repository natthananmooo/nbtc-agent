CREATE (:Document {id: "doc::01_act", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", law_type: "พ.ร.บ.", category: "การอนุญาตและการประกอบกิจการกระจายเสียง และกิจการโทรทัศน์", url: "https://broadcast.nbtc.go.th/data/document/law/doc/th/560400000025.pdf", n_chunks: 380});

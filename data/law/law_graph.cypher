CREATE (:Chunk {id: "chunk::01_act::มาตรา_22", doc: "01_act.pdf", unit: "มาตรา", number: 22, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒๒ ยกเลิกโดยพระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุ กระจายเสียง วิทยุโทรทัศน์ และกิจการโทรคมนาคม (ฉบับที่ ๓)", n_chars: 546});

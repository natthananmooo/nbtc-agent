CREATE (:Chunk {id: "chunk::01_act::มาตรา_4_p1_d1", doc: "01_act.pdf", unit: "มาตรา", number: 4, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๔ ในพระราชบัญญัตินี้ “คลื่นความถี่” หมายความว่า คลื่นวิทยุหรือคลื่นแฮรตเซียนซึ่งเป็นคลื่นแม่เหล็กไฟฟ้าที่มี ความถี่ต่ำกว่าสามล้านเมกะเ", n_chars: 2470});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_4_p2_d1", doc: "01_act.pdf", unit: "มาตรา", number: 4, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "และการอื่นเพื่อใช้งานภายใต้เงื่อนไขที่ กสทช. กำหนด “แผนความถี่วิทยุ” หมายความว่า การกำหนดช่องความถี่วิทยุสำหรับกิจการวิทยุกระจายเสียง กิจการ", n_chars: 1179});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_5_d1", doc: "01_act.pdf", unit: "มาตรา", number: 5, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๕ ให้นายกรัฐมนตรีรักษาการตามพระราชบัญญัตินี้", n_chars: 50});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_6_d1", doc: "01_act.pdf", unit: "มาตรา", number: 6, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๖ ให้มีคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรียกโดยย่อว่า “กสทช.” จำนวนสิบเอ็ดคน ประกอบด้วย (๑) ผู้ท", n_chars: 1037});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_7_d2", doc: "01_act.pdf", unit: "มาตรา", number: 7, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๗ กรรมการต้องมีคุณสมบัติและไม่มีลักษณะต้องห้ามดังต่อไปนี้ ก. คุณสมบัติทั่วไป (๑) มีสัญชาติไทยโดยการเกิด (๒) มีอายุไม่ต่ำกว่าสามสิบห้าป", n_chars: 1507});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_8_d1", doc: "01_act.pdf", unit: "มาตรา", number: 8, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๘ กรรมการต้อง (๑) ไม่เป็นข้าราชการซึ่งมีตำแหน่งหรือเงินเดือนประจำ (๒) ไม่เป็นพนักงานหรือลูกจ้างของหน่วยงานของรัฐ รัฐวิสาหกิจหรือราชการ", n_chars: 355});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_9_p1", doc: "01_act.pdf", unit: "มาตรา", number: 9, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๙ เพื่อประโยชน์ในการเสนอชื่อผู้สมควรได้รับเลือกเป็นกรรมการตามส่วนที่ ๔ ให้สมาคม สถาบัน หรือองค์กรที่มีลักษณะดังต่อไปนี้มีสิทธิขอขึ้นทะ", n_chars: 1707});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_9_p2", doc: "01_act.pdf", unit: "มาตรา", number: 9, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "(๘) อย่างใดอย่างหนึ่งเท่านั้น เมื่อสำนักงานเลขาธิการวุฒิสภาได้รับจดทะเบียนสมาคม สถาบัน หรือองค์กรใดตามวรรคหนึ่งแล้ว ให้เป็นอันใช้ได้ การวินิ", n_chars: 822});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_10_d2", doc: "01_act.pdf", unit: "มาตรา", number: 10, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๑๐ เมื่อมีเหตุที่ต้องมีการเลือกและแต่งตั้งกรรมการ ให้สำนักงานเลขาธิการวุฒิสภา ประกาศทางวิทยุกระจายเสียง วิทยุโทรทัศน์ สื่อสิ่งพิมพ์ แล", n_chars: 1317});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_11_d2", doc: "01_act.pdf", unit: "มาตรา", number: 11, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๑๑ เมื่อครบกำหนดระยะเวลาตามมาตรา ๑๐ แล้ว ให้สำนักงานเลขาธิการวุฒิสภา ตรวจสอบคุณสมบัติของผู้ได้รับการเสนอชื่อว่าถูกต้องตามที่กำหนดในมาต", n_chars: 715});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_12_d1", doc: "01_act.pdf", unit: "มาตรา", number: 12, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๑๒ เมื่อครบกำหนดระยะเวลาการเสนอชื่อแล้ว หากมีผู้ได้รับการเสนอชื่อน้อยกว่า สองเท่าของจำนวนตามที่ระบุไว้ในแต่ละประเภทตามมาตรา ๑๓ (๑) (๒)", n_chars: 607});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_13_d1", doc: "01_act.pdf", unit: "มาตรา", number: 13, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๑๓ เมื่อพ้นกำหนดระยะเวลาการเสนอชื่อตามมาตรา ๑๐ มาตรา ๑๑ หรือมาตรา ๑๒ แล้วแต่กรณีแล้ว ให้สำนักงานเลขาธิการวุฒิสภาจัดให้ผู้ได้รับการเสนอ", n_chars: 1969});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_14_d1", doc: "01_act.pdf", unit: "มาตรา", number: 14, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๑๔ เมื่อมีเหตุที่ต้องมีการเลือกและแต่งตั้งกรรมการ ให้มีคณะกรรมการสรรหา กรรมการคณะหนึ่งมีจำนวนสิบห้าคน ทำหน้าที่คัดเลือกผู้สมควรได้รับเ", n_chars: 1375});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_15_d1", doc: "01_act.pdf", unit: "มาตรา", number: 15, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๑๕ ในการดำเนินการคัดเลือกกรรมการตามส่วนนี้ ให้สำนักงานเลขาธิการวุฒิสภา ประกาศการเปิดรับสมัครบุคคลผู้มีคุณสมบัติตามมาตรา ๖ ให้ทราบเป็นก", n_chars: 1217});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_16_d1", doc: "01_act.pdf", unit: "มาตรา", number: 16, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๑๖ เมื่อได้รายชื่อผู้สมควรได้รับเลือกเป็นกรรมการจากการคัดเลือกกันเองตามส่วนที่ ๒ และจากการสรรหาตามส่วนที่ ๓ แล้ว ให้เลขาธิการวุฒิสภานำ", n_chars: 1102});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_17_d1", doc: "01_act.pdf", unit: "มาตรา", number: 17, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๑๗ ให้วุฒิสภามีมติเลือกบุคคลจากบัญชีรายชื่อที่เลขาธิการวุฒิสภาเสนอให้แล้วเสร็จ ภายในหกสิบวันนับแต่วันที่ได้รับบัญชีรายชื่อ เพื่อให้ได้", n_chars: 959});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_18_d1", doc: "01_act.pdf", unit: "มาตรา", number: 18, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๑๘ ในกรณีที่ผู้ได้รับเลือกตามมาตรา ๑๗ มีลักษณะต้องห้ามตามมาตรา ๘ (๑) (๒) หรือ (๓) นายกรัฐมนตรีจะนำความขึ้นกราบบังคมทูลเพื่อทรงพระกรุณา", n_chars: 578});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_19_d2", doc: "01_act.pdf", unit: "มาตรา", number: 19, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๑๙ กรรมการมีวาระการดำรงตำแหน่งหกปีนับแต่วันที่พระมหากษัตริย์ทรงแต่งตั้ง และให้ดำรงตำแหน่งได้เพียงวาระเดียว ให้กรรมการซึ่งพ้นจากตำแหน่ง", n_chars: 396});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_20_d6", doc: "01_act.pdf", unit: "มาตรา", number: 20, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒๐ นอกจากการพ้นจากตำแหน่งตามวาระ กรรมการพ้นจากตำแหน่งเมื่อ (๑) ตาย (๒) มีอายุครบเจ็ดสิบปีบริบูรณ์ (๓) ลาออก (๔) ขาดคุณสมบัติหรือมีลักษ", n_chars: 1413});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_21_d2", doc: "01_act.pdf", unit: "มาตรา", number: 21, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒๑ สมาชิกสภาผู้แทนราษฎรหรือสมาชิกวุฒิสภาไม่น้อยกว่าหนึ่งในสี่ของจำนวน สมาชิกทั้งหมดเท่าที่มีอยู่ของแต่ละสภา มีสิทธิร้องขอต่อประธานวุฒิ", n_chars: 376});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_22_d1", doc: "01_act.pdf", unit: "มาตรา", number: 22, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒๒ เมื่อปรากฏว่า กสทช. ไม่ปฏิบัติหน้าที่ตามที่กฎหมายกำหนดอย่างมีประสิทธิภาพ ให้บุคคลดังต่อไปนี้มีสิทธิร้องขอต่อประธานวุฒิสภาเพื่อให้วุ", n_chars: 934});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_23_d1", doc: "01_act.pdf", unit: "มาตรา", number: 23, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒๓ การประชุม การลงมติ และการปฏิบัติงานของ กสทช. ให้เป็นไปตามระเบียบที่ กสทช. กำหนด ในการประชุม ถ้ามีการพิจารณาเรื่องที่กรรมการผู้ใดมีส", n_chars: 351});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_24_d1", doc: "01_act.pdf", unit: "มาตรา", number: 24, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒๔ การปฏิบัติหน้าที่ของ กสทช. กสท. และ กทค. ในเรื่องใดที่เกี่ยวข้องหรือมี ผลกระทบต่อประโยชน์สาธารณะ ต้องกระทำโดยมติของที่ประชุม และต้อ", n_chars: 736});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_25_d1", doc: "01_act.pdf", unit: "มาตรา", number: 25, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒๕ ให้กรรมการเป็นผู้ดำรงตำแหน่งระดับสูงตามกฎหมายประกอบรัฐธรรมนูญ ว่าด้วยการป้องกันและปราบปรามการทุจริต และเป็นเจ้าพนักงานตามประมวลกฎหม", n_chars: 149});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_26_d1", doc: "01_act.pdf", unit: "มาตรา", number: 26, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒๖ ให้ประธานกรรมการ รองประธานกรรมการ และกรรมการปฏิบัติหน้าที่เต็มเวลา ประธานกรรมการ รองประธานกรรมการ และกรรมการ ได้รับค่าตอบแทนเหมาจ่า", n_chars: 330});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_27_p1_d1", doc: "01_act.pdf", unit: "มาตรา", number: 27, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒๗ ให้ กสทช. มีอำนาจหน้าที่ดังต่อไปนี้ (๑) จัดทำแผนแม่บทการบริหารคลื่นความถี่ ตารางกำหนดคลื่นความถี่แห่งชาติ แผนแม่บท กิจการกระจายเสีย", n_chars: 2465});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_27_p2_d1", doc: "01_act.pdf", unit: "มาตรา", number: 27, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "(๑๔) ประสานงานเกี่ยวกับการบริหารคลื่นความถี่ทั้งในประเทศและระหว่างประเทศ (๑๕) วินิจฉัยและแก้ไขปัญหาการใช้คลื่นความถี่ที่มีการรบกวนซึ่งกันและ", n_chars: 2054});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_28_d2", doc: "01_act.pdf", unit: "มาตรา", number: 28, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒๘ ให้ กสทช. จัดให้มีการรับฟังความคิดเห็นของผู้มีส่วนได้เสียและประชาชนทั่วไป เพื่อนำความคิดเห็นที่ได้มาประกอบการพิจารณาก่อนออกระเบียบ ", n_chars: 951});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_29_d2", doc: "01_act.pdf", unit: "มาตรา", number: 29, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๒๙ การกำหนดอัตราค่าใช้หรือค่าเชื่อมต่อโครงข่าย ค่าธรรมเนียมใดๆ หรือค่าบริการ ในการประกอบกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรค", n_chars: 413});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_30_d2", doc: "01_act.pdf", unit: "มาตรา", number: 30, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๓๐ ในการปฏิบัติหน้าที่ของ กสทช. กสท. กทค. คณะกรรมการอื่น และ คณะอนุกรรมการที่จัดตั้งขึ้นตามพระราชบัญญัตินี้ ตลอดจนเลขาธิการ กสทช. และพ", n_chars: 1170});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_31_d1", doc: "01_act.pdf", unit: "มาตรา", number: 31, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๓๑ เพื่อประโยชน์ในการคุ้มครองผู้บริโภคมิให้ถูกเอาเปรียบจากผู้ประกอบกิจการ กระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคม ให้ กสทช. มีหน", n_chars: 1000});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_32_d2", doc: "01_act.pdf", unit: "มาตรา", number: 32, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๓๒ เพื่อประโยชน์ในการคุ้มครองสิทธิในความเป็นส่วนตัวและเสรีภาพของบุคคล ในการสื่อสารถึงกันโดยทางโทรคมนาคม ให้ กสทช. มีอำนาจกำหนดมาตรการค", n_chars: 718});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_33_d1", doc: "01_act.pdf", unit: "มาตรา", number: 33, muad: "หมวด 1", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๓๓ ให้ กสทช. มีอำนาจแต่งตั้งคณะอนุกรรมการ คณะทำงาน หรือมอบหมายให้ พนักงานเจ้าหน้าที่ปฏิบัติหน้าที่ตามพระราชบัญญัตินี้ หรือตามที่ได้รับ", n_chars: 259});

CREATE (:Document {id: "doc::13_keyword", title: "เรื่อง การกำหนดและกำกับดูแลอัตราขั้นสูงของค่าบริการโทรศัพท์เคลื่อนที่ภายในประเทศในส่วนที่เกินกว่าสิทธิการใช้งานของรายการส่งเสริมการขายหลัก", law_type: "ประกาศ กสทช.", category: "การกำกับดูแล", url: "https://ratchakitcha.soc.go.th/documents/17152352.pdf", n_chunks: 10});

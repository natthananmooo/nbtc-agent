CREATE (:Document {id: "doc::18_keyword", title: "เรื่อง ยกเลิกอัตราค่าบริการขั้นสูงชั่วคราว ตามประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูงของค่าบริการและเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", law_type: "ประกาศ กสทช.", category: "ด้านการเงิน", url: "https://ratchakitcha.soc.go.th/documents/1944035.pdf", n_chunks: 8});
CREATE (:Document {id: "doc::19_keyword", title: "เรื่อง การกำหนดวงเงินคงเหลือสะสมสูงสุดในการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่", law_type: "ประกาศ กสทช.", category: "ด้านการเงิน", url: "https://ratchakitcha.soc.go.th/documents/2129482.pdf", n_chunks: 6});

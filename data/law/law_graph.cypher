CREATE (:Chunk {id: "chunk::01_act::มาตรา_5_d5", doc: "01_act.pdf", unit: "มาตรา", number: 5, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๕ ใบอนุญาตให้ใช้คลื่นความถี่ที่มีอยู่ในวันก่อนวันที่พระราชกฤษฎีกานี้ใช้บังคับ ให้โอนแก่กันได้ตามที่กำหนดในมาตรา ๔๔/๓ แห่งพระราชบัญญัติ", n_chars: 401});

CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_3", doc: "14_keyword.pdf", unit: "ข้อ", number: 3, muad: "หมวด 1", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๓ ผู้รับใบอนุญาตที่ได้รับสิทธิในการปักหรือตั้งเสา หรือเดินสาย วางท่อ หรือติดตั้ง อุปกรณ์ประกอบใดในการประกอบกิจการโทรคมนาคม จะใช้ประโยชน์", n_chars: 198});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_4", doc: "14_keyword.pdf", unit: "ข้อ", number: 4, muad: "หมวด 1", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๔ กรณีผู้รับใบอนุญาตรายใดได้รับโอนกรรมสิทธิ์ในทรัพย์สินที่ใช้ในการประกอบกิจการ โทรคมนาคมมาจากผู้รับใบอนุญาตที่ได้รับความเห็นชอบจากคณะกรร", n_chars: 401});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_5", doc: "14_keyword.pdf", unit: "ข้อ", number: 5, muad: "หมวด 2", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๕ ผู้รับใบอนุญาตที่มีเหตุและความจำเป็นต้องใช้สิทธิในการปักหรือตั้งเสา หรือเดินสาย วางท่อหรือติดตั้งอุปกรณ์ประกอบใด จะต้องยื่นขอใช้สิทธิด", n_chars: 1274});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_6", doc: "14_keyword.pdf", unit: "ข้อ", number: 6, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๖ ให้คณะกรรมการแต่งตั้งอนุกรรมการคณะหนึ่ง เรียกว่า “คณะอนุกรรมการพิจารณา สิทธิแห่งทาง” เรียกโดยย่อว่า “กพส.” จำนวนห้าคน ประกอบด้วย ผู้เช", n_chars: 1113});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_7", doc: "14_keyword.pdf", unit: "ข้อ", number: 7, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๗ ให้คณะอนุกรรมการพิจารณาสิทธิแห่งทางมีอำนาจหน้าที่ ดังนี้ (๑) พิจารณาให้ความเห็นแผนผังแสดงรายละเอียดของลักษณะทิศทาง และแนวเขตในการปัก ห", n_chars: 1758});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_8", doc: "14_keyword.pdf", unit: "ข้อ", number: 8, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๘ การประชุมของคณะอนุกรรมการพิจารณาสิทธิแห่งทางต้องมีอนุกรรมการพิจารณา สิทธิแห่งทางมาประชุมไม่น้อยกว่ากึ่งหนึ่งของจำนวนอนุกรรมการพิจารณาส", n_chars: 736});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_9", doc: "14_keyword.pdf", unit: "ข้อ", number: 9, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๙ เมื่อคณะอนุกรรมการพิจารณาสิทธิแห่งทางได้รับคำขอใช้สิทธิตามข้อ ๕ ให้ดำเนินการตรวจสอบคำขอ หากคำขอมีรายละเอียดครบถ้วนตามข้อ ๕ ให้พิจารณาใ", n_chars: 827});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_10", doc: "14_keyword.pdf", unit: "ข้อ", number: 10, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๑๐ คณะกรรมการจะพิจารณาให้ความเห็นชอบในการปักหรือตั้งเสา หรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดของผู้รับใบอนุญาต บนหลักการพื้นฐาน ", n_chars: 603});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_11", doc: "14_keyword.pdf", unit: "ข้อ", number: 11, muad: "หมวด 3", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๑๑ คณะกรรมการมีนโยบายส่งเสริมการลงทุนและการใช้งานโครงสร้างพื้นฐาน โทรคมนาคมร่วมกัน ซึ่งรวมถึง (๑) การใช้เสาซึ่งใช้ในการติดตั้งสายอากาศ (", n_chars: 661});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_12", doc: "14_keyword.pdf", unit: "ข้อ", number: 12, muad: "หมวด 4", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๑๒ หากผู้รับใบอนุญาตที่มีความประสงค์จะเปลี่ยนแปลงแบบหรือแผนผังการดำเนินงาน ให้ยื่นแบบหรือแผนผังการดำเนินงานแก่คณะกรรมการเพื่อพิจารณาให้ค", n_chars: 275});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_13_p1", doc: "14_keyword.pdf", unit: "ข้อ", number: 13, muad: "หมวด 4", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๑๓ ภายใต้บังคับแห่งมาตรา ๓๙ และมาตรา ๔๑ แห่งพระราชบัญญัติการประกอบ กิจการโทรคมนาคม พ.ศ. ๒๕๔๔ เมื่อคณะกรรมการได้ให้ความเห็นชอบการใช้สิทธิ", n_chars: 2284});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_13_p2", doc: "14_keyword.pdf", unit: "ข้อ", number: 13, muad: "หมวด 4", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "(๓) การขึงสายผ่านไปเหนือหรือข้ามที่ดินอันเป็นสาธารณสมบัติของแผ่นดิน เมื่อผู้รับใบอนุญาตได้แจ้งให้เจ้าหน้าที่ของรัฐผู้มีอำนาจหน้าที่ดูแลรักษา", n_chars: 1923});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_14", doc: "14_keyword.pdf", unit: "ข้อ", number: 14, muad: "หมวด 4", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๑๔ กรณีผู้รับใบอนุญาตไม่ประสงค์จะใช้สิทธิตามที่คณะกรรมการให้ความเห็นชอบ และ ผู้รับใบอนุญาตยังมิได้ดำเนินการใช้สิทธิดังกล่าว ให้ผู้รับใบอ", n_chars: 276});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_15", doc: "14_keyword.pdf", unit: "ข้อ", number: 15, muad: "หมวด 4", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๑๕ การกำหนดค่าตอบแทนให้เป็นไปตามหลักเกณฑ์และพื้นฐาน ดังต่อไปนี้ ๑๕.๑ ค่าตอบแทนในการใช้ประโยชน์ในที่ดินหรือทรัพย์สินเพื่อปักหรือตั้งเสา ห", n_chars: 1976});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_16_p1", doc: "14_keyword.pdf", unit: "ข้อ", number: 16, muad: "หมวด 4", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๑๖ ผู้รับใบอนุญาตต้องตรวจสอบ บำรุงรักษา ซ่อมแซมหรือป้องกันอันตรายหรือ ความเสียหายที่อาจจะเกิดขึ้น ในสถานการณ์ ดังต่อไปนี้ ๑๖.๑ ในกรณีปกต", n_chars: 2451});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_16_p2", doc: "14_keyword.pdf", unit: "ข้อ", number: 16, muad: "หมวด 4", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "เท่าใดให้เป็นอำนาจหน้าที่ในการบริหารจัดการของผู้เป็นเจ้าของที่ดินหรือทรัพย์สินนั้น ในกรณีผู้รับใบอนุญาตพาดสายไปบนเสาไฟฟ้า หรือทรัพย์สินใด โด", n_chars: 336});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_17", doc: "14_keyword.pdf", unit: "ข้อ", number: 17, muad: "หมวด 4", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๑๗ ผู้รับใบอนุญาตต้องรับผิดชอบต่อความเสียหาย ดังต่อไปนี้ ๑๗.๑ ในกรณีที่มีความเสียหายปรากฏอย่างชัดแจ้งอันเนื่องมาจากโครงข่าย โทรคมนาคม เส", n_chars: 1334});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_18", doc: "14_keyword.pdf", unit: "ข้อ", number: 18, muad: "หมวด 4", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๑๘ ผู้รับใบอนุญาตต้องปฏิบัติตามมาตรฐานโครงข่าย ดังต่อไปนี้ ๑๘.๑ ผู้รับใบอนุญาตต้องใช้โครงข่ายโทรคมนาคม เครื่องโทรคมนาคม และอุปกรณ์ ที่ใช", n_chars: 639});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_19", doc: "14_keyword.pdf", unit: "ข้อ", number: 19, muad: "หมวด 5", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๑๙ กรณีผู้รับใบอนุญาตไม่อาจใช้สิทธิในการปักหรือตั้งเสา หรือเดินสาย วางท่อ หรือ ติดตั้งอุปกรณ์ประกอบใดได้ เพราะเหตุที่ไม่ได้รับอนุญาต หรื", n_chars: 869});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_20_p1", doc: "14_keyword.pdf", unit: "ข้อ", number: 20, muad: "หมวด 5", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๒๐ คณะกรรมการจะพิจารณาผลกระทบที่อาจเกิดขึ้นของผู้รับใบอนุญาตรายอื่น หน่วยงานของรัฐ ผู้ให้บริการสาธารณูปโภค หรือเจ้าของหรือผู้ครอบครองที่", n_chars: 2486});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_20_p2", doc: "14_keyword.pdf", unit: "ข้อ", number: 20, muad: "หมวด 5", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "สาธารณสมบัติของแผ่นดินหรือในที่ดินของบุคคลอื่น คณะกรรมการจะคิดค่าตอบแทนที่สะท้อนราคากลาง ของหน่วยราชการหรือราคาประเมินของกรมที่ดิน ณ เวลาที่", n_chars: 975});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_21", doc: "14_keyword.pdf", unit: "ข้อ", number: 21, muad: "หมวด 5", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๒๑ ในกรณีที่ผู้รับใบอนุญาตรายอื่น หน่วยงานของรัฐผู้มีอำนาจหน้าที่ดูแลรักษาที่ดินหรือ ทรัพย์สิน ผู้ให้บริการสาธารณูปโภค หรือเจ้าของหรือผู", n_chars: 675});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_22", doc: "14_keyword.pdf", unit: "ข้อ", number: 22, muad: "หมวด 5", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๒๒ ในกรณีที่เจ้าหน้าที่ของรัฐผู้มีอำนาจหน้าที่ดูแลรักษาที่ดินหรือทรัพย์สิน หรือเจ้าของ หรือผู้ครอบครองที่ดินไม่ได้ยื่นคำร้องคัดค้านการขอ", n_chars: 476});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_23", doc: "14_keyword.pdf", unit: "ข้อ", number: 23, muad: "หมวด 6", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๒๓ ผู้รับใบอนุญาตที่ได้รับสิทธิในการปักหรือตั้งเสา หรือเดินสาย วางท่อ หรือติดตั้ง อุปกรณ์ประกอบใดในการจัดให้บริการโทรคมนาคม โดยได้รับควา", n_chars: 417});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_24", doc: "14_keyword.pdf", unit: "ข้อ", number: 24, muad: "หมวด 6", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๒๔ หากผู้ขอรับใบอนุญาตรายใดดำเนินการฝ่าฝืนข้อใดข้อหนึ่งตามประกาศนี้ ให้ดำเนินการตามกฎหมายว่าด้วยการประกอบกิจการโทรคมนาคม บทเฉพาะกาล", n_chars: 135});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_25", doc: "14_keyword.pdf", unit: "ข้อ", number: 25, muad: "หมวด 6", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๒๕ ผู้รับใบอนุญาตที่มีการปักหรือตั้งเสา หรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ใด อยู่ก่อนวันที่ประกาศฉบับนี้ใช้บังคับ ให้มีหน้าที่จัดเก็บ", n_chars: 402});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_26", doc: "14_keyword.pdf", unit: "ข้อ", number: 26, muad: "หมวด 6", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๒๖ ผู้รับใบอนุญาตที่ได้ยื่นคำขอใช้สิทธิในการปักหรือตั้งเสา หรือเดินสาย วางท่อ หรือ ติดตั้งอุปกรณ์ใดไว้แล้วก่อนประกาศฉบับนี้มีผลใช้บังคับ", n_chars: 299});
CREATE (:Chunk {id: "chunk::14_keyword::ข้อ_27", doc: "14_keyword.pdf", unit: "ข้อ", number: 27, muad: "หมวด 6", title: "เรื่อง หลักเกณฑ์และวิธีการเกี่ยวกับการใช้สิทธิในการปักหรือตั้งเสาหรือเดินสาย วางท่อ หรือติดตั้งอุปกรณ์ประกอบใดในการให้บริการโทรคมนาคม", preview: "ข้อ ๒๗ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป ประกาศ ณ วันที่ ๑๒ มกราคม พ.ศ. ๒๕๖๐ พลอากาศเอก ธเรศ ปุณศรี ป", n_chars: 211});
CREATE (:Chunk {id: "chunk::15_keyword::preamble", doc: "15_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารแล", n_chars: 795});
CREATE (:Chunk {id: "chunk::15_keyword::ข้อ_1", doc: "15_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ข้อ ๑ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 78});
CREATE (:Chunk {id: "chunk::15_keyword::ข้อ_2", doc: "15_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ข้อ ๒ ให้ยกเลิกประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการ โทรคมนาคมแห่งชาติ เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการใช้บริกา", n_chars: 204});
CREATE (:Chunk {id: "chunk::15_keyword::ข้อ_3", doc: "15_keyword.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ข้อ ๓ บรรดาประกาศ ระเบียบ หลักเกณฑ์ หรือคำสั่งอื่นใด ในส่วนที่ได้กำหนดไว้แล้ว ในประกาศนี้ หรือซึ่งขัดหรือแย้งกับประกาศนี้ ให้ใช้ประกาศนี้แทน", n_chars: 140});
CREATE (:Chunk {id: "chunk::15_keyword::ข้อ_4", doc: "15_keyword.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ข้อ ๔ ในประกาศนี้ “ผู้รับใบอนุญาต” หมายความว่า ผู้รับใบอนุญาตประกอบกิจการโทรคมนาคมตามกฎหมาย ว่าด้วยการประกอบกิจการโทรคมนาคม “ผู้ให้บริการ” ห", n_chars: 474});
CREATE (:Chunk {id: "chunk::15_keyword::ข้อ_5", doc: "15_keyword.pdf", unit: "ข้อ", number: 5, muad: "หมวด 1", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ข้อ ๕ ผู้ให้บริการที่มีสถานะเป็นส่วนราชการ หน่วยงานของรัฐ หรือนิติบุคคลที่จัดตั้งขึ้น โดยไม่แสวงหาผลกำไรที่มีอำนาจหน้าที่ตามกฎหมายที่เกี่ยวข", n_chars: 692});
CREATE (:Chunk {id: "chunk::15_keyword::ข้อ_6", doc: "15_keyword.pdf", unit: "ข้อ", number: 6, muad: "หมวด 1", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ข้อ ๖ กสทช. อาจพิจารณายกเลิกการลดหรือยกเว้นค่าบริการหากพบว่าผู้ให้บริการ มีคุณสมบัติ หรือมีวัตถุประสงค์เกี่ยวกับการให้บริการไม่เป็นไปตามประก", n_chars: 476});
CREATE (:Chunk {id: "chunk::15_keyword::ข้อ_7", doc: "15_keyword.pdf", unit: "ข้อ", number: 7, muad: "หมวด 1", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ข้อ ๗ สำนักงาน กสทช. จะเผยแพร่การลดหรือยกเว้นค่าบริการตามที่ กสทช. เห็นชอบ ผ่านช่องทางอิเล็กทรอนิกส์หรือวิธีการอื่นใดตามที่สำนักงาน กสทช. กำ", n_chars: 143});
CREATE (:Chunk {id: "chunk::15_keyword::ข้อ_8", doc: "15_keyword.pdf", unit: "ข้อ", number: 8, muad: "หมวด 2", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ข้อ ๘ ผู้ให้บริการที่ยื่นขอยกเว้นค่าบริการโทรศัพท์ประเภทเสียงที่เรียกไปยังเลขหมายโทรศัพท์ แบบสั้น ๓ หลัก และ ๔ หลัก จะต้องมีสถานะเป็นผู้ขอรั", n_chars: 395});
CREATE (:Chunk {id: "chunk::15_keyword::ข้อ_9", doc: "15_keyword.pdf", unit: "ข้อ", number: 9, muad: "หมวด 2", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ข้อ ๙ ผู้ให้บริการจะต้องจัดทำข้อมูลรายละเอียดประกอบการยื่นคำขอ ดังนี้ (๑) เอกสารหลักฐานที่แสดงสถานะของหน่วยงาน องค์กร หรือนิติบุคคลตามกฎหมาย", n_chars: 784});
CREATE (:Chunk {id: "chunk::15_keyword::ข้อ_10", doc: "15_keyword.pdf", unit: "ข้อ", number: 10, muad: "หมวด 2", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ข้อ ๑๐ ผู้ให้บริการที่ได้รับยกเว้นค่าบริการสำหรับการให้บริการเลขหมายโทรศัพท์แบบสั้น ๓ หลัก หรือ ๔ หลัก มีหน้าที่รายงานผลการใช้งานเลขหมายตามร", n_chars: 198});
CREATE (:Chunk {id: "chunk::15_keyword::ข้อ_11", doc: "15_keyword.pdf", unit: "ข้อ", number: 11, muad: "หมวด 2", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ข้อ ๑๑ กสทช. จะพิจารณาคำขอยกเว้นค่าบริการสำหรับการให้บริการเลขหมายโทรศัพท์ แบบสั้น ๓ หลัก หรือ ๔ หลัก ภายใน ๔๕ วันนับแต่วันที่เอกสารหลักฐานป", n_chars: 296});
CREATE (:Chunk {id: "chunk::15_keyword::ข้อ_12", doc: "15_keyword.pdf", unit: "ข้อ", number: 12, muad: "หมวด 2", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ข้อ ๑๒ ผู้รับใบอนุญาตสามารถนาค่าใช้จ่ายค่าตอบแทนการเชื่อมต่อโครงข่ายโทรคมนาคม ที่เกิดขึ้นจริงจากการให้บริการโทรศัพท์ประเภทเสียงที่เรียกไปยัง", n_chars: 596});
CREATE (:Chunk {id: "chunk::15_keyword::ข้อ_13", doc: "15_keyword.pdf", unit: "ข้อ", number: 13, muad: "หมวด 2", title: "เรื่อง การลดหรือยกเว้นค่าบริการสำหรับการให้บริการข้อมูลข่าวสารและความรู้เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน", preview: "ข้อ ๑๓ ให้เลขหมายโทรศัพท์แบบสั้น ๓ หลัก และ ๔ หลัก ที่ได้รับอนุญาตให้ลดหรือ ยกเว้นค่าบริการตามประกาศ กสทช. เรื่อง การลดหรือยกเว้นค่าบริการสำ", n_chars: 739});
CREATE (:Chunk {id: "chunk::16_keyword::preamble", doc: "16_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้า ในกิจการโทรคมนาคม พ.ศ. ๒๕๔๙ โดยท", n_chars: 853});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_1", doc: "16_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑ ประกาศนี้เรียกว่า “ประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูง ของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจกา", n_chars: 161});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_2", doc: "16_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒ ประกาศนี้ ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 79});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_3", doc: "16_keyword.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๓ ในประกาศนี้ “บริการโทรคมนาคม” หมายความว่า บริการโทรคมนาคมที่ผู้รับใบอนุญาตให้แก่ผู้ใช้บริการ ตามกฎหมายว่าด้วยการประกอบกิจการโทรคมนาคม ", n_chars: 1216});
CREATE (:Definition {id: "term::การเปลี่ยนแปลงอัตราค่าบริการ", term: "การเปลี่ยนแปลงอัตราค่าบริการ"});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_4", doc: "16_keyword.pdf", unit: "ข้อ", number: 4, muad: "หมวด 1", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๔ อัตราค่าบริการซึ่งเรียกเก็บจริงจากผู้ใช้บริการโดยชอบด้วยกฎหมายในวันที่ประกาศนี้ ใช้บังคับ ให้ถือเป็นอัตราขั้นสูงที่คณะกรรมการประกาศกำห", n_chars: 537});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_5", doc: "16_keyword.pdf", unit: "ข้อ", number: 5, muad: "หมวด 1", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๕ ห้ามมิให้ผู้รับใบอนุญาตเรียกเก็บค่าบริการนอกเหนือหรือเกินกว่าอัตราขั้นสูงตามข้อ ๔ และต้องไม่เป็นอัตราในลักษณะที่เป็นการกีดกันทางการค้า", n_chars: 273});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_6", doc: "16_keyword.pdf", unit: "ข้อ", number: 6, muad: "หมวด 1", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๖ ผู้รับใบอนุญาตมีหน้าที่ต้องจัดให้มีการเผยแพร่อัตราค่าบริการของตนเป็นการทั่วไป และต้องแจ้งให้ผู้ใช้บริการทุกรายทราบตามวิธีการที่คณะกรรม", n_chars: 682});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_7", doc: "16_keyword.pdf", unit: "ข้อ", number: 7, muad: "หมวด 1", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๗ ให้ผู้รับใบอนุญาตมีหน้าที่แจ้งข้อมูลของผู้รับใบอนุญาตและจัดส่งเอกสารหลักฐาน ที่เกี่ยวข้องแก่สำนักงาน เพื่อใช้ในการคำนวณและกำหนดอัตราขั", n_chars: 1281});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_8", doc: "16_keyword.pdf", unit: "ข้อ", number: 8, muad: "หมวด 1", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๘ ให้สำนักงานจัดทำรายงานอัตราค่าตอบแทนการลงทุน (rate of return) ของแต่ละประเภท บริการ พร้อมหลักการและวิธีการคิดคำนวณโดยละเอียด และจัดทำแ", n_chars: 601});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_9", doc: "16_keyword.pdf", unit: "ข้อ", number: 9, muad: "หมวด 1", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๙ เมื่อได้รับรายงานตามข้อ ๘ ครบถ้วนแล้ว คณะกรรมการอาจกำหนดอัตราขั้นสูง ของค่าบริการใหม่บนพื้นฐานของอัตราค่าตอบแทนการลงทุน และเป็นอัตราที", n_chars: 368});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_10", doc: "16_keyword.pdf", unit: "ข้อ", number: 10, muad: "หมวด 1", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๐ ผู้รับใบอนุญาตอาจยื่นคำขอเพื่อให้คณะกรรมการพิจารณาการกำหนดอัตราค่าบริการ แบบเพดานราคา (price cap) ของตนก็ได้ โดยยื่นเอกสารและหลักฐานเ", n_chars: 1548});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_11", doc: "16_keyword.pdf", unit: "ข้อ", number: 11, muad: "หมวด 2", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๑ การเปลี่ยนแปลงอัตราค่าบริการของผู้รับใบอนุญาต ให้เป็นไปตามหลักเกณฑ์และ วิธีการที่กำหนดไว้ในหมวดนี้ ยกเว้นผู้รับใบอนุญาตที่คณะกรรมการใ", n_chars: 190});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_12", doc: "16_keyword.pdf", unit: "ข้อ", number: 12, muad: "หมวด 2", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๒ หากผู้รับใบอนุญาตรายใดประสงค์ที่จะเปลี่ยนแปลงอัตราค่าบริการ แต่ไม่นอกเหนือ หรือเกินกว่าอัตราขั้นสูงที่กำหนดตามประกาศนี้ ให้ผู้รับใบอน", n_chars: 1325});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_13", doc: "16_keyword.pdf", unit: "ข้อ", number: 13, muad: "หมวด 2", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๓ หากคณะกรรมการพิจารณาว่า การเปลี่ยนแปลงอัตราค่าบริการตามข้อ ๑๒ นอกเหนือ หรือเกินกว่าอัตราขั้นสูงที่กำหนดตามประกาศนี้ คณะกรรมการอาจสั่ง", n_chars: 377});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_14", doc: "16_keyword.pdf", unit: "ข้อ", number: 14, muad: "หมวด 2", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๔ กรณีที่ผู้รับใบอนุญาตประสงค์จะเปลี่ยนแปลงอัตราค่าบริการนอกเหนือหรือเกินกว่า อัตราขั้นสูงตามที่กำหนดไว้โดยคณะกรรมการ หรือจะจัดเก็บค่าบ", n_chars: 1501});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_15", doc: "16_keyword.pdf", unit: "ข้อ", number: 15, muad: "หมวด 2", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๕ หากคณะกรรมการเห็นชอบกับการเปลี่ยนแปลงอัตราค่าบริการที่นอกเหนือหรือ เกินกว่าอัตราขั้นสูงที่กำหนดไว้ตามข้อ ๑๔ ให้ถือว่าอัตราค่าบริการที", n_chars: 395});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_16", doc: "16_keyword.pdf", unit: "ข้อ", number: 16, muad: "หมวด 3", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๖ ให้ผู้รับใบอนุญาตแจ้งโครงสร้างและอัตราค่าบริการที่จัดเก็บจากผู้ใช้บริการแก่สำนักงาน ทุกวันสิ้นเดือนของแต่ละเดือน หากวันสิ้นเดือนเป็นว", n_chars: 253});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_17", doc: "16_keyword.pdf", unit: "ข้อ", number: 17, muad: "หมวด 3", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๗ อัตราค่าบริการจะต้องเรียกเก็บจากผู้ใช้บริการของตนในอัตราเดียวกันสำหรับ บริการโทรคมนาคมที่มีลักษณะหรือประเภทเดียวกัน และไม่มีลักษณะเป็", n_chars: 200});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_18", doc: "16_keyword.pdf", unit: "ข้อ", number: 18, muad: "หมวด 3", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๘ ในกรณีที่คณะกรรมการสงสัยหรือมีเหตุอันควรเชื่อได้ว่าอัตราค่าบริการใดมีลักษณะ ที่เป็นการกีดกันทางการค้าอันจะมีผลเป็นจำกัดการแข่งขัน หรื", n_chars: 460});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_19", doc: "16_keyword.pdf", unit: "ข้อ", number: 19, muad: "หมวด 3", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑๙ ในการไต่สวนนั้น สำนักงานหรือคณะกรรมการเฉพาะกิจที่ได้รับมอบหมายมีอำนาจ ตรวจสอบข้อเท็จจริงได้ตามความเหมาะสม ภายใต้บทบัญญัติหมวด ๘ แห่งพ", n_chars: 936});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_20", doc: "16_keyword.pdf", unit: "ข้อ", number: 20, muad: "หมวด 3", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๐ เมื่อดำเนินการไต่สวนตามข้อ ๑๘ แล้ว พบว่าอัตราค่าบริการนั้นมีลักษณะที่เป็น การกีดกันทางการค้าอันจะมีผลเป็นจำกัดการแข่งขัน หรือขัดต่อหล", n_chars: 551});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_21", doc: "16_keyword.pdf", unit: "ข้อ", number: 21, muad: "หมวด 3", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๑ ให้สำนักงานเก็บรักษาความลับข้อมูลที่ได้รับจากผู้รับใบอนุญาตที่เป็นความลับทาง การค้าของผู้รับใบอนุญาตอย่างเคร่งครัดและห้ามมิให้เปิดเผย", n_chars: 239});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_22", doc: "16_keyword.pdf", unit: "ข้อ", number: 22, muad: "หมวด 3", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๒ ในกรณีที่คณะกรรมการเห็นว่า บริการใดเป็นบริการข้อมูลข่าวสารและความรู้ เพื่อประโยชน์ในการส่งเสริมความรู้ของประชาชน หรือเป็นบริการโทรคมน", n_chars: 273});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_23", doc: "16_keyword.pdf", unit: "ข้อ", number: 23, muad: "หมวด 3", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๓ เพื่อคุ้มครองผู้ใช้บริการหรือเพื่อคุ้มครองประโยชน์สาธารณะ คณะกรรมการ อาจประกาศหรือกำหนดให้ผู้รับใบอนุญาตที่ให้บริการในกิจการโทรคมนาคม", n_chars: 308});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_24", doc: "16_keyword.pdf", unit: "ข้อ", number: 24, muad: "หมวด 4", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๔ ให้สำนักงานดำเนินการทบทวนอัตราขั้นสูงของค่าบริการ ตามหลักเกณฑ์และวิธีการ ที่คณะกรรมการประกาศกำหนดทุกสามปี พร้อมจัดทำรายงานเสนอต่อคณะก", n_chars: 634});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_25", doc: "16_keyword.pdf", unit: "ข้อ", number: 25, muad: "หมวด 4", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๕ ในกรณีที่สภาพทางเศรษฐกิจหรือสังคมเปลี่ยนแปลงไป หรือมีเหตุอย่างหนึ่งอย่างใด ทำให้อัตราขั้นสูงของค่าบริการที่คณะกรรมการกำหนดตามประกาศนี", n_chars: 503});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_26", doc: "16_keyword.pdf", unit: "ข้อ", number: 26, muad: "หมวด 5", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๖ ห้ามมิให้ผู้รับใบอนุญาตกำหนดให้ผู้ใช้บริการต้องวางเงินประกันหรือต้องชำระเงิน อื่นที่มีลักษณะเช่นเดียวกับเงินประกันเพื่อใช้บริการโทรคม", n_chars: 161});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_27", doc: "16_keyword.pdf", unit: "ข้อ", number: 27, muad: "หมวด 5", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๗ ในกรณีที่ผู้ใช้บริการผิดนัดชำระค่าบริการ ผู้รับใบอนุญาตจะกำหนดให้ผู้ใช้บริการ ต้องชำระดอกเบี้ย เบี้ยปรับ หรือเงินอื่นใดในลักษณะดังกล่", n_chars: 253});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_28", doc: "16_keyword.pdf", unit: "ข้อ", number: 28, muad: "หมวด 5", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๘ การเรียกเก็บค่าบริการล่วงหน้าต้องได้รับความเห็นชอบจากคณะกรรมการก่อน โดยผู้รับใบอนุญาตต้องยื่นคำขอ พร้อมเอกสารหรือหลักฐานประกอบการพิจา", n_chars: 554});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_29", doc: "16_keyword.pdf", unit: "ข้อ", number: 29, muad: "หมวด 5", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๒๙ การเปลี่ยนแปลงแก้ไขหลักเกณฑ์และวิธีการเรียกเก็บค่าบริการล่วงหน้าต้องได้รับ ความเห็นชอบจากคณะกรรมการก่อน โดยผู้รับใบอนุญาตต้องยื่นคำขอ", n_chars: 842});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_30", doc: "16_keyword.pdf", unit: "ข้อ", number: 30, muad: "หมวด 5", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๓๐ เมื่อคณะกรรมการให้ความเห็นชอบตามข้อ ๒๘ หรือข้อ ๒๙ แล้ว ผู้รับใบอนุญาต จะต้องประกาศหลักเกณฑ์และวิธีการเรียกเก็บค่าบริการล่วงหน้าเผยแพร", n_chars: 364});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_31", doc: "16_keyword.pdf", unit: "ข้อ", number: 31, muad: "หมวด 5", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๓๑ ประกาศนี้ให้ใช้บังคับแก่การประกอบกิจการโทรคมนาคมของผู้ได้รับใบอนุญาต สัมปทาน หรือสัญญาก่อนวันที่พระราชบัญญัติการประกอบกิจการโทรคมนาคม", n_chars: 319});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_32", doc: "16_keyword.pdf", unit: "ข้อ", number: 32, muad: "หมวด 5", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๓๒ ให้ผู้รับใบอนุญาตที่ได้รับอนุญาตอยู่ก่อนวันที่ประกาศนี้ใช้บังคับ ต้องยื่นโครงสร้าง และอัตราค่าบริการ พร้อมหลักการและวิธีการคำนวณค่าบร", n_chars: 511});
CREATE (:Chunk {id: "chunk::16_keyword::ข้อ_33", doc: "16_keyword.pdf", unit: "ข้อ", number: 33, muad: "หมวด 5", title: "เรื่อง อัตราขั้นสูงของค่าบริการและการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๓๓ ให้ผู้รับใบอนุญาตที่ได้รับอนุญาตอยู่ก่อนวันที่ประกาศนี้ใช้บังคับ ต้องยื่นหลักเกณฑ์ และวิธีการเรียกเก็บค่าบริการล่วงหน้า และโครงสร้างแ", n_chars: 645});
CREATE (:Chunk {id: "chunk::17_keyword::preamble", doc: "17_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื", n_chars: 1763});
CREATE (:Chunk {id: "chunk::17_keyword::ข้อ_1", doc: "17_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "ข้อ ๑ ประกาศนี้เรียกว่า “ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาค", n_chars: 205});
CREATE (:Chunk {id: "chunk::17_keyword::ข้อ_2", doc: "17_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "ข้อ ๒ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 78});
CREATE (:Chunk {id: "chunk::17_keyword::ข้อ_3", doc: "17_keyword.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "ข้อ ๓ บรรดาประกาศ ระเบียบ ข้อบังคับ หรือคำสั่งอื่นใด ในส่วนที่มีกำหนดไว้แล้ว ในประกาศนี้ หรือซึ่งขัดหรือแย้งกับประกาศนี้ ให้ใช้ประกาศนี้แทน", n_chars: 139});
CREATE (:Chunk {id: "chunk::17_keyword::ข้อ_4", doc: "17_keyword.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "ข้อ ๔ ในประกาศนี้ “คณะกรรมการ” หมายความว่า คณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ “ผู้รับใบอนุญาต” หมายความว่", n_chars: 1542});
CREATE (:Definition {id: "term::อัตราขั้นสูงของค่าบริการ", term: "อัตราขั้นสูงของค่าบริการ"});
CREATE (:Chunk {id: "chunk::17_keyword::ข้อ_5", doc: "17_keyword.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "ข้อ ๕ ให้ผู้รับใบอนุญาตมีสิทธิเรียกเก็บค่าบริการจากผู้ใช้บริการสำหรับบริการโทรศัพท์เคลื่อนที่ ประเภทเสียงภายในประเทศในแต่ละหน่วยนาทีได้ไม่เก", n_chars: 481});
CREATE (:Chunk {id: "chunk::17_keyword::ข้อ_6", doc: "17_keyword.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "ข้อ ๖ ห้ามมิให้ผู้รับใบอนุญาตเรียกเก็บค่าบริการเกินกว่าอัตราขั้นสูงของค่าบริการตามข้อ ๕ และต้องไม่เป็นอัตราในลักษณะที่เป็นการกีดกันทางการค้า", n_chars: 258});
CREATE (:Chunk {id: "chunk::17_keyword::ข้อ_7", doc: "17_keyword.pdf", unit: "ข้อ", number: 7, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "ข้อ ๗ หากผู้รับใบอนุญาตรายใดประสงค์ที่จะเปลี่ยนแปลงอัตราค่าบริการ แต่ไม่เกินกว่า อัตราขั้นสูงของค่าบริการที่กำหนดตามประกาศนี้ ผู้รับใบอนุญาต", n_chars: 177});
CREATE (:Chunk {id: "chunk::17_keyword::ข้อ_12", doc: "17_keyword.pdf", unit: "ข้อ", number: 12, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "ข้อ ๑๒ ของประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูงของค่าบริการ และการเรียกเก็บเงินค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ.", n_chars: 145});
CREATE (:Chunk {id: "chunk::17_keyword::ข้อ_8", doc: "17_keyword.pdf", unit: "ข้อ", number: 8, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "ข้อ ๘ หากผู้รับใบอนุญาตรายใดประสงค์ที่จะเปลี่ยนแปลงอัตราค่าบริการที่เกินกว่าอัตราขั้นสูง ของค่าบริการที่กำหนดตามประกาศนี้ ให้ผู้รับใบอนุญาตร", n_chars: 788});
CREATE (:Chunk {id: "chunk::17_keyword::ข้อ_9", doc: "17_keyword.pdf", unit: "ข้อ", number: 9, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "ข้อ ๙ ให้ผู้รับใบอนุญาตที่กำหนดอัตราค่าบริการเกินกว่าอัตราขั้นสูงของค่าบริการ ที่กำหนด ตามประกาศนี้อยู่แล้วก่อนวันที่ประกาศนี้ใช้บังคับ สามา", n_chars: 524});
CREATE (:Chunk {id: "chunk::17_keyword::ภาคผนวก_1", doc: "17_keyword.pdf", unit: "ภาคผนวก", number: 1, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "ภาคผนวก หลักการและวิธีการคำนวณอัตราขั้นสูงของค่าบริการ ________________________________________ คณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ แ", n_chars: 924});
CREATE (:Chunk {id: "chunk::17_keyword::ภาคผนวก_2", doc: "17_keyword.pdf", unit: "ภาคผนวก", number: 2, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "(๑) การคำนวณจำนวนรายได้ที่ต้องได้รับ (Revenue Requirement) เพื่อให้ครอบคลุมค่าใช้จ่าย ในการให้บริการตามสูตรดังนี้ RR = B(r)+ E + D + T RR = ", n_chars: 2464});
CREATE (:Chunk {id: "chunk::17_keyword::ภาคผนวก_3", doc: "17_keyword.pdf", unit: "ภาคผนวก", number: 3, muad: "", title: "เรื่อง อัตราขั้นสูงของค่าบริการโทรคมนาคมสำหรับบริการโทรศัพท์เคลื่อนที่ประเภทเสียงภายในประเทศ พ.ศ. 2555", preview: "(๓) การคำนวณต้นทุนทางการเงินเฉลี่ยถ่วงนํ้าหนัก (Weighted Average CostofCapital) ใช้สูตร การคำนวณดังนี้ Weighted Average Cost of Capital = Wd", n_chars: 2374});
CREATE (:Chunk {id: "chunk::18_keyword::preamble", doc: "18_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง ยกเลิกอัตราค่าบริการขั้นสูงชั่วคราว ตามประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูงของค่าบริการและเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง ยกเลิกอัตราค่าบริการขั้นสูงชั่วคราว ตามประกาศคณะกรรมการกิ", n_chars: 1475});
CREATE (:Chunk {id: "chunk::18_keyword::ข้อ_1", doc: "18_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง ยกเลิกอัตราค่าบริการขั้นสูงชั่วคราว ตามประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง อัตราขั้นสูงของค่าบริการและเรียกเก็บค่าบริการล่วงหน้าในกิจการโทรคมนาคม พ.ศ. 2549", preview: "ข้อ ๑ ประกาศนี้เรียกว่า “ประกาศคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคมแห่งชาติ เรื่อง ยกเลิกอัตราค่าบริการขั้นสูงชั่วค", n_chars: 284});

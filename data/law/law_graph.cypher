CREATE (:Chunk {id: "chunk::34_protect::preamble_p3", doc: "34_protect.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง แผนการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการเพื่อสังคม (ฉบับที่ 4) พ.ศ. 2566 (ที่แก้ไขเพิ่มเติม ครั้งที่ 1)", preview: "QหO/?&1>\u000f@1P#1ค/%@ค/ พAQ%\u0012@%P 0#?P/\"@\u000fO3>&1>\u000f@1NพAPอ2?\u000fค/ \u0011&?&#?P b (พ.0. `cdd) (#?PO\u000fOR\u0010Nพ>P/N!>/ ค1?Q\u000f#?P _)” \u0010Oอ g QหO0\u000fN3>\u000f.@ค(%/\u000f \u0010 \u0010อ\u000f", n_chars: 1000});
CREATE (:Chunk {id: "chunk::35_keyword::preamble", doc: "35_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ในกรณีที่มีเหตุฉุกเฉิน หรือมีความจำเป็น เพื่อรักษาความสงบเรียบร้อยของประชาชน ความมั่นคงของประเทศ หรือเสถียรภาพทางเศรษฐกิจ หรือเพื่อป้องกันประโยชน์สาธารณะ", preview: "ประกาศคณะกรรมการกิจการโทรคมนาคมแห่งชาติ เรื่อง หลักเกณฑ์และวิธีการงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ ในกรณีที่มีเหตุฉุกเฉิน หรือมีควา", n_chars: 1463});
CREATE (:Chunk {id: "chunk::35_keyword::ข้อ_1", doc: "35_keyword.pdf", unit: "ข้อ", number: 1, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ในกรณีที่มีเหตุฉุกเฉิน หรือมีความจำเป็น เพื่อรักษาความสงบเรียบร้อยของประชาชน ความมั่นคงของประเทศ หรือเสถียรภาพทางเศรษฐกิจ หรือเพื่อป้องกันประโยชน์สาธารณะ", preview: "ข้อ ๑ ประกาศนี้ให้ใช้บังคับตั้งแต่วันถัดจากวันประกาศในราชกิจจานุเบกษาเป็นต้นไป", n_chars: 78});
CREATE (:Chunk {id: "chunk::35_keyword::ข้อ_2", doc: "35_keyword.pdf", unit: "ข้อ", number: 2, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ในกรณีที่มีเหตุฉุกเฉิน หรือมีความจำเป็น เพื่อรักษาความสงบเรียบร้อยของประชาชน ความมั่นคงของประเทศ หรือเสถียรภาพทางเศรษฐกิจ หรือเพื่อป้องกันประโยชน์สาธารณะ", preview: "ข้อ ๒ ในประกาศนี้ “เหตุฉุกเฉิน” หมายความว่า สถานการณ์ที่นายกรัฐมนตรีอาจประกาศสถานการณ์ฉุกเฉิน หรือสถานการณ์ฉุกเฉินที่มีความร้ายแรงตามกฎหมายว", n_chars: 779});
CREATE (:Definition {id: "term::ความจำเป็น", term: "ความจำเป็น"});
CREATE (:Chunk {id: "chunk::35_keyword::ข้อ_3", doc: "35_keyword.pdf", unit: "ข้อ", number: 3, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ในกรณีที่มีเหตุฉุกเฉิน หรือมีความจำเป็น เพื่อรักษาความสงบเรียบร้อยของประชาชน ความมั่นคงของประเทศ หรือเสถียรภาพทางเศรษฐกิจ หรือเพื่อป้องกันประโยชน์สาธารณะ", preview: "ข้อ ๓ เมื่อมีเหตุฉุกเฉินหรือมีความจำเป็นเกิดขึ้นและจะต้องงดหรือระงับการให้บริการ โทรศัพท์เคลื่อนที่เพื่อระงับเหตุฉุกเฉินหรือความจำเป็นนั้น ใ", n_chars: 1349});
CREATE (:Chunk {id: "chunk::35_keyword::ข้อ_4", doc: "35_keyword.pdf", unit: "ข้อ", number: 4, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ในกรณีที่มีเหตุฉุกเฉิน หรือมีความจำเป็น เพื่อรักษาความสงบเรียบร้อยของประชาชน ความมั่นคงของประเทศ หรือเสถียรภาพทางเศรษฐกิจ หรือเพื่อป้องกันประโยชน์สาธารณะ", preview: "ข้อ ๔ ในกรณีมีเหตุฉุกเฉินหรือมีความจำเป็น คณะกรรมการหรือกรรมการมีอำนาจ สั่งให้ผู้รับใบอนุญาตงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ในบริเว", n_chars: 270});
CREATE (:Chunk {id: "chunk::35_keyword::ข้อ_5", doc: "35_keyword.pdf", unit: "ข้อ", number: 5, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ในกรณีที่มีเหตุฉุกเฉิน หรือมีความจำเป็น เพื่อรักษาความสงบเรียบร้อยของประชาชน ความมั่นคงของประเทศ หรือเสถียรภาพทางเศรษฐกิจ หรือเพื่อป้องกันประโยชน์สาธารณะ", preview: "ข้อ ๕ การแจ้งคำสั่งให้งดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ตามข้อ ๔ ให้เลขาธิการแจ้งคำสั่งให้ผู้รับใบอนุญาตทราบเป็นหนังสือล่วงหน้าไม่น้อ", n_chars: 1443});
CREATE (:Chunk {id: "chunk::35_keyword::ข้อ_6", doc: "35_keyword.pdf", unit: "ข้อ", number: 6, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ในกรณีที่มีเหตุฉุกเฉิน หรือมีความจำเป็น เพื่อรักษาความสงบเรียบร้อยของประชาชน ความมั่นคงของประเทศ หรือเสถียรภาพทางเศรษฐกิจ หรือเพื่อป้องกันประโยชน์สาธารณะ", preview: "ข้อ ๖ เมื่อได้รับคำสั่งตามข้อ ๔ แล้ว ผู้รับใบอนุญาตต้องดำเนินการให้เป็นไปตามที่ ได้รับคำสั่งนั้นทันทีตามวิธีการดำเนินการและเทคโนโลยีของผู้รั", n_chars: 178});
CREATE (:Chunk {id: "chunk::35_keyword::ข้อ_7", doc: "35_keyword.pdf", unit: "ข้อ", number: 7, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ในกรณีที่มีเหตุฉุกเฉิน หรือมีความจำเป็น เพื่อรักษาความสงบเรียบร้อยของประชาชน ความมั่นคงของประเทศ หรือเสถียรภาพทางเศรษฐกิจ หรือเพื่อป้องกันประโยชน์สาธารณะ", preview: "ข้อ ๗ เมื่อเลขาธิการได้แจ้งคำสั่งให้ผู้รับใบอนุญาตงดหรือระงับการให้บริการ โทรศัพท์เคลื่อนที่แล้ว ให้รายงานผลการดำเนินการให้คณะกรรมการทราบโดย", n_chars: 144});
CREATE (:Chunk {id: "chunk::35_keyword::ข้อ_8", doc: "35_keyword.pdf", unit: "ข้อ", number: 8, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ในกรณีที่มีเหตุฉุกเฉิน หรือมีความจำเป็น เพื่อรักษาความสงบเรียบร้อยของประชาชน ความมั่นคงของประเทศ หรือเสถียรภาพทางเศรษฐกิจ หรือเพื่อป้องกันประโยชน์สาธารณะ", preview: "ข้อ ๘ เมื่อผู้รับใบอนุญาตได้รับคำสั่งแล้ว ให้รายงานการดำเนินการทางโทรศัพท์ โทรสาร สื่ออิเล็กทรอนิกส์ หรือสื่อเทคโนโลยีสารสนเทศประเภทอื่นให้เ", n_chars: 338});
CREATE (:Chunk {id: "chunk::35_keyword::ข้อ_9", doc: "35_keyword.pdf", unit: "ข้อ", number: 9, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ในกรณีที่มีเหตุฉุกเฉิน หรือมีความจำเป็น เพื่อรักษาความสงบเรียบร้อยของประชาชน ความมั่นคงของประเทศ หรือเสถียรภาพทางเศรษฐกิจ หรือเพื่อป้องกันประโยชน์สาธารณะ", preview: "ข้อ ๙ ให้ผู้รับใบอนุญาตแจ้งรายชื่อผู้ประสานงานเพื่อดำเนินการตามประกาศนี้ ต่อเลขาธิการภายในเวลาสามสิบวัน นับแต่วันที่ได้รับใบอนุญาต ในกรณีที่", n_chars: 246});
CREATE (:Chunk {id: "chunk::35_keyword::ข้อ_10", doc: "35_keyword.pdf", unit: "ข้อ", number: 10, muad: "", title: "เรื่อง หลักเกณฑ์และวิธีการงดหรือระงับการให้บริการโทรศัพท์เคลื่อนที่ในกรณีที่มีเหตุฉุกเฉิน หรือมีความจำเป็น เพื่อรักษาความสงบเรียบร้อยของประชาชน ความมั่นคงของประเทศ หรือเสถียรภาพทางเศรษฐกิจ หรือเพื่อป้องกันประโยชน์สาธารณะ", preview: "ข้อ ๑๐ ผู้รับใบอนุญาตที่ได้รับอนุญาตอยู่แล้วก่อนวันที่ประกาศนี้ใช้บังคับ ให้แจ้งรายชื่อ ผู้ประสานงานต่อเลขาธิการภายในเวลาสามสิบวัน นับแต่วัน", n_chars: 268});
CREATE (:Chunk {id: "chunk::36_keyword::preamble_p1", doc: "36_keyword.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "เรื่อง กำหนดระยะเวลาการพิจารณาคำขอหรือคำร้องเรียนในกิจการโทรคมนาคม", preview: "ป1>ก@ศคณ>ก11/ก@1ก>\u0010ก@1ก1>\u0010@0Nส?0\u000f ก>\u0010ก@1Pท1ท?ศน์ Oล>ก>\u0010ก@1Pท1ค/น@ค/Oห่\u000fช@ต> N1APอ\u000f \u000fํ@ห% 1>0>N/3@\u000f@1พ>\u0010@1\u001f@คํ@\u0010อห1Aอคํ@1Oอ\u000fN1?0%Q%\u000f>\u0010\u000f@1P#1ค", n_chars: 2455});

CREATE (:Chunk {id: "chunk::01_act::มาตรา_16_d2", doc: "01_act.pdf", unit: "มาตรา", number: 16, muad: "หมวด 8", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๑๖ เมื่อได้รายชื่อผู้สมควรได้รับเลือกเป็นกรรมการจากการสรรหาตามส่วนที่ ๓ แล้ว ให้เลขาธิการวุฒิสภาจัดทำรายชื่อผู้ซึ่งได้รับการคัดเลือกนั", n_chars: 847});

CREATE (:Chunk {id: "chunk::01_act::มาตรา_59_d2", doc: "01_act.pdf", unit: "มาตรา", number: 59, muad: "หมวด 5", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๕๙ ให้สำนักงาน กสทช. เปิดเผยข้อมูลเกี่ยวกับการดำเนินงานของ กสทช. และสำนักงาน กสทช. ให้ประชาชนทราบทางระบบเครือข่ายสารสนเทศ หรือวิธีการอ", n_chars: 783});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_60_d1", doc: "01_act.pdf", unit: "มาตรา", number: 60, muad: "หมวด 5", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๖๐ ให้สำนักงาน กสทช. มีเลขาธิการ กสทช. คนหนึ่งรับผิดชอบการปฏิบัติงาน ของสำนักงาน กสทช. ขึ้นตรงต่อประธานกรรมการ และเป็นผู้บังคับบัญชาพน", n_chars: 493});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_61_d1", doc: "01_act.pdf", unit: "มาตรา", number: 61, muad: "หมวด 5", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๖๑ ให้ประธานกรรมการ โดยความเห็นชอบของ กสทช. เป็นผู้แต่งตั้งและถอดถอน เลขาธิการ กสทช. 99 เลขาธิการ กสทช. ต้องมีอายุไม่ต่ำกว่าสามสิบห้าป", n_chars: 252});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_62_d1", doc: "01_act.pdf", unit: "มาตรา", number: 62, muad: "หมวด 5", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๖๒ เลขาธิการ กสทช. มีวาระการดำรงตำแหน่งคราวละห้าปีนับแต่วันที่ได้รับแต่งตั้ง และอาจได้รับแต่งตั้งอีกได้ แต่จะดำรงตำแหน่งติดต่อกันเกินส", n_chars: 152});

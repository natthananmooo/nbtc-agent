CREATE (:Chunk {id: "chunk::01_act::มาตรา_49_d1", doc: "01_act.pdf", unit: "มาตรา", number: 49, muad: "หมวด 3", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๔๙ ในการกำกับดูแลการประกอบกิจการ ให้ กสทช. จัดให้มีแผนแม่บทกิจการ กระจายเสียงและกิจการโทรทัศน์ และแผนแม่บทกิจการโทรคมนาคม เพื่อใช้เป็น", n_chars: 1433});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_50_d2", doc: "01_act.pdf", unit: "มาตรา", number: 50, muad: "หมวด 3", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๕๐ เพื่อประโยชน์ในการจัดให้มีบริการโทรคมนาคมพื้นฐานโดยทั่วถึงและบริการ เพื่อสังคมตามกฎหมายว่าด้วยการประกอบกิจการโทรคมนาคม ให้ กสทช. กำ", n_chars: 855});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_51_d1", doc: "01_act.pdf", unit: "มาตรา", number: 51, muad: "หมวด 3", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๕๑ เพื่อส่งเสริมให้ภาคประชาชนได้ใช้คลื่นความถี่ตามสัดส่วนที่กำหนดไว้ใน", n_chars: 76});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_49_d2", doc: "01_act.pdf", unit: "มาตรา", number: 49, muad: "หมวด 3", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๔๙ วรรคหนึ่ง ให้ กสทช. กำหนดหลักเกณฑ์และวิธีการในการส่งเสริมชุมชนที่มีความพร้อม ให้เป็นผู้มีคุณสมบัติในการขอรับใบอนุญาตประกอบกิจการกระ", n_chars: 849});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_52_d3", doc: "01_act.pdf", unit: "มาตรา", number: 52, muad: "หมวด 4", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๕๒ ให้จัดตั้งกองทุนขึ้นในสำนักงาน กสทช. เรียกว่า “กองทุนวิจัยและพัฒนา กิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคม เพื่อประโยชน", n_chars: 1176});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_53_d5", doc: "01_act.pdf", unit: "มาตรา", number: 53, muad: "หมวด 4", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๕๓ กองทุนตามมาตรา ๕๒ ประกอบด้วย (๑) ทุนประเดิมที่รัฐบาลจัดสรรให้ (๒) เงินที่ได้จากการประมูลคลื่นความถี่ตามมาตรา ๔๑ วรรคหก (๓) เงินที่ไ", n_chars: 994});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_54_d1", doc: "01_act.pdf", unit: "มาตรา", number: 54, muad: "หมวด 4", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๕๔ ให้มีคณะกรรมการบริหารกองทุนคณะหนึ่ง ประกอบด้วย (๑) ประธาน กสทช. เป็นประธานกรรมการ (๒) ปลัดสำนักนายกรัฐมนตรี เลขาธิการคณะกรรมการพัฒน", n_chars: 1414});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_55_d1", doc: "01_act.pdf", unit: "มาตรา", number: 55, muad: "หมวด 4", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๕๕ คณะกรรมการบริหารกองทุนมีอำนาจหน้าที่ในการบริหารกองทุนและเสนอ ความเห็นเกี่ยวกับการจัดสรรเงินกองทุนเพื่อใช้จ่ายตามวัตถุประสงค์ตามมาตร", n_chars: 658});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_56_d1", doc: "01_act.pdf", unit: "มาตรา", number: 56, muad: "หมวด 5", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๕๖ ให้มีสำนักงานคณะกรรมการกิจการกระจายเสียง กิจการโทรทัศน์และกิจการ โทรคมนาคมแห่งชาติ เรียกโดยย่อว่า “สำนักงาน กสทช.” เป็นนิติบุคคล มี", n_chars: 496});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_57_d6", doc: "01_act.pdf", unit: "มาตรา", number: 57, muad: "หมวด 5", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๕๗ ให้สำนักงาน กสทช. มีอำนาจหน้าที่ดังต่อไปนี้ (๑) รับผิดชอบในการรับและจ่ายเงินรายได้ของสำนักงาน กสทช. (๒) จัดทำงบประมาณรายจ่ายประจำปี", n_chars: 831});

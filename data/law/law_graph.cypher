CREATE (:Chunk {id: "chunk::09_act::preamble", doc: "09_act.pdf", unit: "อารัมภบท", number: 0, muad: "", title: "พระราชบัญญัติการอำนวยความสะดวกในการพิจารณาอนุญาตของทางราชการ พ.ศ. 2558", preview: "พระราชบัญญัติ การอำนวยความสะดวกในการพิจารณาอนุญาตของทางราชการ พ.ศ. ๒๕๕๘ ภูมิพลอดุลยเดช ป.ร. ให้ไว้ ณ วันที่ ๑๖ มกราคม พ.ศ. ๒๕๕๘ เป็นปีที่ ๗๐", n_chars: 431});
CREATE (:Chunk {id: "chunk::09_act::มาตรา_1", doc: "09_act.pdf", unit: "มาตรา", number: 1, muad: "", title: "พระราชบัญญัติการอำนวยความสะดวกในการพิจารณาอนุญาตของทางราชการ พ.ศ. 2558", preview: "มาตรา ๑ พระราชบัญญัตินี้เรียกว่า “พระราชบัญญัติการอำนวยความสะดวกในการพิจารณา อนุญาตของทางราชการ พ.ศ. ๒๕๕๘”", n_chars: 106});

CREATE (:Chunk {id: "chunk::01_act::มาตรา_68_d1", doc: "01_act.pdf", unit: "มาตรา", number: 68, muad: "หมวด 5", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๖๘ การบัญชีของสำนักงาน กสทช. ให้จัดทำตามหลักสากลตามมาตรฐานของ สภาผู้สอบบัญชี และต้องจัดให้มีการตรวจสอบภายในเกี่ยวกับการเงิน การบัญชี แ", n_chars: 971});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_69_d2", doc: "01_act.pdf", unit: "มาตรา", number: 69, muad: "หมวด 5", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๖๙ ให้สำนักงาน กสทช. จัดทำงบดุล งบการเงิน และบัญชีทำการส่งผู้สอบบัญชี ภายในหกสิบวันนับแต่วันสิ้นปีบัญชี ในทุกรอบปี ให้สำนักงานการตรวจเ", n_chars: 508});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_70_d1", doc: "01_act.pdf", unit: "มาตรา", number: 70, muad: "หมวด 6", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๗๐ ให้มีคณะกรรมการติดตามและประเมินผลการปฏิบัติงานคณะหนึ่ง ประกอบด้วย ประธานกรรมการคนหนึ่งและกรรมการอื่นอีกจำนวนสี่คน ซึ่งมีคุณสมบัติ ด", n_chars: 856});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_71_d1", doc: "01_act.pdf", unit: "มาตรา", number: 71, muad: "หมวด 6", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๗๑ กรรมการติดตามและประเมินผลการปฏิบัติงานมีวาระการดำรงตำแหน่งคราวละ สามปี และจะแต่งตั้งให้ดำรงตำแหน่งสองวาระติดต่อกันมิได้ กรรมการตามว", n_chars: 832});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_72_d1", doc: "01_act.pdf", unit: "มาตรา", number: 72, muad: "หมวด 6", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๗๒ ให้คณะกรรมการติดตามและประเมินผลการปฏิบัติงาน มีอำนาจหน้าที่ติดตาม ตรวจสอบ และประเมินผลการดำเนินการและการบริหารงานของ กสทช. กสท. กทค", n_chars: 697});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_73_d1", doc: "01_act.pdf", unit: "มาตรา", number: 73, muad: "หมวด 6", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๗๓ รายงานตามมาตรา ๗๒ อย่างน้อยจะต้องมีเนื้อหาดังต่อไปนี้ (๑) ผลการปฏิบัติงานของ กสทช. กสท. กทค. สำนักงาน กสทช. และเลขาธิการ กสทช. (๒) ", n_chars: 609});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_74_d2", doc: "01_act.pdf", unit: "มาตรา", number: 74, muad: "หมวด 7", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๗๔ ในการดำเนินการตามอำนาจหน้าที่ กสทช. ต้องดำเนินการให้สอดคล้องกับ นโยบายที่คณะรัฐมนตรีแถลงไว้ต่อรัฐสภา 104", n_chars: 113});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_75_d1", doc: "01_act.pdf", unit: "มาตรา", number: 75, muad: "หมวด 7", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๗๕ ในกรณีที่จะต้องมีการเจรจาหรือทำความตกลงระหว่างรัฐบาลแห่งราชอาณาจักรไทย กับรัฐบาลต่างประเทศหรือองค์การระหว่างประเทศ ในเรื่องที่เกี่ย", n_chars: 326});
CREATE (:Chunk {id: "chunk::01_act::มาตรา_76_d1", doc: "01_act.pdf", unit: "มาตรา", number: 76, muad: "หมวด 7", title: "พระราชบัญญัติองค์กรจัดสรรคลื่นความถี่และกำกับการประกอบกิจการวิทยุกระจายเสียงวิทยุโทรทัศน์ และกิจการโทรคมนาคม พ.ศ. 2553 และที่แก้ไขเพิ่มเติม", preview: "มาตรา ๗๖ ให้ กสทช. จัดทำรายงานผลการปฏิบัติงานประจำปีในด้านการบริหารคลื่น ความถี่ กิจการกระจายเสียง กิจการโทรทัศน์ และกิจการโทรคมนาคม แล้วแต่", n_chars: 1441});
